@using SmartFarm.Core.Enums
@model SmartFarm.Web.ViewModels.Monitoring.MonitoringWorkspaceViewModel
@{
    ViewData["Title"] = "Crop monitoring";
    var cycle = Model.Cycle;
    var monitoring = Model.Monitoring;
}
<partial name="_FarmNavigation" model="Model.Cycle.FarmId" />
<section class="panel">
    <p><a asp-controller="Crops" asp-action="Index"
          asp-route-farmId="@cycle.FarmId">← Crop management</a></p>
    <h1>@cycle.CropTypeName — @cycle.PlotName</h1>
    <p>Status: <strong>@cycle.Status</strong></p>
    <p>Log watering, fertilization, pesticide use, weeding, or other activities.
       Inspections are saved as crop observations.</p>
    @if (TempData["Error"] is string error)
    { <p class="error" role="alert">@error</p> }
</section>
@if (monitoring.CanRecord)
{
    <section class="panel">
        <h2>Record activity</h2>
        <form asp-action="Activity" asp-route-farmId="@cycle.FarmId"
              asp-route-cycleId="@cycle.Id" method="post">
            <label asp-for="Activity.ActivityType">Type</label>
            <select asp-for="Activity.ActivityType" required>
                @foreach (var option in FarmCodeLabels.Activities)
                {
                    <option value="@option.Code">@option.Name</option>
                }
            </select>
            <span asp-validation-for="Activity.ActivityType" class="error"></span>
            <label asp-for="Activity.FarmTaskId">Related task (optional)</label>
            <select asp-for="Activity.FarmTaskId">
                <option value="">Match my oldest due task automatically</option>
                @foreach (var task in Model.Tasks.Where(t => t.CropCycleId == cycle.Id &&
                    t.Status == 0 && (t.TaskType == 2 || t.TaskType == 3)))
                {
                    var taskName = task.TaskType == 2 ? "Watering" : "Fertilizing";
                    <option value="@task.Id">@taskName — @task.DueDate.ToString("yyyy-MM-dd") — @task.Description</option>
                }
            </select>
            <p class="hint">Select a matching watering or fertilizing task to complete it with this activity.</p>
            <label asp-for="Activity.Notes">Notes (optional)</label>
            <textarea asp-for="Activity.Notes" maxlength="1000" rows="3"></textarea><span asp-validation-for="Activity.Notes" class="error"></span>
            <button type="submit">Save activity</button>
        </form>
        <p class="hint">Recorded at the server's current UTC time.</p>
    </section>
    <section class="panel">
        <h2>Record crop observation / inspection</h2>
        <form asp-action="Observation" asp-route-farmId="@cycle.FarmId"
              asp-route-cycleId="@cycle.Id" method="post">
            <label asp-for="Observation.HealthStatus">Crop health</label>
            <select asp-for="Observation.HealthStatus" required>
                @foreach (var option in FarmCodeLabels.HealthStatuses)
                {
                    <option value="@option.Code">@option.Name</option>
                }
            </select>
            <span asp-validation-for="Observation.HealthStatus" class="error"></span>
            <label asp-for="Observation.GrowthStage">Growth stage (optional)</label>
            <input asp-for="Observation.GrowthStage" maxlength="40" /><span asp-validation-for="Observation.GrowthStage" class="error"></span>
            <label asp-for="Observation.Notes">Observation notes (optional)</label>
            <textarea asp-for="Observation.Notes" rows="3" maxlength="1000"></textarea><span asp-validation-for="Observation.Notes" class="error"></span>
            <button type="submit">Save observation</button>
        </form>
    </section>
}
<section class="panel">
    <h2>Activity history</h2>
    @if (monitoring.Activities.Count == 0)
    { <p>No activities recorded.</p> }
    <ul class="farm-list">
        @foreach (var activity in monitoring.Activities)
        {
            var label = activity.ActivityTypeName;
            <li>
                <strong>@label</strong> · @activity.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm") UTC
                @if (activity.Notes is not null) { <p>@activity.Notes</p> }
                @if (activity.FarmTaskId is not null)
                {
                    <p class="hint">Linked farm task completed</p>
                }
            </li>
        }
    </ul>
</section>
@{
    var progressPhotos = monitoring.Observations
        .SelectMany(o => o.Photos.Select(photo => new
        {
            Photo = photo,
            o.ObservedAtUtc,
            Health = o.HealthStatusName,
            o.GrowthStage
        }))
        .OrderBy(p => p.ObservedAtUtc)
        .ThenBy(p => p.Photo.UploadedAtUtc)
        .ToList();
}
<section class="panel" aria-labelledby="photo-progress-heading">
    <h2 id="photo-progress-heading">Crop photo progress</h2>
    <p class="hint">Compare inspection photos from earliest to latest. Only authorized farm members can open these private images.</p>
    @if (progressPhotos.Count == 0)
    {
        <p>No inspection photos yet. Record an inspection and attach a photo to build a visual history.</p>
    }
    else
    {
        <div class="photo-progress-grid">
        @foreach (var entry in progressPhotos)
        {
            <figure>
                <a asp-controller="Monitoring" asp-action="Photo"
                   asp-route-farmId="@cycle.FarmId" asp-route-cycleId="@cycle.Id"
                   asp-route-photoId="@entry.Photo.Id" target="_blank" rel="noopener">
                    <img src="@Url.Action("Photo", "Monitoring", new {
                        farmId = cycle.FarmId, cycleId = cycle.Id, photoId = entry.Photo.Id })"
                         alt="Crop inspection photo taken on @entry.ObservedAtUtc.ToString("MMM d, yyyy")" loading="lazy" />
                </a>
                <figcaption>
                    <strong>@entry.ObservedAtUtc.ToString("MMM d, yyyy") UTC</strong>
                    <span>@entry.Health</span>
                    @if (!string.IsNullOrWhiteSpace(entry.GrowthStage)) { <span>@entry.GrowthStage</span> }
                </figcaption>
            </figure>
        }
        </div>
    }
</section>
<section class="panel">
    <h2>Observations and photos</h2>
    @if (monitoring.Observations.Count == 0)
    { <p>No observations recorded.</p> }
    @foreach (var observation in monitoring.Observations)
    {
        var health = observation.HealthStatusName;
        <div class="crop-cycle">
            <strong>@health</strong> · @observation.ObservedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC
            @if (observation.GrowthStage is not null) { <p>Stage: @observation.GrowthStage</p> }
            @if (observation.Notes is not null) { <p>@observation.Notes</p> }
            @foreach (var photo in observation.Photos)
            {
                <a asp-controller="Monitoring" asp-action="Photo"
                   asp-route-farmId="@cycle.FarmId"
                   asp-route-cycleId="@cycle.Id"
                   asp-route-photoId="@photo.Id" target="_blank" rel="noopener">
                    <img class="observation-photo"
                         src="@Url.Action("Photo", "Monitoring", new { farmId = cycle.FarmId, cycleId = cycle.Id, photoId = photo.Id })"
                         alt="Observation photo" loading="lazy" />
                </a>
            }
            @if (monitoring.CanRecord)
            {
                <form asp-action="Upload" asp-route-farmId="@cycle.FarmId"
                      asp-route-cycleId="@cycle.Id" asp-route-observationId="@observation.Id"
                      method="post" enctype="multipart/form-data">
                    <label for="photo-@observation.Id">Attach photo (JPEG, PNG or WebP, maximum 5 MB)</label>
                    <input id="photo-@observation.Id" type="file" name="photo" accept="image/jpeg,image/png,image/webp" required />
                    <button type="submit">Upload photo</button>
                </form>
            }
        </div>
    }
</section>

