# Local environment files and secrets; keep example files available to developers.
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example

# Local database files and backups.
*.[mM][dD][fF]
*.[nN][dD][fF]
*.[lL][dD][fF]
*.[bB][aA][kK]
*.[bB][kK][pP]
*.[tT][rR][nN]
*.bacpac
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# Local Docker configuration and bind-mounted database data.
.docker/
.docker-data/
docker-data/
mssql-data/
sqlserver-data/
sql-data/
/database/data/
/database/backups/
/database/logs/
/database/volumes/

# Generated .NET output.
[Bb]in/
[Oo]bj/

# IDE and operating system generated files.
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.iml
*.swp
*.swo
.DS_Store

# Android local settings and generated output.
.gradle/
.kotlin/
**/build/
local.properties
*.jks
*.keystore
.cxx/
.externalNativeBuild/

# Local observation images stay outside the public wwwroot tree.
**/App_Data/observation-photos/

# Development documentation is shareable; exclude unrelated artifacts.
/docs/*
!/docs/*.md
!/docs/.gitkeep
!/docs/superpowers/

# Historical local verification output can contain private runtime data.
/.local/karpathy-wiki/verification/
/.local/karpathy-wiki/**/__pycache__/


# AniGo Tailwind build dependencies.
node_modules/

# Task-local visual candidates and Impeccable decision artifacts.
/tests/browser/screenshots/
/tests/browser/parity-output/
/tests/browser/authenticated-fixtures/
/.impeccable/questions/
/.impeccable/mocks/
