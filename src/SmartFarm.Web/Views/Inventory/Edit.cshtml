@model SmartFarm.Web.ViewModels.Inventory.InventoryEditPage
@{
    ViewData["Title"] = "Edit inventory item";
}
<div class="reference-screen reference-screen-inventory">
<section class="panel card sf-edit-form-panel sf-ops-edit-panel">

    <h1>Edit inventory item</h1>
    <p class="sf-muted">Update the supply details without changing its transaction history.</p>
    <form class="sf-ops-form" asp-action="Edit" asp-route-farmId="@Model.Farm.Id" asp-route-itemId="@Model.ItemId" method="post">
        <input asp-for="Input.RowVersion" type="hidden" />
        <label asp-for="Input.Name">Item name</label><input asp-for="Input.Name" required />
        <label asp-for="Input.Category"></label>
        <select asp-for="Input.Category">
            <option value="1">Seeds</option><option value="2">Fertilizers</option>
            <option value="3">Pesticides</option><option value="4">Other</option>
        </select>
        <label asp-for="Input.Unit"></label><input asp-for="Input.Unit" required />
        <label asp-for="Input.Description"></label><textarea asp-for="Input.Description"></textarea>
        <label asp-for="Input.ReorderLevel">Low-stock threshold</label>
        <input asp-for="Input.ReorderLevel" type="number" step="0.001" min="0" />
        <button type="submit">Save details</button>
        <a asp-action="Details" asp-route-farmId="@Model.Farm.Id" asp-route-itemId="@Model.ItemId">Cancel</a>
    </form>
</section>


</div>
