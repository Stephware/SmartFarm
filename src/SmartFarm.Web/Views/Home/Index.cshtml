@{
    ViewData["Title"] = "AniGo farm management";
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<div class="ani-entry-site">
<section class="ani-entry-hero" aria-labelledby="ani-entry-title">
    <div class="ani-entry-hero-copy">
        <p class="ani-entry-eyebrow">PRACTICAL FARM MANAGEMENT</p>
        <h1 id="ani-entry-title">Every farm, crop, and harvest in one place.</h1>
        <p class="ani-entry-lede">Keep your farm organized from planting to harvest. Plan the season, coordinate daily work, and keep important records together.</p>
        <div class="ani-entry-hero-actions">
            @if (signedIn)
            {
                <a class="button" asp-controller="Farms" asp-action="Index">Open my farms</a>
                <a class="ani-entry-secondary-link" asp-controller="Notifications" asp-action="Index">Review reminders <span aria-hidden="true">→</span></a>
            }
            else
            {
                <a class="button" asp-controller="Account" asp-action="Register">Get started with AniGo</a>
                <a class="ani-entry-secondary-link" href="#how-it-works">See how it works <span aria-hidden="true">→</span></a>
            }
        </div>
        <p class="ani-entry-assurance">Tools for owners, managers, and field workers. One account can access more than one farm.</p>
    </div>
    <figure class="ani-entry-hero-photo">
        <img src="~/images/photography/fields-hero.webp"
             alt="Aerial photograph of green terraced agricultural fields"
             width="1440" height="960" fetchpriority="high" decoding="async" />
        <figcaption>Real agricultural photography · illustrative, not a farm record</figcaption>
    </figure>
</section>

<section class="ani-entry-overview" id="how-it-works" aria-labelledby="ani-entry-overview-title">
    <header class="ani-entry-section-heading">
        <p class="ani-entry-eyebrow">ONE CONNECTED WORKSPACE</p>
        <h2 id="ani-entry-overview-title">From the first planting plan to the final harvest.</h2>
        <p>Simple steps for the everyday work that keeps your farm running.</p>
    </header>
    <div class="ani-entry-feature-grid">
        <article class="ani-entry-feature">
            <div class="ani-entry-feature-icon" aria-hidden="true"><partial name="_Icon" model='@("grid")' /></div>
            <span class="ani-entry-feature-number">01 / PLAN</span>
            <h3>Know what's growing</h3>
            <p>Organize plots, crop cycles, and planting dates without losing track of each field.</p>
        </article>
        <article class="ani-entry-feature">
            <div class="ani-entry-feature-icon" aria-hidden="true"><partial name="_Icon" model='@("checkSquare")' /></div>
            <span class="ani-entry-feature-number">02 / WORK</span>
            <h3>Keep fieldwork moving</h3>
            <p>Assign tasks, record inspections, and save actual crop photos as work happens.</p>
        </article>
        <article class="ani-entry-feature">
            <div class="ani-entry-feature-icon" aria-hidden="true"><partial name="_Icon" model='@("basket")' /></div>
            <span class="ani-entry-feature-number">03 / REVIEW</span>
            <h3>Understand your results</h3>
            <p>Review harvest records, supply movements, and farm reports based on saved data.</p>
        </article>
    </div>
</section>

<section class="ani-entry-story" aria-labelledby="ani-entry-story-heading">
    <figure class="ani-entry-story-photo">
        <img src="~/images/photography/farmers-working.webp"
             alt="Farmers working in a green rice field"
             width="900" height="1120" loading="lazy" decoding="async" />
    </figure>
    <div class="ani-entry-story-content">
        <p class="ani-entry-eyebrow">MADE FOR WORK IN THE FIELD</p>
        <h2 id="ani-entry-story-heading">Less time looking for records. More time taking care of the farm.</h2>
        <p>Start with the tasks that need attention today. Open the right crop or plot before recording fieldwork. Keep weather advisories and harvest history close without overwhelming the daily view.</p>
        <ul class="ani-entry-story-list">
            <li><partial name="_Icon" model='@("check")' /> Clear next steps for every role</li>
            <li><partial name="_Icon" model='@("check")' /> Records organized by farm, plot, and crop</li>
            <li><partial name="_Icon" model='@("check")' /> Friendly to phones and smaller screens</li>
        </ul>
    </div>
</section>

<section class="ani-entry-start" aria-labelledby="start-options-heading">
    <div class="ani-entry-section-heading">
        <p class="ani-entry-eyebrow">START WHERE YOU ARE</p>
        <h2 id="start-options-heading">How would you like to use AniGo?</h2>
        <p>Start your own farm or join an existing team. You can do both with the same account.</p>
    </div>
    <div class="ani-entry-start-grid">
        <article class="ani-entry-path-card">
            <span class="ani-entry-path-step">FOR FARM OWNERS AND MANAGERS</span>
            <h3>I manage a farm</h3>
            <p>Create a farm, set up growing areas, plan crops, and bring your team together.</p>
            <a class="button" asp-controller="@(signedIn ? "Farms" : "Account")"
               asp-action="@(signedIn ? "Create" : "Register")"
               asp-route-returnUrl="@(signedIn ? null : Url.Action("Create", "Farms"))">@(signedIn ? "Create a farm" : "Create an account to manage")</a>
        </article>
        <article class="ani-entry-path-card">
            <span class="ani-entry-path-step">FOR FIELD WORKERS AND TEAM MEMBERS</span>
            <h3>I work on a farm</h3>
            <p>Have a farm code? Create an account, request to join, and wait for the owner to approve your access.</p>
            <a class="ani-entry-path-link" asp-controller="@(signedIn ? "Farms" : "Account")"
               asp-action="@(signedIn ? "Index" : "Register")"
               asp-route-returnUrl="@(signedIn ? null : Url.Action("Index", "Farms") + "#join-farm")"
               asp-fragment="@(signedIn ? "join-farm" : null)">@(signedIn ? "Enter a farm code" : "Create an account to join") <span aria-hidden="true">→</span></a>
        </article>
    </div>
</section>

<section class="ani-entry-finish" aria-labelledby="ani-entry-finish-heading">
    <div>
        <p class="ani-entry-eyebrow">READY FOR THE NEXT SEASON?</p>
        <h2 id="ani-entry-finish-heading">Keep your farm organized, one day at a time.</h2>
        <p>Start with a farm, grow your team, and keep your records useful from the first day.</p>
    </div>
    <a class="button" asp-controller="@(signedIn ? "Farms" : "Account")"
       asp-action="@(signedIn ? "Index" : "Register")">@(signedIn ? "Open my farms" : "Create an account")</a>
</section>

<p class="ani-entry-photo-credit">Editorial photos: <a href="https://unsplash.com/@@quangpraha" target="_blank" rel="noopener noreferrer">Quang Nguyen Vinh</a> and <a href="https://unsplash.com/@@liyichuan" target="_blank" rel="noopener noreferrer">YiChuan Li</a> via <a href="https://unsplash.com/license" target="_blank" rel="noopener noreferrer">Unsplash</a>. Images illustrate agriculture and do not represent AniGo customer farms.</p>
</div>
