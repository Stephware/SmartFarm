@using SmartFarm.Core.Enums
@model SmartFarm.Web.ViewModels.Inventory.InventoryPage
@{
    ViewData["Title"] = "Inventory";
    ViewData["FarmName"] = Model.Farm.Name;
    var canManage = Model.Farm.Role is "Owner" or "Manager";
    var visibleItems = Model.Workspace.Items
        .Where(i => Model.SelectedFilter switch
        {
            "low" => i.IsLowStock,
            "seeds" => i.Category == InventoryCategory.Seeds,
            "fertilizers" => i.Category == InventoryCategory.Fertilizers,
            "pesticides" => i.Category == InventoryCategory.Pesticides,
            "other" => i.Category == InventoryCategory.Other,
            _ => true
        })
        .Where(i => string.IsNullOrWhiteSpace(Model.Search) ||
            i.Name.Contains(Model.Search, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(i => i.IsLowStock).ThenBy(i => i.Name)
        .ToList();
    var inStock = Model.Workspace.Items.Count(i => !i.IsLowStock);
}
<div class="reference-screen reference-screen-inventory">
<partial name="_FarmNavigation" model="Model.Farm.Id" />
<section class="panel card sf-ops-hero" aria-labelledby="inventory-heading">
    <div class="sf-page-header page-hero">
        <div>
            <p><a asp-controller="Farms" asp-action="Details" asp-route-id="@Model.Farm.Id">← @Model.Farm.Name</a></p>

            <h1 id="inventory-heading">Inventory</h1>
            <p class="sf-muted">Track available supplies, check low stock, and open each item's movement history.</p>
        </div>
        @if (canManage) { <a class="button" href="#add-item">Add inventory item</a> }
    </div>
    <div class="sf-ops-summary ani-inventory-metrics" aria-label="Inventory summary">
        <div><strong>@Model.Workspace.Items.Count</strong><span>Active supplies</span></div>
        <div class="@(Model.Workspace.LowStockCount > 0 ? "sf-summary-warning" : "")">
            <strong>@Model.Workspace.LowStockCount</strong><span>Low stock</span>
        </div>
        <div><strong>@inStock</strong><span>Above low-stock threshold</span></div>
    </div>
    @if (Model.Workspace.LowStockCount > 0)
    {
        <a class="ani-inventory-alert" asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-filter="low">
            <strong>@Model.Workspace.LowStockCount low-stock supply @(Model.Workspace.LowStockCount == 1 ? "item" : "items")</strong>
            <span>Review items that need replenishment →</span>
        </a>
    }
    @if (TempData["Error"] is string error) { <p role="alert" class="error form-error">@error</p> }
</section>
<section class="panel card sf-inventory-panel" aria-labelledby="inventory-list-heading">
    <div class="sf-section-line card-head">
        <h2 id="inventory-list-heading">Available supplies</h2>
        <span>Farm-wide stock · @visibleItems.Count shown</span>
    </div>
    <form class="ani-inventory-filter" asp-action="Index" asp-route-farmId="@Model.Farm.Id" method="get">
        <input type="hidden" name="farmId" value="@Model.Farm.Id" />
        <div>
            <label for="inventory-search">Find a supply</label>
            <input id="inventory-search" name="search" value="@Model.Search" type="search"
                   maxlength="120" placeholder="Search by item name" />
        </div>
        <div>
            <label for="inventory-filter">Show supplies</label>
            <select id="inventory-filter" name="filter">
                <option value="all" selected="@(Model.SelectedFilter == "all")">All items</option>
                <option value="low" selected="@(Model.SelectedFilter == "low")">Low stock only</option>
                <option value="seeds" selected="@(Model.SelectedFilter == "seeds")">Seeds</option>
                <option value="fertilizers" selected="@(Model.SelectedFilter == "fertilizers")">Fertilizers</option>
                <option value="pesticides" selected="@(Model.SelectedFilter == "pesticides")">Pesticides</option>
                <option value="other" selected="@(Model.SelectedFilter == "other")">Other</option>
            </select>
        </div>
        <button type="submit">Apply</button>
        <a class="sf-button-outline" asp-action="Index" asp-route-farmId="@Model.Farm.Id">Clear</a>
    </form>
    @if (Model.Workspace.Items.Count == 0)
    {
        <div class="sf-empty-state">
            <strong>No inventory items yet.</strong>
            <p>Supplies you add to your farm will appear here.</p>
        </div>
    }
    else if (visibleItems.Count == 0)
    {
        <div class="sf-empty-state">
            <strong>No matching supplies.</strong>
            <p>Try a different search or remove the selected filter.</p>
            <a asp-action="Index" asp-route-farmId="@Model.Farm.Id">Show all supplies →</a>
        </div>
    }
    else
    {
        <div class="table-wrap table-scroll" tabindex="0" role="region" aria-label="Available farm supplies">
        <table class="data-table reference-inventory-table">
            <caption class="visually-hidden">Available supplies and current stock balances</caption>
            <thead><tr><th scope="col">Supply</th><th scope="col">Category</th><th scope="col">Available stock</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead>
            <tbody>
        @foreach (var item in visibleItems)
        {
            <tr class="sf-inventory-row @(item.IsLowStock ? "sf-stock-low" : "")">
                <td><a class="table-name" asp-action="Details" asp-route-farmId="@Model.Farm.Id" asp-route-itemId="@item.Id">@item.Name</a>
                    @if (item.ReorderLevel.HasValue)
                    { <small class="table-sub">Low-stock threshold: @item.ReorderLevel.Value.ToString("N3") @item.Unit</small> }
                </td>
                <td>@item.CategoryName</td>
                <td class="reference-quantity"><strong>@item.QuantityOnHand.ToString("N3")</strong> @item.Unit</td>
                <td><span class="sf-status-chip @(item.IsLowStock ? "sf-status-chip--warning" : "sf-status-chip--active")">@(item.IsLowStock ? "Low stock" : "In stock")</span></td>
                <td><a class="sf-button-outline btn small" asp-action="Details" asp-route-farmId="@Model.Farm.Id" asp-route-itemId="@item.Id">View item →</a></td>
            </tr>
        }
            </tbody>
        </table>
        </div>
    }
</section>
@if (canManage)
{
    <section class="panel card sf-inventory-create" id="add-item" data-form-dialog aria-labelledby="add-inventory-heading">

        <header class="reference-panel-heading"><h2 id="add-inventory-heading">Add inventory item</h2></header>
        <p class="sf-muted">Create a supply record with its opening balance and optional low-stock threshold.</p>
        <form asp-action="Create" asp-route-farmId="@Model.Farm.Id" method="post" class="sf-ops-form sf-inventory-form">
            <div>
                <label for="name">Item name</label>
                <input name="Name" id="name" minlength="2" maxlength="120" required />
            </div>
            <div>
                <label for="category">Category</label>
                <select name="Category" id="category">
                    <option value="1">Seeds</option>
                    <option value="2">Fertilizers</option>
                    <option value="3">Pesticides</option>
                    <option value="4">Other</option>
                </select>
            </div>
            <div>
                <label for="unit">Unit</label>
                <input name="Unit" id="unit" maxlength="20" required placeholder="kg, L, pcs" />
            </div>
            <div>
                <label for="initial">Opening quantity</label>
                <input id="initial" name="InitialQuantity" type="number" step="0.001" min="0" value="0" required />
            </div>
            <div>
                <label for="reorder">Low-stock threshold (optional)</label>
                <input id="reorder" name="ReorderLevel" type="number" step="0.001" min="0" />
            </div>
            <div class="sf-form-wide">
                <label for="description">Description (optional)</label>
                <textarea name="Description" id="description" maxlength="500"></textarea>
            </div>
            <div class="sf-form-wide">
                <button type="submit">Create item</button>
            </div>
        </form>
    </section>
}

</div>
