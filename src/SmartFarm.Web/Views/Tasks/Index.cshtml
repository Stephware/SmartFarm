@using SmartFarm.Core.Enums
@model SmartFarm.Web.ViewModels.Tasks.TaskPage
@{
    ViewData["Title"] = T["Farm tasks"];
    ViewData["FarmName"] = Model.Farm.Name;
    DateOnly? calendarMonth = Model.FarmToday is { } farmDate ? new DateOnly(farmDate.Year, farmDate.Month, 1) : null;
    if (calendarMonth is not null && DateOnly.TryParseExact(Context.Request.Query["month"] + "-01", "yyyy-MM-dd",
        System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var selectedMonth)
        && selectedMonth.Year is >= 2000 and <= 2100) calendarMonth = selectedMonth;
    DateOnly? selectedDay = null;
    if (DateOnly.TryParseExact(Context.Request.Query["date"].ToString(), "yyyy-MM-dd",
        System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var chosenDate)
        && chosenDate.Year is >= 2000 and <= 2100) selectedDay = chosenDate;
    var calendarOpen = selectedDay is null && (Context.Request.Query["calendar"].ToString() == "open"
        || Context.Request.Query.ContainsKey("month"));
    if (selectedDay is { } dayToShow) calendarMonth = new DateOnly(dayToShow.Year, dayToShow.Month, 1);
    var canManage = Model.Farm.Role is "Owner" or "Manager";
    var actorId = Guid.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var userId)
        ? userId : Guid.Empty;
    var openCount = Model.Tasks.Count(task => task.Status == 0);
    var todayCount = Model.FarmToday is { } localDate
        ? Model.Tasks.Count(t => t.Status == 0 && t.DueDate <= localDate) : 0;
    var upcomingCount = Model.FarmToday is { } nextDate
        ? Model.Tasks.Count(t => t.Status == 0 && t.DueDate > nextDate) : 0;
    var closedCount = Model.Tasks.Count(t => t.Status != 0);
    var overdueCount = Model.FarmToday is { } overdueDate
        ? Model.Tasks.Count(t => t.Status == 0 && t.DueDate < overdueDate) : 0;
    var dueTodayCount = Model.FarmToday is { } dueDate
        ? Model.Tasks.Count(t => t.Status == 0 && t.DueDate == dueDate) : 0;
    var mineCount = Model.Tasks.Count(t => t.Status == 0 && t.AssignedToUserId == actorId);
    var shown = Model.SelectedView switch
    {
        "today" => Model.FarmToday is { } date
            ? Model.Tasks.Where(t => t.Status == 0 && t.DueDate <= date).ToList()
            : new List<SmartFarm.Core.Contracts.Tasks.FarmTaskDetails>(),
        "mine" => Model.Tasks.Where(t => t.Status == 0 && t.AssignedToUserId == actorId).ToList(),
        "upcoming" => Model.FarmToday is { } date
            ? Model.Tasks.Where(t => t.Status == 0 && t.DueDate > date).ToList()
            : new List<SmartFarm.Core.Contracts.Tasks.FarmTaskDetails>(),
        "completed" => Model.Tasks.Where(t => t.Status != 0).ToList(),
        _ => Model.Tasks.ToList()
    };
    if (selectedDay is { } activeDate)
        shown = Model.Tasks.Where(t => t.DueDate == activeDate).ToList();
    var ordered = shown.OrderBy(t => t.Status == 0 ? 0 : 1)
        .ThenBy(t => t.DueDate)
        .ThenBy(t => t.AssignedToUserId == actorId ? 0 : 1)
        .ThenBy(t => t.Id).ToList();
    const int pageSize = 12;
    var paginates = selectedDay.HasValue || Model.SelectedView is "all" or "completed" or "upcoming";
    var pageCount = paginates ? Math.Max(1, (ordered.Count + pageSize - 1) / pageSize) : 1;
    var requestedTaskId = Guid.TryParse(Context.Request.Query["taskId"].ToString(), out var selectedTaskId)
        ? (Guid?)selectedTaskId : null;
    var focusedTaskIndex = requestedTaskId is { } taskId
        ? ordered.FindIndex(task => task.Id == taskId) : -1;
    var requestedPage = int.TryParse(Context.Request.Query["page"], out var parsedPage)
        ? parsedPage : focusedTaskIndex >= 0 && paginates
            ? focusedTaskIndex / pageSize + 1 : 1;
    var currentPage = Math.Clamp(requestedPage, 1, pageCount);
    var visibleTasks = paginates
        ? ordered.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList() : ordered;
}
<div class="reference-screen reference-screen-tasks ani12e-workspace ani12e-tasks">
<partial name="_FarmNavigation" model="Model.Farm.Id" />
<section class="panel card sf-ops-hero ani12e-hero" aria-labelledby="tasks-heading">
    <div class="sf-page-header page-hero">
        <div>
            <p><a asp-controller="Farms" asp-action="Details" asp-route-id="@Model.Farm.Id">← @Model.Farm.Name</a></p>

            <p class="ani-overline">@T["Daily fieldwork"]</p>
            <h1 id="tasks-heading">@T["Farm tasks"]</h1>
            <p class="sf-muted">@T["See the next job, complete assigned work, or record field activity for a crop."]</p>
        </div>
        @if (canManage)
        {
            <a class="button" href="#add-task">@T["Add a task"]</a>
        }
    </div>
    <div class="sf-ops-summary ani-work-priority-summary ani12e-metrics" aria-label="@T["Farm task priorities"]">
        <div class="@(overdueCount > 0 ? "ani-priority-warning" : "")"><strong>@overdueCount</strong><span>@T["Overdue"]</span></div>
        <div><strong>@dueTodayCount</strong><span>@T["Due today"]</span></div>
        <div><strong>@mineCount</strong><span>@T["Assigned to me"]</span></div>
        <div><strong>@openCount</strong><span>@T["All open"]</span></div>
    </div>
    <p class="hint">@T["Scheduled planting, watering, and harvest tasks are added automatically when the worker is enabled."]</p>
    <p class="sf-ops-today">@T["Farm date: {0} · {1}", Model.FarmToday?.ToString("ddd, MMM d, yyyy") ?? "Unavailable — check the farm time zone", Model.Farm.TimeZoneId]</p>
    @if (TempData["Message"] is string message) { <p class="form-notice ani-save-feedback" role="status">@message</p> }
    @if (TempData["Error"] is string error) { <p class="error form-error" role="alert">@error</p> }
</section>
<div class="reference-task-workspace ani12e-task-workspace">
<section class="panel card sf-task-panel ani12e-primary-panel" aria-labelledby="task-list-heading">
    <div class="sf-section-line card-head">
        <h2 id="task-list-heading">@T["Work to do"]</h2>
        <span>@T["{0} on this page · {1} matching of {2}", visibleTasks.Count, shown.Count, Model.Tasks.Count]</span>
    </div>
    <nav class="ani-task-tabs filter-row ani12e-filter-tabs" aria-label="@T["Filter farm tasks"]">
        <a class="@(Model.SelectedView == "today" ? "is-selected" : "")"
           aria-current="@(Model.SelectedView == "today" ? "page" : null)"
           asp-controller="Tasks" asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-view="today" asp-fragment="task-list-heading">@T["Due / overdue"] <span>@todayCount</span>
        </a>
        <a class="@(Model.SelectedView == "mine" ? "is-selected" : "")"
           aria-current="@(Model.SelectedView == "mine" ? "page" : null)"
           asp-controller="Tasks" asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-view="mine" asp-fragment="task-list-heading">@T["Assigned to me"] <span>@mineCount</span>
        </a>
        <a class="@(Model.SelectedView == "upcoming" ? "is-selected" : "")"
           aria-current="@(Model.SelectedView == "upcoming" ? "page" : null)"
           asp-controller="Tasks" asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-view="upcoming" asp-fragment="task-list-heading">@T["Upcoming"] <span>@upcomingCount</span>
        </a>
        <a class="@(Model.SelectedView == "completed" ? "is-selected" : "")"
           aria-current="@(Model.SelectedView == "completed" ? "page" : null)"
           asp-controller="Tasks" asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-view="completed" asp-fragment="task-list-heading">@T["Closed"] <span>@closedCount</span>
        </a>
        <a class="@(Model.SelectedView == "all" ? "is-selected" : "")"
           aria-current="@(Model.SelectedView == "all" ? "page" : null)"
           asp-controller="Tasks" asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-view="all" asp-fragment="task-list-heading">@T["All"] <span>@Model.Tasks.Count</span>
        </a>
        <a class="ani-f2-calendar-action @(calendarOpen ? "is-selected" : "")"
           aria-current="@(calendarOpen ? "page" : null)"
           asp-controller="Tasks" asp-action="Index" asp-route-farmId="@Model.Farm.Id"
           asp-route-view="all" asp-route-calendar="open"
           asp-route-month="@(calendarMonth?.ToString("yyyy-MM"))" asp-fragment="task-calendar-heading">@T["Calendar"]</a>
    </nav>
    @if (selectedDay is { } selectedDate)
    {
        <div class="ani-f2-selected-day" role="status">
            <strong>@T["Tasks for"] @selectedDate.ToString("ddd, MMM d, yyyy")</strong>
            <a asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-view="all"
               asp-route-calendar="open" asp-route-month="@selectedDate.ToString("yyyy-MM")"
               asp-fragment="task-calendar-heading">@T["Change date"]</a>
        </div>
    }
    @if (Model.Tasks.Count == 0)
    {
        <partial name="_UiEmptyState" model='@(new UiEmptyState(
            T["No tasks yet."],
            canManage ? T["Add a task to schedule work, or plan a crop for upcoming farm reminders."]
                : T["Your farm owner or manager can assign tasks here. You can also open crops to record field observations."],
            canManage ? T["Add a task →"].Value : null,
            canManage ? "#add-task" : null))' />
    }
    else if (selectedDay is null && Model.FarmToday is null && Model.SelectedView is "today" or "upcoming")
    {
        <div class="sf-empty-state" role="status">
            <strong>@T["Farm time zone unavailable."]</strong>
            <p>@T["Open All tasks until the farm time zone is corrected."]</p>
            <a asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-view="all">@T["View all tasks →"]</a>
        </div>
    }
    else if (shown.Count == 0)
    {
        <div class="sf-empty-state">
            <strong>@(selectedDay.HasValue ? T["No tasks for this date."] : T["No tasks in this view."])</strong>
            <p>@(selectedDay.HasValue ? T["Select a different day from Calendar."] :
                 Model.SelectedView == "today" ? T["Nothing is overdue or due today."] :
                 Model.SelectedView == "mine" ? T["No open tasks are assigned to you. Check due work or ask your farm manager about assignments."] :
                 Model.SelectedView == "upcoming" ? T["No upcoming work is scheduled."] :
                 T["No tasks have been closed yet."])</p>
            <a asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-view="all">@T["View all tasks →"]</a>
        </div>
    }
    else
    {
        <ul class="sf-task-list checklist ani12e-task-list">
        @foreach (var task in visibleTasks)
        {
            <li id="task-@task.Id" class="sf-task-item ani12e-task-card @(task.Status == 0 ? "sf-task-open" : "sf-task-closed") @(task.Status == 0 && Model.FarmToday is { } date && task.DueDate < date ? "ani-task-urgent" : "")">
                <div class="sf-task-main">
                    <span class="sf-task-symbol reference-task-check @(task.Status != 0 ? "is-closed" : "")" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="4" />@if (task.Status != 0) { <path d="m7 12 3 3 7-7" /> }</svg></span>
                    <div class="sf-task-content">
                        <div class="sf-task-title">
                            <h3>@T[task.TaskTypeName]</h3>
                            @if (task.Status == 0 && Model.FarmToday is { } today && task.DueDate < today)
                            { <span class="sf-status-chip sf-status-chip--warning">@T["Overdue"]</span> }
                            <partial name="_UiStatusChip" model='@(new UiStatusChip(
                                task.StatusName,
                                task.Status == 0 ? "sf-status-chip--active" : "sf-status-chip--neutral"))' />
                        </div>
                        <div class="sf-task-meta">
                            <span><strong>@T["Due:"]</strong> <time datetime="@task.DueDate.ToString("yyyy-MM-dd")">@task.DueDate.ToString("MMM d, yyyy")</time></span>
                            @if (task.AssignedToUserId is { } assigned)
                            {
                                <span><strong>@T["Assigned:"]</strong> @(assigned == actorId ? T["You"] : Model.Members.FirstOrDefault(m => m.UserId == assigned)?.FullName ?? T["Farm member"])</span>
                            }
                            else
                            {
                                <span>@T["Unassigned · Farm owner receives reminder"]</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(task.Description))
                        {
                            <p class="sf-task-description">@task.Description</p>
                        }
                        @if (task.CropCycleId is { } cropId)
                        {
                            var crop = Model.Cycles.FirstOrDefault(c => c.Id == cropId);
                            if (crop is not null)
                            {
                                <span class="sf-muted">@crop.CropTypeName · @crop.PlotName</span>
                                @if (crop.Status == CropCycleStatus.Active && task.Status == 0 && (canManage || task.AssignedToUserId == actorId))
                                {
                                    <partial name="_TaskRecordLink" model="task" />
                                }
                                else
                                {
                                    <a class="ani-task-crop-link" asp-controller="Crops" asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-cycleId="@crop.Id" asp-fragment="crop-history">@T["View crop history"]</a>
                                }
                            }
                        }
                    </div>
                </div>
                @if (task.Status == 0 && (canManage || task.AssignedToUserId == actorId))
                {
                    <div class="sf-task-actions ani12e-task-actions">
                        <form asp-action="Close" asp-route-farmId="@Model.Farm.Id" asp-route-taskId="@task.Id" method="post">
                            <input type="hidden" name="RowVersion" value="@task.RowVersion" />
                            <input type="hidden" name="returnView" value="@Model.SelectedView" />
                            <button type="submit" name="Status" value="1"
                                    aria-label="@T["Mark {0} task due {1} as completed", T[task.TaskTypeName], task.DueDate.ToString("MMM d")]">@T["Mark completed"]</button>
                        </form>
                        <details class="ani-task-other">
                            <summary>@T["Other status"]</summary>
                            <form asp-action="Close" asp-route-farmId="@Model.Farm.Id" asp-route-taskId="@task.Id"
                                  method="post" data-confirm="@T["Close this task without marking it completed?"]">
                                <input type="hidden" name="RowVersion" value="@task.RowVersion" />
                                <input type="hidden" name="returnView" value="@Model.SelectedView" />
                                <label for="close-status-@task.Id">@T["Status"]</label>
                                <select id="close-status-@task.Id" name="Status">
                                    <option value="2">@T["Skipped"]</option>
                                    <option value="3">@T["Cancelled"]</option>
                                </select>
                                <button type="submit" class="sf-button-outline">@T["Apply status"]</button>
                            </form>
                        </details>
                    </div>
                }
                @if (task.Status == 0 && canManage)
                {
                    <details class="sf-edit-disclosure">
                        <summary>@T["Edit task and assignment"]</summary>
                        <form asp-action="Update" asp-route-farmId="@Model.Farm.Id" asp-route-taskId="@task.Id" method="post" class="sf-ops-form">
                            <input type="hidden" name="RowVersion" value="@task.RowVersion" />
                            <label for="editDue-@task.Id">@T["Due date"]</label>
                            <input type="date" id="editDue-@task.Id" name="DueDate" value="@task.DueDate.ToString("yyyy-MM-dd")" required />
                            <label for="editAssignee-@task.Id">@T["Assigned member"]</label>
                            <select id="editAssignee-@task.Id" name="AssignedToUserId">
                                <option value="" selected="@(task.AssignedToUserId is null)">@T["Unassigned (farm owner gets the reminder)"]</option>
                                @foreach (var member in Model.Members)
                                {
                                    <option value="@member.UserId" selected="@(task.AssignedToUserId == member.UserId)">@member.FullName — @T[member.Role]</option>
                                }
                            </select>
                            <label for="editDescription-@task.Id">@T["Description"]</label>
                            <textarea id="editDescription-@task.Id" name="Description" maxlength="500">@task.Description</textarea>
                            <button type="submit">@T["Save task changes"]</button>
                        </form>
                    </details>
                }
            </li>
        }
        </ul>
        @if (pageCount > 1)
        {
            <nav class="ani-p4-pager ani-f2-pager" aria-label="@T["Task result pages"]">
                <span>@T["{0} {1} of {2}", T["Page"], currentPage, pageCount]</span>
                @if (currentPage > 1)
                {
                    <a asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-view="@Model.SelectedView"
                       asp-route-date="@(selectedDay?.ToString("yyyy-MM-dd"))"
                       asp-route-page="@(currentPage - 1)" asp-fragment="task-list-heading" rel="prev">@T["Previous"]</a>
                }
                @if (currentPage < pageCount)
                {
                    <a asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-view="@Model.SelectedView"
                       asp-route-date="@(selectedDay?.ToString("yyyy-MM-dd"))"
                       asp-route-page="@(currentPage + 1)" asp-fragment="task-list-heading" rel="next">@T["Next"]</a>
                }
            </nav>
        }
    }
</section>
@if (calendarOpen && calendarMonth is { } month)
{
    <section class="panel card reference-task-calendar ani12e-task-calendar" aria-labelledby="task-calendar-heading">
        <header class="reference-panel-heading"><h2 id="task-calendar-heading">@T["Task calendar"]</h2></header>
        <nav class="crop-agenda-nav ani12e-month-nav" aria-label="@T["Task calendar month"]">
            @if (month.Year > 2000 || month.Month > 1) { <a asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-view="@Model.SelectedView" asp-route-month="@month.AddMonths(-1).ToString("yyyy-MM")" asp-fragment="task-calendar-heading" aria-label="@T["Previous task month"]">@T["← Previous"]</a> }
            <strong>@month.ToString("MMMM yyyy")</strong>
            @if (month.Year < 2100 || month.Month < 12) { <a asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-view="@Model.SelectedView" asp-route-month="@month.AddMonths(1).ToString("yyyy-MM")" asp-fragment="task-calendar-heading" aria-label="@T["Next task month"]">@T["Next →"]</a> }
        </nav>
        <div class="reference-calendar" role="group" aria-label="@T["Task dates in {0}", month.ToString("MMMM yyyy")]">
            <div class="calendar-grid reference-calendar-week" aria-hidden="true">@foreach (var day in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" }) { <span>@day</span> }</div>
            <div class="calendar-grid">
                @for (var blank = 0; blank < (int)month.DayOfWeek; blank++) { <div class="cal-cell outside" aria-hidden="true"></div> }
                @for (var day = 1; day <= DateTime.DaysInMonth(month.Year, month.Month); day++)
                {
                    var date = new DateOnly(month.Year, month.Month, day);
                    var due = Model.Tasks.Where(t => t.DueDate == date).OrderBy(t => t.Id).ToList();
                    <div class="cal-cell @(due.Count > 0 ? "has-events" : "") @(date == Model.FarmToday ? "is-today" : "")">
                    <a asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-view="all"
                       asp-route-date="@date.ToString("yyyy-MM-dd")" asp-fragment="task-list-heading"
                       aria-label="@T["{0}, {1} tasks", date.ToString("MMMM d"), due.Count]">
                        <time datetime="@date.ToString("yyyy-MM-dd")">@day</time>
                        @if (due.Count > 0) { <span class="calendar-event-dot" aria-hidden="true"></span> }
                    </a>
                    </div>
                }
            </div>
        </div>
        <p class="hint">@T["Dates follow"] @Model.Farm.TimeZoneId. Select any date to see its tasks; the calendar closes after selection.</p>
        @{
            var monthTasks = Model.Tasks.Where(t => t.DueDate.Year == month.Year && t.DueDate.Month == month.Month)
                .OrderBy(t => t.DueDate).ThenBy(t => t.Status).ToList();
        }
        <div class="ani12e-mobile-agenda" aria-label="@T["Task schedule for {0}", month.ToString("MMMM yyyy")]">
            @if (monthTasks.Count == 0)
            {
                <p>@T["No tasks scheduled this month. Select another month to check upcoming work."]</p>
            }
            else
            {
                <ol>
                @foreach (var scheduled in monthTasks)
                {
                    <li>
                        <time datetime="@scheduled.DueDate.ToString("yyyy-MM-dd")">@scheduled.DueDate.ToString("MMM d")</time>
                        <span><strong>@T[scheduled.TaskTypeName]</strong><small>@T[scheduled.StatusName]</small></span>
                        <a asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-view="all"
                           asp-route-date="@scheduled.DueDate.ToString("yyyy-MM-dd")"
                           asp-route-taskId="@scheduled.Id"
                           asp-fragment="@("task-" + scheduled.Id)">@T["View task"]</a>
                    </li>
                }
                </ol>
            }
        </div>
    </section>
}
</div>
@if (canManage)
{
    <section class="panel card sf-task-create ani12e-create-panel" id="add-task" data-form-dialog aria-labelledby="add-task-heading">
        <div class="sf-section-line card-head">
            <div>

                <h2 id="add-task-heading">@T["Add a task"]</h2>
            </div>
        </div>
        <p class="sf-muted">@T["Choose what needs doing and when. A crop or person can be assigned later."]</p>
        <form asp-action="Create" asp-route-farmId="@Model.Farm.Id" method="post" class="sf-ops-form sf-create-task-form ani-p5-form" data-ani-p5-form>
            <div>
                <label for="taskType">@T["Task type"]</label>
                <select name="TaskType" id="taskType">
                    @foreach (var option in FarmCodeLabels.TaskTypes)
                    {
                        <option value="@option.Code">@option.Name</option>
                    }
                </select>
            </div>
            <div>
                <label for="taskDue">@T["Due date"]</label>
                <input type="date" id="taskDue" name="DueDate" required aria-describedby="ani-p5-task-due-help" />
                <p class="hint" id="ani-p5-task-due-help">@T["Choose when this task should be done in your farm's time zone."]</p>
            </div>
            <div>
                <label for="taskCrop">@T["Crop cycle (optional)"]</label>
                <select name="CropCycleId" id="taskCrop">
                    <option value="">@T["No crop"]</option>
                    @foreach (var crop in Model.Cycles)
                    {
                        <option value="@crop.Id">@crop.PlotName — @crop.CropTypeName</option>
                    }
                </select>
            </div>
            <div>
                <label for="taskAssignee">@T["Assign to (optional)"]</label>
                <select name="AssignedToUserId" id="taskAssignee">
                    <option value="">@T["Unassigned (reminder goes to farm owner)"]</option>
                    @foreach (var member in Model.Members)
                    {
                        <option value="@member.UserId">@member.FullName — @T[member.Role]</option>
                    }
                </select>
            </div>
            <div class="sf-form-wide">
                <label for="taskDescription">@T["Instructions (optional)"]</label>
                <textarea id="taskDescription" name="Description" maxlength="500"></textarea>
            </div>
            <div class="sf-form-wide">
                <button type="submit">@T["Create task"]</button>
            </div>
        </form>
    </section>
}

</div>
