@model SmartFarm.Web.ViewModels.Reports.HarvestReportPage
@{
    ViewData["Title"] = "Harvest reports";
    ViewData["FarmName"] = Model.Report.FarmName;
    var report = Model.Report;
    var hasFilters = report.FromDate.HasValue || report.ToDate.HasValue
        || report.PlotId.HasValue || report.CropTypeId.HasValue;
}
<div class="reference-screen reference-screen-reports">
<partial name="_FarmNavigation" model="Model.Report.FarmId" />
<section class="panel card sf-report-hero ani-report-hero" aria-labelledby="reports-heading">
    <div class="sf-page-header page-hero">
        <div>
            <p><a asp-controller="Dashboard" asp-action="Index" asp-route-farmId="@report.FarmId">← Farm dashboard</a></p>

            <p class="ani-overline">Farm performance</p>
            <h1 id="reports-heading">Harvest summary</h1>
            <p class="sf-muted">@report.FarmName · Dates follow @report.TimeZoneId.</p>
            <p class="ani-insight-note">See what was actually harvested. Quantities use their recorded units, and voided entries do not count toward totals.</p>
        </div>
        <a class="sf-button-outline" asp-controller="FarmFinance" asp-action="Index" asp-route-farmId="@report.FarmId">View farm finances</a>
    </div>
    <nav class="ani-insight-links ani-report-jump-links" aria-label="Harvest report sections">
        <a href="#report-history-heading">Recent harvests</a>
        <a href="#report-by-cycle">Planting cycles</a>
        <a href="#monthly-yield-table">Monthly totals</a>
        <a href="#harvest-analytics-heading">Charts &amp; comparisons</a>
    </nav>
    
    <div class="ani-report-result-heading">
        <h2>Harvests at a glance</h2>
        <p>@(hasFilters ? "Showing filtered records only." : "Showing all recorded harvest dates, plots, and crops.")</p>
    </div>
    <div class="sf-report-counts ani-report-counts" aria-label="Report record counts">
        <div><strong>@report.ValidHarvestCount</strong><span>Valid harvest records</span></div>
        <div><strong>@report.VoidedHarvestCount</strong><span>Voided records</span></div>
    </div>
    <h2 class="sf-report-totals-title">Recorded yield by unit</h2>
    @if (report.UnitTotals.Count == 0)
    {
        <div class="sf-empty-state">
            <strong>No recorded harvests for this view.</strong>
            <p>@(hasFilters ? "Try clearing the date, plot, or crop filters to see all farm records." : "Harvests will appear after a worker records a valid partial harvest on a crop.")</p>
            @if (hasFilters) { <a asp-action="Harvests" asp-route-farmId="@report.FarmId">See all harvests →</a> }
            else { <a asp-controller="Crops" asp-action="Index" asp-route-farmId="@report.FarmId">Open farm crops →</a> }
        </div>
    }
    else
    {
        <div class="stat-grid sf-report-unit-totals">
        @foreach (var total in report.UnitTotals)
        {
            <div class="stat">
                <span>@total.HarvestCount valid harvests</span>
                <strong>@total.Quantity.ToString("N3") @total.Unit</strong>
            </div>
        }
        </div>
    }
    <p class="hint">Each unit has its own total—kg, pieces, and other units are never added together. Voided harvests are excluded.</p>

    <details class="ani-report-filter-details" open="@hasFilters" id="report-filters">
        <summary><strong>Filters &amp; downloads</strong>
            <span>@(hasFilters ? "Filters applied · change your selection or export" : "Choose dates, fields, crops, or export CSV")</span>
        </summary>
        <div class="ani-report-filter-inner">
            <div class="sf-report-filter-header">
        <h3>Choose what to include</h3>
        <p class="sf-muted">Use a date range, plot, or crop to narrow totals, tables, charts, and CSV downloads together.</p>
    </div>
    <form method="get" asp-action="Harvests" class="report-filters sf-report-filters">
        <input type="hidden" name="farmId" value="@report.FarmId" />
        <div><label for="from">From</label>
            <input id="from" type="date" name="from" min="2000-01-01" max="2100-12-30" value="@(report.FromDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div><label for="to">To</label>
            <input id="to" type="date" name="to" min="2000-01-01" max="2100-12-30" value="@(report.ToDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div><label for="plot">Plot</label>
            <select id="plot" name="plotId">
                <option value="">All plots</option>
                @foreach (var plot in Model.Plots)
                {
                    <option value="@plot.Id" selected="@(report.PlotId == plot.Id)">@plot.Name</option>
                }
            </select>
        </div>
        <div><label for="crop">Crop type</label>
            <select id="crop" name="cropTypeId">
                <option value="">All crops</option>
                @foreach (var crop in Model.CropTypes)
                {
                    <option value="@crop.Id" selected="@(report.CropTypeId == crop.Id)">@crop.Name</option>
                }
            </select>
        </div>
        <button type="submit">Apply filters</button>
    </form>
    <div class="action-links sf-report-actions">
        <a asp-action="Harvests" asp-route-farmId="@report.FarmId">Clear filters</a>
        <a class="button" asp-action="ExportCsv" asp-route-farmId="@report.FarmId"
           asp-route-from="@(report.FromDate?.ToString("yyyy-MM-dd"))" asp-route-to="@(report.ToDate?.ToString("yyyy-MM-dd"))"
           asp-route-plotId="@report.PlotId" asp-route-cropTypeId="@report.CropTypeId">
            Export records CSV
        </a>
        <a class="sf-button-outline" asp-action="ExportCycleCsv" asp-route-farmId="@report.FarmId"
           asp-route-from="@(report.FromDate?.ToString("yyyy-MM-dd"))"
           asp-route-to="@(report.ToDate?.ToString("yyyy-MM-dd"))"
           asp-route-plotId="@report.PlotId" asp-route-cropTypeId="@report.CropTypeId">
            Export cycle totals CSV
        </a>
    </div>
    
        </div>
    </details>
</section>

<section class="ani-report-main-content" aria-label="Harvest report results">
<section class="panel card sf-report-table-panel ani-report-table" aria-labelledby="report-history-heading">
    <header class="reference-panel-heading"><h2 id="report-history-heading">Recent harvests</h2></header>
    <p class="hint">Latest 100 matching records, including voided entries. For the complete list, use Export records CSV in Filters &amp; downloads.</p>
    @if (report.Entries.Count == 0)
    {
        <div class="sf-empty-state"><strong>No harvest entries to show.</strong>
            <p>@(hasFilters ? "Adjust the filters or clear them to see other dates and crops." : "New harvests appear after they are saved on an active crop.")</p>
            @if (hasFilters) { <a asp-action="Harvests" asp-route-farmId="@report.FarmId">Clear harvest filters →</a> }
        </div>
    }
    else
    {
        <div class="table-scroll" tabindex="0" role="region" aria-label="Harvest record history">
            <table class="data-table">
                <caption class="visually-hidden">Harvest record history</caption>
                <thead><tr><th scope="col">Farm date</th><th scope="col">Crop / plot</th><th scope="col">Quantity</th><th scope="col">Status</th></tr></thead>
                <tbody>
                @foreach (var item in report.Entries.Take(100))
                {
                    <tr>
                        <td>@item.FarmDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.CropTypeName · @item.PlotName</td>
                        <td>@item.Quantity.ToString("N3") @item.Unit</td>
                        <td>@(item.IsVoided ? "Voided" : "Valid")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
<section class="panel card sf-report-table-panel ani-report-table" aria-labelledby="report-by-cycle">
    <div class="sf-section-line card-head">
        <h2 id="report-by-cycle">Yield by planting cycle</h2>
        <span>@report.CycleTotals.Count cycle / unit groups</span>
    </div>
    @if (report.CycleTotals.Count == 0)
    {
        <p>No valid harvests are available for cycle comparisons.</p>
    }
    else
    {
        <div class="table-scroll" tabindex="0" role="region" aria-label="Yield comparison by cycle">
            <table class="data-table">
                <caption class="visually-hidden">Individual planting cycles and harvest totals by unit</caption>
                <thead><tr>
                    <th scope="col">Crop / plot</th>
                    <th scope="col">First harvest</th>
                    <th scope="col">Last harvest</th>
                    <th scope="col">Partial harvests</th>
                    <th scope="col">Recorded quantity</th>
                </tr></thead>
                <tbody>
                @foreach (var cycle in report.CycleTotals)
                {
                    <tr>
                        <td><strong>@cycle.CropTypeName</strong> · @cycle.PlotName
                            <small>Cycle @cycle.CycleId.ToString("N")[..6]</small></td>
                        <td>@cycle.FirstHarvestDate.ToString("yyyy-MM-dd")</td>
                        <td>@cycle.LastHarvestDate.ToString("yyyy-MM-dd")</td>
                        <td>@cycle.HarvestCount</td>
                        <td>@cycle.Quantity.ToString("N3") @cycle.Unit</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel card sf-report-table-panel ani-report-table" aria-labelledby="monthly-yield-table">
    <header class="reference-panel-heading"><h2 id="monthly-yield-table">Monthly yield</h2></header>
    @if (report.MonthlyTotals.Count == 0) { <p>No monthly harvest data.</p> }
    else
    {
        <div class="table-scroll" tabindex="0" role="region" aria-label="Scrollable monthly yield records">
            <table class="data-table">
                <caption class="visually-hidden">Monthly yield</caption>
                <thead><tr><th scope="col">Month</th><th scope="col">Harvests</th><th scope="col">Quantity</th></tr></thead>
                <tbody>
                @foreach (var item in report.MonthlyTotals)
                {
                    <tr><td>@item.Month</td><td>@item.HarvestCount</td>
                        <td>@item.Quantity.ToString("N3") @item.Unit</td></tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

</section>
<details class="ani-report-advanced" id="report-advanced">
    <summary><strong>Charts &amp; detailed comparisons</strong>
        <span>Analyze yields by cycle, month, crop and plot</span></summary>
    <div class="ani-report-advanced-inner">
<section class="panel card sf-report-analytics ani-report-charts" aria-labelledby="harvest-analytics-heading">
    <header class="reference-panel-heading"><h2 id="harvest-analytics-heading">Detailed yield comparisons</h2></header>
    <p class="hint">Compare individual planting cycles without mixing different units or combining
        repeated plantings on the same plot. Multiple partial harvests add to their own cycle total.</p>
    @if (Model.CycleCharts.Count == 0)
    {
        <p>No crop cycles with valid harvests match the selected filters.</p>
    }
    @foreach (var chart in Model.CycleCharts)
    {
        <div class="reference-chart-block">
        <h3>Recorded yield by planting cycle · @chart.Unit</h3>
        <div class="harvest-chart sf-report-chart ani-report-chart" role="group"
             aria-label="Cycle yield comparison in @chart.Unit">
        @foreach (var bar in chart.Bars)
        {
            <div class="harvest-bar-row">
                <span>@bar.Label</span>
                <div class="harvest-bar-track" role="img"
                     aria-label="@bar.Label: @bar.Quantity.ToString("N3") @chart.Unit from @bar.HarvestCount harvests">
                    <span class="harvest-bar-fill" style="width:@(bar.WidthPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                </div>
                <div>
                    <strong>@bar.Quantity.ToString("N3") @chart.Unit</strong>
                    @if (bar.YieldPerSquareMeter is { } perSquareMeter)
                    {
                        <small> @perSquareMeter.ToString("N3") @chart.Unit/m²</small>
                    }
                </div>
            </div>
        }
        </div>
        @if (chart.TotalRows > chart.Bars.Count)
        {
            <p class="hint">Showing the top @chart.Bars.Count of @chart.TotalRows cycles in this unit;
                the table below includes all matching cycles.</p>
        }
        </div>
    }
    <p class="hint">Comparisons reflect recorded harvests within the selected dates,
        including partial harvests. They do not predict future yields.
        Per-area estimates use the plot's current recorded area.</p>
    <p class="hint">Charts follow your current date, plot, and crop filters. Voided harvests are excluded. Each unit has its own scale.</p>
    @if (Model.MonthlyCharts.Count == 0)
    {
        <p>No harvest data to chart for the selected filters.</p>
    }
    @foreach (var chart in Model.MonthlyCharts)
    {
        <div class="reference-chart-block">
        <h3>Monthly yield · @chart.Unit</h3>
        <div class="harvest-chart sf-report-chart ani-report-chart" role="group" aria-label="Monthly harvest in @chart.Unit">
        @foreach (var bar in chart.Bars)
        {
            <div class="harvest-bar-row">
                <span>@bar.Label</span>
                <div class="harvest-bar-track" role="img"
                     aria-label="@bar.Label: @bar.Quantity.ToString("N3") @chart.Unit from @bar.HarvestCount harvests">
                    <span class="harvest-bar-fill" style="width:@(bar.WidthPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                </div>
                <strong>@bar.Quantity.ToString("N3") @chart.Unit</strong>
            </div>
        }
        </div>
        @if (chart.TotalRows > chart.Bars.Count)
        {
            <p class="hint">Showing the most recent @chart.Bars.Count of @chart.TotalRows months for this unit.</p>
        }
        </div>
    }
    @foreach (var chart in Model.CropPlotCharts)
    {
        <div class="reference-chart-block">
        <h3>Yield by crop and plot · @chart.Unit</h3>
        <div class="harvest-chart sf-report-chart ani-report-chart" role="group" aria-label="Yield by crop and plot in @chart.Unit">
        @foreach (var bar in chart.Bars)
        {
            <div class="harvest-bar-row">
                <span>@bar.Label</span>
                <div class="harvest-bar-track" role="img"
                     aria-label="@bar.Label: @bar.Quantity.ToString("N3") @chart.Unit">
                    <span class="harvest-bar-fill" style="width:@(bar.WidthPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                </div>
                <div>
                    <strong>@bar.Quantity.ToString("N3") @chart.Unit</strong>
                    @if (bar.YieldPerSquareMeter is { } perArea)
                    {
                        <small> @perArea.ToString("N3") @chart.Unit/m²</small>
                    }
                </div>
            </div>
        }
        </div>
        @if (chart.TotalRows > chart.Bars.Count)
        {
            <p class="hint">Showing the top @chart.Bars.Count of @chart.TotalRows crop/plot totals for this unit.</p>
        }
        </div>
    }
    <p class="hint">Yield per square meter uses the plot's current recorded area; it is a historical estimate if the area changed.</p>
</section>

<section class="panel card sf-report-table-panel ani-report-table" aria-labelledby="report-by-plot">
    <header class="reference-panel-heading"><h2 id="report-by-plot">Harvest by crop and plot</h2></header>
    @if (report.CropPlotTotals.Count == 0) { <p>No matching totals.</p> }
    else
    {
        <div class="table-scroll" tabindex="0" role="region" aria-label="Harvest by crop and plot">
            <table class="data-table">
                <caption class="visually-hidden">Harvest by crop and plot</caption>
                <thead><tr><th scope="col">Crop</th><th scope="col">Plot</th><th scope="col">Harvests</th><th scope="col">Quantity</th></tr></thead>
                <tbody>
                @foreach (var item in report.CropPlotTotals)
                {
                    <tr>
                        <td>@item.CropTypeName</td><td>@item.PlotName</td>
                        <td>@item.HarvestCount</td>
                        <td>@item.Quantity.ToString("N3") @item.Unit</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

    </div>
</details>
</div>
