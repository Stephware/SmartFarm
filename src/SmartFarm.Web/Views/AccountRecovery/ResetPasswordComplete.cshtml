@{
    ViewData["Title"] = T["Password updated"];
}
<section class="panel auth-card ani-entry-auth-card" aria-labelledby="reset-complete-heading" role="status">
    <div class="auth-heading">
        <h1 id="reset-complete-heading">@T["Password updated"]</h1>
        <p>@T["Your password has been changed. Sign in using your new password."]</p>
    </div>
    <p class="auth-switch"><a asp-controller="Account" asp-action="Login">@T["Back to log in"]</a></p>
</section>
