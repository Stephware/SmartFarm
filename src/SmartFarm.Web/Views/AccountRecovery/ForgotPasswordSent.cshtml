@{
    ViewData["Title"] = T["Check your email"];
}
<section class="panel auth-card ani-entry-auth-card" aria-labelledby="recovery-sent-heading" role="status">
    <div class="auth-heading">
        <h1 id="recovery-sent-heading">@T["Check your email"]</h1>
        <p>@T["If the email belongs to an active account and email delivery is configured, password reset instructions will be sent."]</p>
        <p>@T["For security, we cannot confirm whether an account exists for that address."]</p>
    </div>
    <p class="auth-switch"><a asp-controller="Account" asp-action="Login">@T["Back to log in"]</a></p>
</section>
