@model SmartFarm.Web.ViewModels.Support.SupportListPage
@{
    ViewData["Title"] = "Previous support requests";
}
<partial name="_UiPageHeader" model='@(new UiPageHeader("Previous support requests", "Read-only history. New requests and replies are retired; use Help for next steps."))' />
<a asp-controller="Home" asp-action="Help">Help</a>
@if (TempData["Message"] is string message) { <p class="form-notice" role="status">@message</p> }
<section class="panel admin-directory-panel" aria-label="My requests">
    @if (Model.Tickets.Count == 0)
    {
        <p class="admin-empty">No previous requests.</p>
    }
    else
    {
        <div class="admin-record-list">
            @foreach (var ticket in Model.Tickets)
            {
                <a class="admin-record" asp-area="" asp-controller="Support" asp-action="Details" asp-route-id="@ticket.Id">
                    <span class="admin-record-main"><strong>@ticket.Title</strong>
                        <small>@ticket.Category @(ticket.FarmName is null ? "" : $"· {ticket.FarmName}")</small>
                        <small>Updated @ticket.UpdatedAtUtc.ToString("MMM d, yyyy") UTC</small></span>
                    <span class="sf-status-chip @(ticket.Status is "Open" or "InProgress" ? "sf-status-chip--planned" : "sf-status-chip--active")">@ticket.Status</span>
                </a>
            }
        </div>
    }
</section>
