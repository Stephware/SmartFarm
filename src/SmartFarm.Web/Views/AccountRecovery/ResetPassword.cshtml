@model SmartFarm.Web.ViewModels.Auth.ResetPasswordForm
@{
    ViewData["Title"] = T["Set a new password"];
}
<section class="panel auth-card ani-entry-auth-card" aria-labelledby="reset-heading">
    <div class="auth-heading">
        <p class="ani-entry-eyebrow">@T["ACCOUNT RECOVERY"]</p>
        <h1 id="reset-heading">@T["Set a new password"]</h1>
        <p>@T["Choose a new password for your AniGo account."]</p>
    </div>
    <form asp-controller="AccountRecovery" asp-action="Reset" method="post" class="auth-form"
          autocomplete="off">
        @Html.AntiForgeryToken()
        <input asp-for="Email" type="hidden" />
        <input asp-for="Token" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="error" role="alert"></div>
        <div class="form-field">
            <label asp-for="Password">@T["New password"]</label>
            <input asp-for="Password" type="password" autocomplete="new-password"
                   required minlength="10" maxlength="256" aria-describedby="reset-guidance" />
            <span asp-validation-for="Password" class="error"></span>
            <p class="hint" id="reset-guidance">@T["Use at least 10 characters, including uppercase, lowercase, and a number."]</p>
        </div>
        <div class="form-field">
            <label asp-for="ConfirmPassword">@T["Confirm new password"]</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
            <span asp-validation-for="ConfirmPassword" class="error"></span>
        </div>
        <button type="submit" class="auth-submit">@T["Reset password"]</button>
    </form>
    <p class="auth-switch"><a asp-controller="AccountRecovery" asp-action="ForgotPassword">@T["Request another reset link"]</a></p>
</section>
