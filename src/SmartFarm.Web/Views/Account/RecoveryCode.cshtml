@model SmartFarm.Web.ViewModels.Auth.AdminRecoveryInput
@{
    ViewData["Title"] = T["Recovery code sign in"];
}
<section class="panel narrow admin-login-panel" aria-labelledby="recovery-heading">
    <a class="ui-back-link" asp-action="TwoFactor" asp-route-returnUrl="@Model.ReturnUrl">@T["Use my authenticator instead"]</a>
    <p class="sf-kicker">@T["ACCOUNT RECOVERY"]</p>
    <h1 id="recovery-heading">@T["Use a recovery code"]</h1>
    <p>@T["Use one of your saved recovery codes. Each code works only once."]</p>
    <form asp-action="RecoveryCode" method="post">
        <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <label asp-for="Code">@T["Recovery code"]</label>
        <input asp-for="Code" autocomplete="off" maxlength="32" required />
        <button type="submit">@T["Verify recovery code"]</button>
    </form>
</section>
