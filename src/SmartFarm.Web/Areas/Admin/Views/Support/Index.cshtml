@model SmartFarm.Web.ViewModels.Support.AdminSupportListPage
@{
    ViewData["Title"] = T["Support history"];
}
<div class="page-heading admin-page-heading">
    <div><h1>@T["Support history"]</h1>
        <p class="sf-muted">@T["Review retained support requests and their recorded history."]</p></div>
</div>
<section class="admin-stats" aria-label="@T["Support totals"]">
    <a class="admin-stat panel" asp-area="Admin" asp-controller="Support" asp-action="Index" asp-route-status="Open"><span>@T["Open"]</span><strong>@Model.OpenCount</strong><small>@T["Retained open status"]</small></a>
    <a class="admin-stat panel" asp-area="Admin" asp-controller="Support" asp-action="Index" asp-route-status="InProgress"><span>@T["In progress"]</span><strong>@Model.InProgressCount</strong><small>@T["Retained in-progress status"]</small></a>
    <a class="admin-stat panel" asp-area="Admin" asp-controller="Support" asp-action="Index" asp-route-status="Resolved"><span>@T["Resolved"]</span><strong>@Model.ResolvedCount</strong><small>@T["Retained resolved status"]</small></a>
</section>
<section class="panel admin-directory-panel" aria-label="@T["Support queue"]">
    <form class="admin-filters" method="get" asp-area="Admin" asp-controller="Support" asp-action="Index">
        <div class="admin-filter-search"><label for="support-search">@T["Find a request"]</label>
            <input id="support-search" name="search" type="search" maxlength="100" value="@Model.Search" placeholder="@T["Title or user email"]" /></div>
        <div><label for="support-status">@T["Status"]</label><select id="support-status" name="status">
            <option value="All" selected="@(Model.Status == "All")">@T["All statuses"]</option>
            @foreach (var status in SmartFarm.Web.ViewModels.Support.SupportRules.Statuses) {
                <option value="@status" selected="@(Model.Status == status)">@status</option>
            }
        </select></div>
        <div><label for="support-priority">@T["Priority"]</label><select id="support-priority" name="priority">
            <option value="All" selected="@(Model.Priority == "All")">@T["All priorities"]</option>
            @foreach (var priority in SmartFarm.Web.ViewModels.Support.SupportRules.Priorities) {
                <option value="@priority" selected="@(Model.Priority == priority)">@priority</option>
            }
        </select></div>
        <button type="submit">@T["Filter"]</button>
        <a class="admin-reset" asp-area="Admin" asp-controller="Support" asp-action="Index">@T["Clear"]</a>
    </form>
    <p class="admin-results-count">@T["{0} {1} found", Model.Total, Model.Total == 1 ? "request" : "requests"]</p>
    @if (Model.Tickets.Count == 0) { <div class="admin-empty"><strong>@T["No matching requests"]</strong><p>@T["Try changing the filters."]</p></div> }
    else {
        <div class="admin-record-list">
            @foreach (var ticket in Model.Tickets) {
                <a class="admin-record" asp-area="Admin" asp-controller="Support" asp-action="Details" asp-route-id="@ticket.Id">
                    <span class="admin-record-main"><strong>@ticket.Title</strong>
                        <small>@ticket.UserName · @ticket.UserEmail</small>
                        <small>@T["{0} {1} · Updated {2} UTC", ticket.Category, ticket.FarmName is null ? "" : $"· {ticket.FarmName}", ticket.UpdatedAtUtc.ToString("MMM d")]</small></span>
                    <span class="admin-record-meta">
                        @if (ticket.Priority == "High") { <span class="sf-status-chip sf-status-chip--planned">@T["High priority"]</span> }
                        <span class="sf-status-chip @(ticket.Status is "Open" or "InProgress" ? "sf-status-chip--planned" : "sf-status-chip--active")">@ticket.Status</span>
                    </span>
                </a>
            }
        </div>
        <nav class="admin-pagination" aria-label="@T["Support pages"]">
            @if (Model.HasPrevious) { <a asp-area="Admin" asp-controller="Support" asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-priority="@Model.Priority" asp-route-page="@(Model.Page - 1)">@T["Previous"]</a> }
            <span>@T["Page {0} of {1}", Model.Page, (Model.Total + SmartFarm.Web.ViewModels.Support.AdminSupportListPage.PageSize - 1) / SmartFarm.Web.ViewModels.Support.AdminSupportListPage.PageSize]</span>
            @if (Model.HasNext) { <a asp-area="Admin" asp-controller="Support" asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-priority="@Model.Priority" asp-route-page="@(Model.Page + 1)">@T["Next"]</a> }
        </nav>
    }
</section>
