@model SmartFarm.Web.ViewModels.Auth.LoginInput
@{
    ViewData["Title"] = "Log in";
}
<section class="panel narrow">
    <h1>Log in</h1>
    @if (TempData["Message"] is string message) { <p role="status">@message</p> }
    <form method="post" asp-action="Login" asp-controller="Account" asp-route-returnUrl="@ViewData["ReturnUrl"]">
        <label asp-for="Email"></label>
        <input asp-for="Email" autocomplete="username" /><span asp-validation-for="Email" class="error"></span>
        <label asp-for="Password"></label>
        <input asp-for="Password" type="password" autocomplete="current-password" /><span asp-validation-for="Password" class="error"></span>
        <label class="check"><input asp-for="RememberMe" /> Remember me</label>
        <button type="submit">Log in</button>
    </form>
    <p>No account yet? <a asp-controller="Account" asp-action="Register">Register</a>.</p>
</section>

