@model SmartFarm.Web.ViewModels.Admin.AdminFarmIndexPage
@{
    ViewData["Title"] = T["Farms"];
}
<div class="page-heading admin-page-heading">
    <div><p class="sf-kicker">@T["PLATFORM DIRECTORY"]</p><h1>@T["Farms"]</h1>
        <p class="sf-muted">@T["Review farms across the platform without entering their private workspace."]</p></div>
</div>
<section class="panel admin-directory-panel" aria-label="@T["Farm directory"]">
    <form class="admin-filters" method="get" asp-area="Admin" asp-controller="Farms" asp-action="Index">
        <div class="admin-filter-search">
            <label for="admin-farm-search">@T["Find a farm"]</label>
            <input id="admin-farm-search" name="search" type="search" value="@Model.Search" maxlength="100"
                   placeholder="@T["Search farm or location"]" />
        </div>
        <div>
            <label for="admin-farm-status">@T["Farm status"]</label>
            <select id="admin-farm-status" name="status">
                <option value="all" selected="@(Model.Status == "all")">@T["All farms"]</option>
                <option value="active" selected="@(Model.Status == "active")">@T["Active"]</option>
                <option value="archived" selected="@(Model.Status == "archived")">@T["Archived"]</option>
            </select>
        </div>
        <button type="submit">@T["Search"]</button>
        <a class="admin-reset" asp-area="Admin" asp-controller="Farms" asp-action="Index">@T["Clear"]</a>
    </form>
    <p class="admin-results-count">@T["{0} {1} found", Model.TotalCount, Model.TotalCount == 1 ? "farm" : "farms"]</p>
    @if (Model.Farms.Count == 0)
    {
        <div class="admin-empty"><strong>@T["No matching farms"]</strong><p>@T["Try a different name, location or status."]</p></div>
    }
    else
    {
        <div class="admin-record-list">
            @foreach (var farm in Model.Farms)
            {
                <a class="admin-record" asp-area="Admin" asp-controller="Farms" asp-action="Details" asp-route-id="@farm.Id">
                    <span class="admin-record-main"><strong>@farm.Name</strong><small>@T["{0} · Owned by {1}", farm.Location, farm.OwnerName]</small>
                        <small>@T["{0} plots · {1} members", farm.Plots, farm.Members]</small></span>
                    <span class="sf-status-chip @(farm.Archived ? "sf-status-chip--neutral" : "sf-status-chip--active")">@(farm.Archived ? "Archived" : "Active")</span>
                </a>
            }
        </div>
        <nav class="admin-pagination" aria-label="@T["Farm pages"]">
            @if (Model.HasPrevious)
            {
                <a asp-area="Admin" asp-controller="Farms" asp-action="Index" asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status" asp-route-page="@(Model.Page - 1)">@T["Previous"]</a>
            }
            <span>@T["Page {0} of {1}", Model.Page, (Model.TotalCount + SmartFarm.Web.ViewModels.Admin.AdminFarmIndexPage.PageSize - 1) / SmartFarm.Web.ViewModels.Admin.AdminFarmIndexPage.PageSize]</span>
            @if (Model.HasNext)
            {
                <a asp-area="Admin" asp-controller="Farms" asp-action="Index" asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status" asp-route-page="@(Model.Page + 1)">@T["Next"]</a>
            }
        </nav>
    }
</section>
