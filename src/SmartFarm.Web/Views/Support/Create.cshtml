@model SmartFarm.Web.ViewModels.Support.SupportCreatePage
@{
    ViewData["Title"] = "New support request";
}
<a class="admin-back" asp-area="" asp-controller="Support" asp-action="Index">← Back to support</a>
<div class="page-heading admin-page-heading"><div><p class="sf-kicker">HELP &amp; SUPPORT</p><h1>What do you need help with?</h1>
    <p class="sf-muted">Describe the problem. Please don't include passwords, farm codes, or private tokens.</p></div></div>
<section class="panel admin-support-form-panel">
    <form asp-area="" asp-controller="Support" asp-action="Create" method="post" class="admin-action-form">
        <div asp-validation-summary="ModelOnly" class="error" role="alert"></div>
        <label asp-for="Input.Category">Issue category</label>
        <select asp-for="Input.Category">
            <option value="Account">Account or sign-in</option>
            <option value="Farm">Farm management</option>
            <option value="Mobile">Mobile app or offline sync</option>
            <option value="Other">Something else</option>
        </select>
        <label asp-for="Input.FarmId">Related farm (optional)</label>
        <select asp-for="Input.FarmId">
            <option value="">Not related to one farm</option>
            @foreach (var farm in Model.Farms) { <option value="@farm.Id">@farm.Name</option> }
        </select>
        <span asp-validation-for="Input.FarmId" class="error"></span>
        <label asp-for="Input.Title">Short title</label>
        <input asp-for="Input.Title" maxlength="140" minlength="5" placeholder="e.g., Cannot sync field observations" required />
        <span asp-validation-for="Input.Title" class="error"></span>
        <label asp-for="Input.Description">Describe the issue</label>
        <textarea asp-for="Input.Description" minlength="15" maxlength="2000" rows="7" required
                  placeholder="What happened, where did it happen, and what did you try?"></textarea>
        <span asp-validation-for="Input.Description" class="error"></span>
        <button type="submit">Submit request</button>
    </form>
</section>
