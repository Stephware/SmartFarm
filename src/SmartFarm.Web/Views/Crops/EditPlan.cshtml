@model SmartFarm.Web.ViewModels.Crops.CropPlanEditViewModel
@{
    ViewData["Title"] = T["Edit planting plan"];
}
<div class="reference-screen reference-screen-crops ani12d-edit-plan">
<section class="panel card sf-edit-form-panel ani12d-edit-form">

    <partial name="_UiPageHeader" model='@(new UiPageHeader(T["Edit planting plan"], T["Update {0} on {1}. Saved crop history is retained.", Model.Cycle.CropTypeName, Model.Cycle.PlotName], BackText: T["Back to crops"], BackUrl: Url.Action("Index", "Crops", new { farmId = Model.Farm.Id }) + "#crop-cycle-" + Model.Cycle.Id))' />
    <div asp-validation-summary="ModelOnly" class="error" role="alert"></div>
    <form class="sf-crop-form ani12d-edit-fields ani-p5-form" data-ani-p5-form asp-action="EditPlan" asp-route-farmId="@Model.Farm.Id"
          asp-route-cycleId="@Model.Cycle.Id" method="post">
        <input type="hidden" asp-for="Input.RowVersion" />
        <h2>@T["Crop and dates"]</h2>
        <label asp-for="Input.CropTypeId">@T["Crop type"]</label>
        <select asp-for="Input.CropTypeId">
            @foreach (var type in Model.CropTypes)
            {
                <option value="@type.Id">@type.Name</option>
            }
        </select>
        <label asp-for="Input.PlannedPlantingDate">@T["Planned planting date"]</label>
        <input asp-for="Input.PlannedPlantingDate" type="date" data-ani-p5-start-date required />
        <label asp-for="Input.ExpectedHarvestDate">@T["Expected harvest (optional)"]</label>
        <input asp-for="Input.ExpectedHarvestDate" type="date" data-ani-p5-end-date aria-describedby="ani-p5-plan-date-error" />
        <p class="error" id="ani-p5-plan-date-error" data-ani-p5-date-error role="status" hidden></p>
        <details class="sf-edit-disclosure ani-p5-optional" open="@(!ViewData.ModelState.IsValid ? "open" : null)">
            <summary>@T["Optional harvest and watering settings"]</summary>
            <p class="sf-muted">@T["Change these only if the crop's unit or watering schedule needs adjusting."]</p>
            <label asp-for="Input.HarvestUnit">@T["Harvest unit"]</label>
            <input asp-for="Input.HarvestUnit" maxlength="20" />
            <label asp-for="Input.WateringIntervalDays">@T["Watering interval days"]</label>
            <input asp-for="Input.WateringIntervalDays" type="number" min="1" max="32767" />
        </details>
        <div class="ani12d-form-actions"><button type="submit">@T["Save changes"]</button>
        <a class="sf-button-outline" asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-fragment="@("crop-cycle-" + Model.Cycle.Id)">@T["Cancel"]</a></div>
    </form>
</section>


</div>
