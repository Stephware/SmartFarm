@{
    ViewData["Title"] = T["Farm data unavailable"];
}
<section class="panel" role="alert">
    <h1>@T["Farm data is temporarily unavailable"]</h1>
    @if (ViewData["WriteUnconfirmed"] is true)
    {
        <p>@T["We could not confirm whether your change was saved. Review your farm records before submitting it again."]</p>
    }
    else
    {
        <p>@T["We could not load this page. Try again, or return to your farms and check your connection."]</p>
    }
    <div class="action-links">
        @if (ViewData["RetryUrl"] is string retryUrl)
        {
            <a class="button" href="@retryUrl">@T["Try again"]</a>
        }
        <a asp-controller="Farms" asp-action="Index">@T["Review my farms"]</a>
        <a asp-controller="Home" asp-action="Index">@T["Back to home"]</a>
    </div>
</section>
