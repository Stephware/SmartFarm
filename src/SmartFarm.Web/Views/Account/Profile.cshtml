@model SmartFarm.Infrastructure.Identity.SmartFarmUser
@{
    ViewData["Title"] = "My account";
    var initial = string.IsNullOrWhiteSpace(Model.FullName)
        ? "A" : Model.FullName.Trim()[0].ToString().ToUpperInvariant();
}
<section class="panel sf-account-hero ani-account-hero" aria-labelledby="account-heading">

    <h1 id="account-heading">My account</h1>
    <p class="sf-muted">Your AniGo account details and quick links to your farm workspace.</p>
    <div class="sf-account-identity">
        <span class="sf-account-avatar ani-account-avatar" aria-hidden="true">@initial</span>
        <div>
            <h2>@Model.FullName</h2>
            <p>@Model.Email</p>
        </div>
    </div>
</section>
<section class="panel sf-account-details" aria-labelledby="account-details-heading">
    <h2 id="account-details-heading">Account information</h2>
    <dl>
        <div><dt>Name</dt><dd>@Model.FullName</dd></div>
        <div><dt>Email</dt><dd>@Model.Email</dd></div>
    </dl>
    <p class="hint">Farm membership and permissions are managed within each farm. Account information is shown for reference; this page does not change your sign-in details.</p>
</section>
<section class="panel sf-account-links" aria-labelledby="account-links-heading">
    <h2 id="account-links-heading">Your workspace</h2>
    <div class="sf-account-link-grid">
        <a asp-controller="Farms" asp-action="Index"><strong>My farms</strong><span>Open your farms or request access →</span></a>
        <a asp-controller="Notifications" asp-action="Index"><strong>Notifications</strong><span>Read farm reminders and advisories →</span></a>
        <a asp-controller="Home" asp-action="Index"><strong>About AniGo</strong><span>Review the farm management tools →</span></a>
    </div>
</section>

<section class="panel appearance-setting" aria-labelledby="appearance-heading">
    <div><h2 id="appearance-heading">Appearance</h2><p>Light is the default. Your choice is saved on this browser.</p></div>
    <button type="button" data-color-mode-toggle aria-pressed="false" aria-label="Use dark appearance"><span data-color-mode-status>Light appearance</span><partial name="_Icon" model='@("sun")' /></button>
</section>
