@model SmartFarm.Web.ViewModels.Farms.FarmEditViewModel
@{
    ViewData["Title"] = "Edit farm";
}
<section class="panel narrow">
    <h1>Edit farm</h1>
    <form asp-action="Edit" asp-route-id="@Model.FarmId" method="post">
        <div asp-validation-summary="All" class="error"></div>
        <input asp-for="Input.RowVersion" type="hidden" />
        <label asp-for="Input.Name">Farm name</label><input asp-for="Input.Name" required />
        <label asp-for="Input.LocationText">Location</label><input asp-for="Input.LocationText" required />
        <label asp-for="Input.TimeZoneId">Time zone</label><input asp-for="Input.TimeZoneId" required />
        <label asp-for="Input.Latitude"></label><input asp-for="Input.Latitude" type="number" step="0.000001" />
        <label asp-for="Input.Longitude"></label><input asp-for="Input.Longitude" type="number" step="0.000001" />
        <button type="submit">Save changes</button>
        <a asp-action="Details" asp-route-id="@Model.FarmId">Cancel</a>
    </form>
</section>

