@model SmartFarm.Web.ViewModels.Farms.FarmWorkspaceViewModel
@{
    ViewData["Title"] = Model.Farm.Name;
    var canManage = Model.Farm.Role == "Owner" || Model.Farm.Role == "Manager";
    var isOwner = Model.Farm.Role == "Owner";
}
<partial name="_FarmNavigation" model="Model.Farm.Id" />
<section class="panel">
    <p><a asp-action="Index">← My farms</a></p>
    <h1>@Model.Farm.Name</h1>
    <p>@Model.Farm.LocationText · @Model.Farm.Role</p>
    @if (TempData["Message"] is string message) { <p role="status">@message</p> }
    @if (TempData["Error"] is string error) { <p class="error" role="alert">@error</p> }
    @if (canManage)
    {
        <a asp-action="Edit" asp-route-id="@Model.Farm.Id">Edit farm</a>
    }
    @if (isOwner)
    {
        <form asp-action="Archive" asp-route-id="@Model.Farm.Id" method="post" class="inline" data-confirm="Archive @Model.Farm.Name? Its plots and records will no longer appear in active farms.">
            <input type="hidden" name="rowVersion" value="@Model.Farm.RowVersion" />
            <button class="button-danger" type="submit">Archive farm</button>
        </form>
    }
</section>
<section class="panel">
    <h2>Plots</h2>
    <p><a asp-controller="PlotLayout" asp-action="Index" asp-route-farmId="@Model.Farm.Id">View schematic plot layout →</a></p>
    @if (Model.Plots.Count == 0) { <p>No active plots.</p> }
    else
    {
        <ul class="farm-list">
        @foreach (var plot in Model.Plots)
        {
            <li>
                <strong>@plot.Name</strong> — @plot.AreaSqMeters m²
                @if (canManage)
                {
                    <a asp-action="EditPlot" asp-route-id="@Model.Farm.Id" asp-route-plotId="@plot.Id">Edit</a>
                    <form asp-action="ArchivePlot" asp-route-id="@Model.Farm.Id" asp-route-plotId="@plot.Id" method="post" class="inline" data-confirm="Archive @plot.Name? Its history will be retained.">
                        <input type="hidden" name="rowVersion" value="@plot.RowVersion" />
                        <button class="button-danger" type="submit">Archive</button>
                    </form>
                }
            </li>
        }
        </ul>
    }
    @if (canManage)
    {
        <h3>Add plot</h3>
        <form asp-action="CreatePlot" asp-route-id="@Model.Farm.Id" method="post" class="narrow">
            <label for="plotName">Name</label><input id="plotName" name="Name" required maxlength="100" minlength="2" />
            <label for="plotArea">Area (m²)</label><input id="plotArea" name="AreaSqMeters" type="number" min="0.01" step="0.01" required />
            <button type="submit">Add plot</button>
        </form>
    }
</section>
<section class="panel">
    <h2>Members</h2>
    <ul class="farm-list">
        <li>Owner — the account that created this farm</li>
        @foreach (var member in Model.Members)
        {
            <li>
                <strong>@member.FullName</strong> — @member.Role
                @if (isOwner)
                {
                    <form asp-action="ChangeRole" asp-route-id="@Model.Farm.Id" asp-route-memberId="@member.Id" method="post" class="inline" data-confirm="Change the role for @member.FullName? Their available farm actions will change.">
                        <label class="visually-hidden" for="role-@member.Id">Role for @member.FullName</label>
                        <select id="role-@member.Id" name="Role">
                            @if (member.Role == "Manager")
                            {
                                <option value="1" selected>Manager</option>
                                <option value="2">Field Worker</option>
                            }
                            else
                            {
                                <option value="1">Manager</option>
                                <option value="2" selected>Field Worker</option>
                            }
                        </select>
                        <button type="submit">Update role</button>
                    </form>
                    <form asp-action="RemoveMember" asp-route-id="@Model.Farm.Id" asp-route-memberId="@member.Id" method="post" class="inline" data-confirm="Remove @member.FullName from @Model.Farm.Name? They will lose access.">
                        <button class="button-danger" type="submit">Remove</button>
                    </form>
                }
            </li>
        }
    </ul>

</section>




@if (Model.Enrollment is not null)
{
    <partial name="_FarmEnrollment" model="Model.Enrollment" />
}
