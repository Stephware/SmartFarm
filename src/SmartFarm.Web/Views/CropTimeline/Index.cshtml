@model SmartFarm.Web.ViewModels.Monitoring.CropTimelinePage
@{
    ViewData["Title"] = "Crop timeline";
    var cycle = Model.Cycle;
}
<div class="reference-screen reference-screen-croptimeline">
<partial name="_FarmNavigation" model="cycle.FarmId" />
<section class="panel card sf-timeline-hero">
    <p><a asp-controller="Crops" asp-action="Index" asp-route-farmId="@cycle.FarmId">← Crop management</a></p>

    <div class="sf-page-header page-hero">
        <div>
            <h1>@cycle.CropTypeName · @cycle.PlotName</h1>
            <p>Crop timeline · <span class="sf-status-chip sf-status-chip--neutral">@cycle.StatusName</span></p>
        </div>
    </div>
    <p class="hint">Activity and photo timestamps are shown in @Model.TimeZoneId. Scheduled dates are plans, not proof that work was completed.</p>
    <div class="action-links">
        <a asp-controller="Monitoring" asp-action="Index" asp-route-farmId="@cycle.FarmId"
           asp-route-cycleId="@cycle.Id">Record an activity or inspection</a>
        <a asp-controller="Harvests" asp-action="Index" asp-route-farmId="@cycle.FarmId"
           asp-route-cycleId="@cycle.Id">Harvests</a>
    </div>
</section>
<partial name="~/Views/Crops/_CropHistory.cshtml" model="Model" />

</div>
