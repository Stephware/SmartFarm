@model SmartFarm.Core.Contracts.Farms.InvitationAcceptance
@{
    ViewData["Title"] = "Accept invitation";
}
<section class="panel narrow">
    <h1>Accept farm invitation</h1>
    <p>Accept only if you recognize the person who invited you to SmartFarm.</p>
    <form asp-action="AcceptInvitation" method="post">
        <div asp-validation-summary="All" class="error"></div>
        <input asp-for="Token" type="hidden" />
        <button type="submit">Accept invitation</button>
    </form>
</section>

