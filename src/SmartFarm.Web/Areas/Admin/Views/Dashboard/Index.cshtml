@model SmartFarm.Web.ViewModels.Admin.AdminOverviewPage
@{
    ViewData["Title"] = "Platform overview";
}
<div class="page-heading admin-page-heading">
    <div>
        <p class="sf-kicker">ANIGO PLATFORM</p>
        <h1>Platform overview</h1>
        <p class="sf-muted">A simple view of your registered users and farms. Farm-level roles stay separate.</p>
    </div>
</div>
<section class="admin-stats" aria-label="Platform totals">
    <a class="admin-stat panel" asp-area="Admin" asp-controller="Users" asp-action="Index">
        <span>Registered users</span><strong>@Model.TotalUsers</strong><small>@Model.ActiveUsers active</small>
    </a>
    <a class="admin-stat panel" asp-area="Admin" asp-controller="Users" asp-action="Index" asp-route-status="disabled">
        <span>Disabled accounts</span><strong>@Model.DisabledUsers</strong><small>Review accounts</small>
    </a>
    <a class="admin-stat panel" asp-area="Admin" asp-controller="Farms" asp-action="Index" asp-route-status="active">
        <span>Active farms</span><strong>@Model.ActiveFarms</strong><small>@Model.TotalFarms total registered</small>
    </a>
    <a class="admin-stat panel" asp-area="Admin" asp-controller="Farms" asp-action="Index" asp-route-status="archived">
        <span>Archived farms</span><strong>@Model.ArchivedFarms</strong><small>View archived farms</small>
    </a>
    <div class="admin-stat panel"><span>Active plots</span><strong>@Model.ActivePlots</strong><small>Across the platform</small></div>
    <a class="admin-stat panel" asp-area="Admin" asp-controller="Support" asp-action="Index">
        <span>Unresolved support</span><strong>@Model.PendingSupport</strong><small>Open or in progress</small>
    </a>
</section>
<section class="panel admin-directory-panel" aria-labelledby="recent-farms-heading">
    <div class="admin-section-heading">
        <div>
            <h2 id="recent-farms-heading">Recently registered farms</h2>
            <p class="sf-muted">Open a farm to view its owner, plots, members, and status.</p>
        </div>
        <a class="button admin-button-secondary" asp-area="Admin" asp-controller="Farms" asp-action="Index">View all farms</a>
    </div>
    @if (Model.RecentFarms.Count == 0)
    {
        <p class="admin-empty">No farms registered yet.</p>
    }
    else
    {
        <div class="admin-record-list">
            @foreach (var farm in Model.RecentFarms)
            {
                <a class="admin-record" asp-area="Admin" asp-controller="Farms" asp-action="Details" asp-route-id="@farm.Id">
                    <span class="admin-record-main"><strong>@farm.Name</strong><small>@farm.Location · @farm.OwnerName</small></span>
                    <span class="sf-status-chip @(farm.Archived ? "sf-status-chip--neutral" : "sf-status-chip--active")">@(farm.Archived ? "Archived" : "Active")</span>
                </a>
            }
        </div>
    }
</section>
<div class="admin-shortcuts">
    <a class="panel admin-shortcut" asp-area="Admin" asp-controller="Users" asp-action="Index">
        <strong>Manage users</strong><span>Search accounts and review access status.</span>
    </a>
    <a class="panel admin-shortcut" asp-area="Admin" asp-controller="Support" asp-action="Index">
        <strong>Support cases</strong><span>Review requests, respond and track resolutions.</span>
    </a>
    <a class="panel admin-shortcut" asp-area="Admin" asp-controller="Monitoring" asp-action="Index">
        <strong>System monitoring</strong><span>Check service status, failed jobs, and sync receipts.</span>
    </a>
    <a class="panel admin-shortcut" asp-area="Admin" asp-controller="Farms" asp-action="Index">
        <strong>Manage farms</strong><span>Find farms and review archive status.</span>
    </a>
</div>
