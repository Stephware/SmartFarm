@model SmartFarm.Web.ViewModels.Farms.FarmIndexViewModel
@{
    ViewData["Title"] = "My farms";
}
<div class="reference-screen reference-screen-farms ani-entry-farms-page">
<header class="ani-entry-farms-heading">
    <div>
        <p class="ani-entry-eyebrow">YOUR WORKSPACE</p>
        <h1>My farms</h1>
        <p class="sf-muted">Open a farm below, create your own, or enter a code to join your team.</p>
    </div>
    <a class="button" asp-controller="Farms" asp-action="Create">Create farm</a>
</header>

@if (TempData["Message"] is string message) { <p class="form-notice" role="status">@message</p> }
@if (TempData["Error"] is string error) { <p class="error form-error" role="alert">@error</p> }

<section class="farm-library" aria-label="Your available farms">
    @if (Model.Farms.Count == 0)
    {
        <div class="ani-onboarding-empty panel ani-entry-empty-farms" aria-labelledby="first-farm-heading">
            <p class="ani-overline">Welcome to your workspace</p>
            <h2 id="first-farm-heading">No farms yet</h2>
            <p>Choose what you'd like to do first. Your account can belong to more than one farm.</p>
            <div class="ani-first-actions ani-entry-first-actions">
                <div>
                    <h3>Manage your own farm</h3>
                    <p>Start by giving your farm a name and location. You can add plots and crops next.</p>
                    <a class="button" asp-controller="Farms" asp-action="Create">Create my first farm</a>
                </div>
                <div>
                    <h3>Join an existing farm</h3>
                    <p>Ask the owner for a farm code, enter it below, and wait for their approval.</p>
                    <a class="sf-button-outline" href="#join-farm">I have a farm code</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <h2 class="ani-entry-farm-section-label">Your farms</h2>
        <ul class="farm-select-grid responsive-two ani-entry-farm-list">
            @foreach (var farm in Model.Farms)
            {
                <li class="farm-select-card card ani-entry-farm-card">
                    <div class="farm-card-body card-body">
                        <div class="ani-entry-farm-identity">
                            <span class="ani-entry-farm-mark" aria-hidden="true">Farm</span>
                            <span class="farm-role-badge">@farm.Role</span>
                        </div>
                        <h2><a asp-action="Details" asp-route-id="@farm.Id">@farm.Name</a></h2>
                        <p class="sf-muted">@farm.LocationText</p>
                        <div class="farm-card-actions">
                            <a class="button" asp-controller="Dashboard" asp-action="Index" asp-route-farmId="@farm.Id">Open dashboard</a>
                            <a class="farm-text-link" asp-controller="Reports" asp-action="Harvests" asp-route-farmId="@farm.Id">Harvest reports</a>
                        </div>
                    </div>
                </li>
            }
        </ul>
    }
</section>

<div class="farm-onboarding-grid ani-entry-join-layout @(Model.JoinRequests.Count == 0 && Model.RequestError is null ? "farm-onboarding-grid--single ani-entry-join-layout--single" : "")">
    <section class="panel card join-farm-panel" id="join-farm" aria-labelledby="join-farm-heading">

        <header class="reference-panel-heading">
            <h2 id="join-farm-heading">Join an existing farm</h2>
            <span class="ani-optional-label">For team members</span>
        </header>
        <p class="sf-muted">Have a farm code? Enter the code supplied by the owner. Access begins after the owner approves your request.</p>
        <p class="ani-inline-help">No code yet? Ask your farm owner to share their 12-character code.</p>
        <form asp-action="RequestJoin" method="post" class="join-farm-form">
            <label for="FarmCode">Farm code</label>
            <input id="FarmCode" name="FarmCode" value="@Model.Join.FarmCode" required maxlength="64"
                   autocomplete="off" autocapitalize="characters" spellcheck="false" inputmode="text"
                   aria-describedby="join-code-help" placeholder="12-character farm code" />
            <p class="hint" id="join-code-help">Submitting a code sends a request; it does not give immediate access.</p>
            @Html.ValidationMessage("FarmCode", null, new { @class = "error" })
            <button type="submit">Request to join</button>
        </form>
    </section>
    @if (Model.RequestError is not null || Model.JoinRequests.Count > 0)
    {
    <section class="panel card join-requests-panel" aria-labelledby="requests-heading">

        <header class="reference-panel-heading"><h2 id="requests-heading">Your join requests</h2></header>
        @if (Model.RequestError is not null)
        {
            <p role="alert" class="error">@Model.RequestError</p>
        }
        else if (Model.JoinRequests.Count == 0)
        {
            <div class="requests-empty">
                <p class="sf-muted">You haven't requested access to any farms yet.</p>
            </div>
        }
        else
        {
            <ul class="join-requests-list">
                @foreach (var request in Model.JoinRequests)
                {
                    var statusClass = request.Status == "Pending" ? "sf-status-chip--planned" :
                        request.Status == "Approved" ? "sf-status-chip--active" : "sf-status-chip--neutral";
                    <li>
                        <div class="request-title-row">
                            <strong>@request.FarmName</strong>
                            <partial name="_UiStatusChip" model='@(new UiStatusChip(request.Status, statusClass))' />
                        </div>
                        <p class="sf-muted request-date">Requested @request.RequestedAtUtc.ToString("MMM d, yyyy HH:mm") UTC</p>
                        @if (request.ReviewedAtUtc is { } reviewed)
                        {
                            <p class="sf-muted request-date">Updated @reviewed.ToString("MMM d, yyyy HH:mm") UTC</p>
                        }
                        @if (request.Status == "Pending")
                        {
                            <p class="sf-muted">Waiting for the farm owner's approval.</p>
                            <form asp-action="CancelJoin" asp-route-farmId="@request.FarmId" asp-route-requestId="@request.Id"
                                  method="post" data-confirm="Cancel your request to join @request.FarmName?">
                                <button class="button-danger" type="submit">Cancel request</button>
                            </form>
                        }
                        @if (request.Status is "Rejected" or "Canceled")
                        {
                            <p class="sf-muted">You can apply again with a valid farm code.</p>
                        }
                    </li>
                }
            </ul>
        }
    </section>
    }
</div>

</div>
