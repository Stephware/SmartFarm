@{
    ViewData["Title"] = "Farm data unavailable";
}
<section class="panel" role="alert">
    <h1>Farm data is temporarily unavailable</h1>
    @if (ViewData["WriteUnconfirmed"] is true)
    {
        <p>We could not confirm whether your change was saved. Review your farm records before submitting it again.</p>
    }
    else
    {
        <p>We could not load this page. Try again, or return to your farms and check your connection.</p>
    }
    <div class="action-links">
        @if (ViewData["RetryUrl"] is string retryUrl)
        {
            <a class="button" href="@retryUrl">Try again</a>
        }
        <a asp-controller="Farms" asp-action="Index">Review my farms</a>
        <a asp-controller="Home" asp-action="Index">Back to home</a>
    </div>
</section>
