@using SmartFarm.Core.Enums
@model SmartFarm.Core.Contracts.Weather.WeatherOverview
@{
    ViewData["Title"] = "Farm weather";
    // Saved weather updates are normally checked every six hours. Two missed updates warrant a warning.
    var nowUtc = DateTime.UtcNow;
    var stale = Model.Days.Any(day => day.RetrievedAtUtc < nowUtc.AddHours(-12)
        || day.RetrievedAtUtc > nowUtc.AddMinutes(5));
    var activeAdvisories = Model.Advisories.Where(a => a.Status == 0).ToList();
    DateOnly? farmToday = null;
    try
    {
        farmToday = DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow,
            TimeZoneInfo.FindSystemTimeZoneById(Model.TimeZoneId)));
    }
    catch (Exception error) when (error is TimeZoneNotFoundException or InvalidTimeZoneException) { }
    var forecast = Model.Days.OrderBy(d => d.Date).ToList();
    var next = farmToday is { } today
        ? forecast.FirstOrDefault(d => d.Date >= today)
        : forecast.FirstOrDefault();
}
<partial name="_FarmNavigation" model="Model.FarmId" />
<section class="panel sf-weather-hero ani-weather-hero" aria-labelledby="weather-heading">
    <div class="sf-page-header">
        <div>
            <p><a asp-controller="Farms" asp-action="Details" asp-route-id="@Model.FarmId">← Back to farm</a></p>
            <p class="sf-kicker">FARM CONDITIONS</p>
            <h1 id="weather-heading">Farm weather</h1>
            <p class="sf-muted">Forecast dates use @Model.TimeZoneId. This page displays saved forecasts, not live observations.</p>
            <nav class="ani-insight-links" aria-label="Weather page sections">
                <a href="#saved-forecast">Saved forecast</a>
                <a href="#weather-alerts-heading">Advisories (@activeAdvisories.Count)</a>
            </nav>
        </div>
        <span class="sf-status-chip @(stale ? "sf-status-chip--warning" : "sf-status-chip--neutral")">
            @(Model.Days.Count == 0 ? "No saved forecast" : stale ? "Update overdue" : "Saved forecast")
        </span>
    </div>
    @if (!Model.HasCoordinates)
    {
        <div class="sf-empty-state">
            <h2>Weather is not enabled for this farm</h2>
            <p>An owner or manager must add its latitude and longitude in Edit farm.</p>
            <a asp-controller="Farms" asp-action="Details" asp-route-id="@Model.FarmId">Return to farm overview →</a>
        </div>
    }
    else if (Model.Days.Count == 0)
    {
        <div class="sf-empty-state">
            <h2>No recent forecast is available</h2>
            <p>Try again later, or ask your farm manager to check the weather settings.</p>
        </div>
    }
    else
    {
        @if (stale)
        {
            <div class="sf-weather-stale" role="alert">
                <strong>Weather data may be out of date.</strong>
                <p>Weather data is over 12 hours old or has an invalid update time. Conditions and advisories may have changed. Check a current weather source.</p>
            </div>
        }
        <div class="ani-weather-summary" aria-label="Saved forecast overview">
            <div><span>Next available day</span><strong>@(next?.Date.ToString("ddd, MMM d") ?? "—")</strong>
                <small>@(next is null ? "No upcoming forecast" : "Saved daily forecast")</small></div>
            <div><span>Rain chance</span><strong>@(next?.MaxPrecipitationProbability?.ToString("0.#") ?? "—")%</strong><small>Forecast, not measured rainfall</small></div>
            <div><span>Saved advisories</span><strong>@activeAdvisories.Count</strong><small>Check current official warnings</small></div>
        </div>
        <h2 id="saved-forecast">Saved daily forecast</h2>
        <p class="sf-muted">Check times are displayed in UTC. Forecast dates follow your farm's time zone.</p>
        <ul class="sf-weather-grid ani-weather-days">
        @foreach (var day in forecast)
        {
            <li class="sf-weather-card @(next is not null && day.Date == next.Date ? "ani-weather-next" : "")">
                <div class="sf-weather-card-top">
                    <time datetime="@day.Date.ToString("yyyy-MM-dd")">@day.Date.ToString("ddd, MMM d")</time>
                    @if (next is not null && day.Date == next.Date)
                    {
                        <span class="ani-next-label">Next available</span>
                    }
                    <span>@day.Provider</span>
                </div>
                <div class="sf-weather-temps">
                    <strong>@(day.MinTemperatureC?.ToString("0.#") ?? "—")–@(day.MaxTemperatureC?.ToString("0.#") ?? "—") °C</strong>
                    <span>Forecast temperature range</span>
                </div>
                <dl class="sf-weather-facts">
                    <div><dt>Rainfall</dt><dd>@(day.RainfallMm?.ToString("0.#") ?? "—") mm</dd></div>
                    <div><dt>Rain chance</dt><dd>@(day.MaxPrecipitationProbability?.ToString("0.#") ?? "—")%</dd></div>
                    <div><dt>Max wind</dt><dd>@(day.MaxWindKph?.ToString("0.#") ?? "—") km/h</dd></div>
                </dl>
                <small>Checked @day.RetrievedAtUtc.ToString("MMM d, yyyy HH:mm") UTC</small>
            </li>
        }
        </ul>
    }
</section>
<section class="panel sf-weather-advisories ani-weather-advisories" aria-labelledby="weather-alerts-heading">
    <div class="sf-section-line">
        <div>
            <p class="sf-kicker">FARM AWARENESS</p>
            <h2 id="weather-alerts-heading">Weather advisories</h2>
        </div>
        <span class="sf-status-chip @(activeAdvisories.Count > 0 ? "sf-status-chip--warning" : "sf-status-chip--neutral")">
            @activeAdvisories.Count active
        </span>
    </div>
    @if (activeAdvisories.Count == 0)
    {
        <div class="sf-empty-state">
            <strong>No active warnings in the saved forecast.</strong>
            <p>This does not rule out current hazards. Check official local weather updates when conditions are uncertain.</p>
        </div>
    }
    else
    {
        <ul class="sf-weather-alert-list">
        @foreach (var advisory in activeAdvisories)
        {
            <li>
                <div class="sf-weather-alert-title">
                    <strong>@advisory.SeverityName @advisory.TypeName advisory</strong>
                    <time datetime="@advisory.Date.ToString("yyyy-MM-dd")">@advisory.Date.ToString("MMM d, yyyy")</time>
                </div>
                <p>@advisory.Message</p>
            </li>
        }
        </ul>
    }
</section>
