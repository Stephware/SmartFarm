@model SmartFarm.Web.ViewModels.Auth.LoginInput
@{
    ViewData["Title"] = "Log in";
}
<div class="auth-layout ani-entry-auth-layout">
    <aside class="auth-intro ani-entry-auth-visual">
        <img class="ani-entry-auth-photo" src="~/images/photography/fields-detail.webp"
             alt="" width="1000" height="760" loading="lazy" decoding="async" />
        <div class="ani-entry-auth-visual-content">
            <span class="ani-entry-auth-kicker">ANI GO / YOUR FARM WORKSPACE</span>
            <h2>Good farm management starts with a clear view.</h2>
            <p>Pick up where you left off. Your farms, today's work, and saved crop records are ready when you are.</p>
            <span class="ani-entry-auth-caption">Agricultural photography for illustration only</span>
        </div>
    </aside>
    <section class="panel auth-card ani-entry-auth-card" aria-labelledby="login-heading">
        <div class="auth-heading">
            <p class="ani-entry-eyebrow">WELCOME BACK</p>
            <h1 id="login-heading">Log in to AniGo</h1>
            <p>Enter your account details to open your farms and today's work.</p>
        </div>
        @if (TempData["Message"] is string message) { <p class="form-notice" role="status">@message</p> }
        <form method="post" asp-action="Login" asp-controller="Account"
              asp-route-returnUrl="@ViewData["ReturnUrl"]" class="auth-form">
            <div class="form-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" autocomplete="username" inputmode="email"
                       autocapitalize="none" spellcheck="false" required placeholder="you@example.com" />
                <span asp-validation-for="Email" class="error"></span>
            </div>
            <div class="form-field">
                <label asp-for="Password"></label>
                <div class="ani-password-field">
                    <input asp-for="Password" type="password" autocomplete="current-password" required placeholder="Your password" />
                    <button type="button" class="ani-password-toggle" data-password-toggle
                            aria-controls="Password" aria-pressed="false">Show</button>
                </div>
                <span asp-validation-for="Password" class="error"></span>
            </div>
            <label class="check auth-remember"><input asp-for="RememberMe" /> Remember me</label>
            <button class="auth-submit" type="submit">Log in to my farms</button>
        </form>
        <p class="ani-auth-next-note"><strong>After signing in</strong>, you can open your farms, create one, or enter a farm code to request access.</p>
        <p class="auth-switch">New to AniGo? <a asp-controller="Account" asp-action="Register">Create an account</a>.</p>
    </section>
</div>
