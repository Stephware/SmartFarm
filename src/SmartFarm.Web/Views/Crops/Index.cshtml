@using SmartFarm.Core.Enums
@model SmartFarm.Web.ViewModels.Crops.CropWorkspaceViewModel
@{
    ViewData["Title"] = T["Crops & Calendar"];
    ViewData["FarmName"] = Model.Farm.Name;
    var canManage = Model.Farm.Role is "Owner" or "Manager";
    var currentCycles = Model.Cycles
        .Where(c => c.Status is CropCycleStatus.Active or CropCycleStatus.Planned)
        .OrderByDescending(c => c.Status == CropCycleStatus.Active)
        .ThenBy(c => c.ExpectedHarvestDate ?? DateOnly.MaxValue).ToList();
    var currentCrops = currentCycles.Take(6).ToList();
    var selectedPlot = Model.Plots.FirstOrDefault(p => p.Id == Model.PlanPlotId);
    var selectedPlotCycle = selectedPlot is null ? null :
        currentCycles.FirstOrDefault(c => c.PlotId == selectedPlot.Id);
    var finishedCycles = Model.Cycles.Count(c => c.Status is not (CropCycleStatus.Active or CropCycleStatus.Planned));
    var allCycleRecords = Model.Cycles
        .OrderBy(c => c.Status is CropCycleStatus.Active or CropCycleStatus.Planned ? 0 : 1)
        .ThenByDescending(c => c.PlantedDate ?? c.PlannedPlantingDate).ToList();
    const int cyclePageSize = 12;
    var cyclePageCount = Math.Max(1, (allCycleRecords.Count + cyclePageSize - 1) / cyclePageSize);
    Guid? focusedCycleId = Model.TransitionCycleId;
    if (focusedCycleId is null && Guid.TryParse(Context.Request.Query["cycleId"].ToString(), out var requestedCycleId))
        focusedCycleId = requestedCycleId;
    var matchingCycleIndex = focusedCycleId is { } focusedId
        ? allCycleRecords.FindIndex(c => c.Id == focusedId) : -1;
    var requestedCyclePage = int.TryParse(Context.Request.Query["page"].ToString(), out var parsedCyclePage)
        ? parsedCyclePage : matchingCycleIndex >= 0 ? matchingCycleIndex / cyclePageSize + 1 : 1;
    var currentCyclePage = Math.Clamp(requestedCyclePage, 1, cyclePageCount);
    var visibleCycles = allCycleRecords.Skip((currentCyclePage - 1) * cyclePageSize).Take(cyclePageSize).ToList();
}
<div class="reference-screen reference-screen-crops ani12d-crop-workspace ani-p2-page ani-p2-crops">
<partial name="_FarmNavigation" model="Model.Farm.Id" />
<section class="panel card sf-crop-hero ani12d-crop-hero ani-p2-hero">
    <p class="mvp-farm-context"><a asp-controller="Farms" asp-action="Details" asp-route-id="@Model.Farm.Id">@T["Farm:"] @Model.Farm.Name</a></p>

    <div class="sf-page-header page-hero">
        <div>
            <h1>@T["Crops & Calendar"]</h1>
            <p class="sf-muted">@(canManage ? T["See what is growing, plan the next planting, and review saved crop records."] : T["See what is growing and open saved crop records, inspections, and harvests."])</p>
        </div>
        <div class="hero-actions">
            @if (canManage) { <a class="button" href="#planting-plans-heading"><partial name="_Icon" model='@("plus")' />@T["Add crop plan"]</a> }
        </div>
    </div>
    <nav class="sf-page-jump-nav ani-crop-jump-nav ani12d-crop-tabs" aria-label="@T["Crop page sections"]">
        <a href="#ani-current-heading">@T["Current crops"]</a>
        @if (Model.Agenda is not null) { <a href="#crop-calendar-heading">@T["Calendar"]</a> }
        <a href="#farm-plots">@T["Plots"]</a>
    </nav>
    <p class="mvp-crop-counts">@currentCycles.Count(c => c.Status == CropCycleStatus.Active) growing · @currentCycles.Count(c => c.Status == CropCycleStatus.Planned) planned · @Model.Plots.Count plots</p>
    @if (selectedPlot is not null)
    {
        <div class="ani-selected-plot" role="status">
            <div>
                <strong>@T["Selected plot:"] @selectedPlot.Name</strong>
                <p>@(selectedPlotCycle is null ? T["Ready for a planting plan."] : selectedPlotCycle.Status == CropCycleStatus.Active
                    ? T["Currently growing "] + selectedPlotCycle.CropTypeName + T[". New plans are still allowed, but only one crop can be active at a time."]
                    : T["Has a planned crop: "] + selectedPlotCycle.CropTypeName + T[". Review existing plans before adding another."])</p>
            </div>
            <a href="#farm-plots">@T["All plots"]</a>
        </div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="error form-error" role="alert"></div>
    }
    @if (TempData["Error"] is string error) { <p class="error form-error" role="alert">@error</p> }
</section>


<section class="panel card ani-current-crops ani12d-current-crops" aria-labelledby="ani-current-heading">
    <div class="sf-section-line card-head">
        <div>

            <h2 id="ani-current-heading">@T["Currently growing & planned"]</h2>
            <p class="sf-muted">@T["These statuses come from saved crop records, not plant-health or maturity predictions."]</p>
        </div>
        <a href="#farm-plots">@T["See all plots →"]</a>
    </div>
    @if (currentCrops.Count == 0)
    {
        <div class="sf-empty-state">
            <strong>@T["No crops growing or planned yet"]</strong>
            <p>@(canManage ? Model.Plots.Count == 0 ? T["First add a plot, then return to plan what to plant."] : T["Create a planting plan to get started."] : T["Your farm owner or manager can create a planting plan for these plots."])</p>
            @if (canManage && Model.Plots.Count == 0)
            {
                <a asp-controller="Farms" asp-action="Details" asp-route-id="@Model.Farm.Id"
                   asp-fragment="add-plot">@T["Add a plot →"]</a>
            }
            else if (canManage)
            {
                <a href="#planting-plans-heading">@T["Create a planting plan →"]</a>
            }
        </div>
    }
    else
    {
        <div class="ani-current-grid crop-grid ani12d-current-grid">
        @foreach (var crop in currentCrops)
        {
            <a class="ani-current-card crop-card" asp-controller="Crops" asp-action="Index"
               asp-route-farmId="@Model.Farm.Id" asp-fragment="@("crop-cycle-" + crop.Id)">
                <div class="ani-current-copy crop-info">
                    <span class="sf-status-chip @(crop.Status == CropCycleStatus.Active ? "sf-status-chip--active" : "sf-status-chip--planned")">@crop.StatusName</span>
                    <strong>@crop.CropTypeName</strong>
                    <span>@crop.PlotName</span>
                    <small>@(crop.Status == CropCycleStatus.Active ? T["Planted"] : T["Planting planned"]) ·
                        @((crop.PlantedDate ?? crop.PlannedPlantingDate).ToString("MMM d, yyyy"))</small>
                    <span class="ani-crop-card-action">@T["View crop details"] <span aria-hidden="true">›</span></span>
                </div>
            </a>
        }
        </div>
        @if (currentCycles.Count > currentCrops.Count)
        {
            <p class="ani12d-more-crops"><a href="#crop-cycles-heading">@T["{0} {1} current crop records →", T["View all"], currentCycles.Count]</a></p>
        }
    }
</section>


<details class="mvp-workspace-details" open="@(Model.Plots.Count == 0)">
    <summary>@T["Plots ("]@Model.Plots.Count)</summary>
<section class="panel card mvp-plot-directory" id="farm-plots" aria-labelledby="farm-plots-heading">
    <header class="ui-section-heading">
        <div><h2 id="farm-plots-heading">@T["Plots"]</h2><p class="sf-muted">@T["Your named growing areas and their saved crop plans."]</p></div>
        @if (canManage) { <a class="sf-button-outline" asp-controller="Farms" asp-action="Details" asp-route-id="@Model.Farm.Id" asp-fragment="add-plot">@T["Add plot"]</a> }
    </header>
    @if (Model.Plots.Count == 0) { <p>@T["No plots yet. {0}", canManage ? "Add a growing area to plan your first crop." : "Your owner or manager can add growing areas."]</p> }
    else
    {
        <div class="table-scroll" tabindex="0" role="region" aria-label="@T["Farm plots and crop plans"]">
            <table class="data-table">
                <caption class="visually-hidden">@T["All active farm plots"]</caption>
                <thead><tr><th scope="col">@T["Plot"]</th><th scope="col">@T["Area"]</th><th scope="col">@T["Growing now"]</th><th scope="col">@T["Next planting"]</th></tr></thead>
                <tbody>
                @foreach (var plot in Model.Plots)
                {
                    var growing = Model.Cycles.FirstOrDefault(c => c.PlotId == plot.Id && c.Status == CropCycleStatus.Active);
                    var next = Model.Cycles.Where(c => c.PlotId == plot.Id && c.Status == CropCycleStatus.Planned).OrderBy(c => c.PlannedPlantingDate).FirstOrDefault();
                    <tr>
                        <th scope="row">@plot.Name
                            @if (canManage) { <a asp-controller="Farms" asp-action="EditPlot" asp-route-id="@Model.Farm.Id" asp-route-plotId="@plot.Id">@T["Edit plot"]</a> }
                        </th>
                        <td>@plot.AreaSqMeters.ToString("N2") m²</td>
                        <td>@if (growing is not null) { <a href="#crop-cycle-@growing.Id">@growing.CropTypeName</a> } else { <span>@T["Nothing active"]</span> }</td>
                        <td>@if (next is not null) { <a href="#crop-cycle-@next.Id">@next.CropTypeName · @next.PlannedPlantingDate.ToString("MMM d, yyyy")</a> } else { <span>@T["None planned"]</span> }
                            @if (canManage) { <a asp-controller="Crops" asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-plotId="@plot.Id" asp-fragment="planting-plans-heading">@T["Plan for this plot"]</a> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
</details>


@if (canManage)
{
<section id="planting-plans" data-form-dialog class="panel card sf-crop-plan ani-planting-panel ani12d-plan-panel" aria-labelledby="planting-plans-heading">
    <header class="reference-panel-heading">
        <div><h2 id="planting-plans-heading">@T["Plan a crop"]</h2>
        <p class="sf-muted">@T["Choose a growing plot, a crop, and a planting date. You can update planned crops before planting."]</p></div>
    </header>
    @if (canManage && Model.Plots.Count > 0 && Model.CropTypes.Count > 0)
    {
        <form class="sf-crop-form ani-planting-form ani12d-planting-form" asp-action="Plan" asp-route-farmId="@Model.Farm.Id" method="post">
            <div class="ani-plan-form-section">
                <div class="ani-plan-step"><span aria-hidden="true">1</span><strong>@T["Choose your field and crop"]</strong></div>
                <div class="ani-plan-form-grid">
                    <div class="ani-plan-field">
            <label for="plotId">@T["Plot"]</label>
            <select id="plotId" name="plotId" required aria-describedby="ani12d-plot-hint">
                <option value="" disabled selected="@(Model.PlanPlotId is null)">@T["Choose a plot"]</option>
                @foreach (var plot in Model.Plots)
                {
                    var current = currentCycles.FirstOrDefault(c => c.PlotId == plot.Id);
                    <option value="@plot.Id" selected="@(Model.PlanPlotId == plot.Id)">@plot.Name@(current is null ? " · Ready" : current.Status == CropCycleStatus.Active ? " · Growing " + current.CropTypeName : " · Planned " + current.CropTypeName)</option>
                }
            </select>
            <p class="hint" id="ani12d-plot-hint">@T["Plans can be prepared in advance, but only one crop may be actively growing on each plot."]</p>
                    </div>
                    <div class="ani-plan-field">
            <label asp-for="Plan.CropTypeId">@T["Crop"]</label>
            <select asp-for="Plan.CropTypeId" required>
                <option value="" disabled selected="@(Model.Plan.CropTypeId == Guid.Empty)">@T["Choose a crop"]</option>
                @foreach (var type in Model.CropTypes)
                {
                    <option value="@type.Id">@type.Name</option>
                }
            </select>
            <span asp-validation-for="Plan.CropTypeId" class="error"></span>
                    </div>
                </div>
            </div>
            <div class="ani-plan-form-section">
                <div class="ani-plan-step"><span aria-hidden="true">2</span><strong>@T["Set the dates"]</strong></div>
                <div class="ani-plan-form-grid">
                    <div class="ani-plan-field">
            <label asp-for="Plan.PlannedPlantingDate">@T["Planned planting"]</label>@Html.TextBox("Plan.PlannedPlantingDate", Model.Plan.PlannedPlantingDate == default ? null : Model.Plan.PlannedPlantingDate.ToString("yyyy-MM-dd"), new { type = "date", required = "required" })<span asp-validation-for="Plan.PlannedPlantingDate" class="error"></span>
                    </div>
                    <div class="ani-plan-field">
            <label asp-for="Plan.ExpectedHarvestDate">@T["Expected harvest (optional)"]</label><input asp-for="Plan.ExpectedHarvestDate" type="date" /><span asp-validation-for="Plan.ExpectedHarvestDate" class="error"></span>
                    </div>
                </div>
            </div>
            <details class="ani-plan-options ani12d-plan-options">
                <summary>@T["Optional harvest & watering settings"]</summary>
                <div class="ani-plan-form-grid">
                    <div class="ani-plan-field">
            <label asp-for="Plan.HarvestUnit">@T["Harvest unit (leave empty to use crop default)"]</label>
            <input asp-for="Plan.HarvestUnit" maxlength="20" /><span asp-validation-for="Plan.HarvestUnit" class="error"></span>
                    </div>
                    <div class="ani-plan-field">
            <label asp-for="Plan.WateringIntervalDays">@T["Watering interval days (leave empty for default)"]</label>
            <input asp-for="Plan.WateringIntervalDays" type="number" min="1" max="32767" /><span asp-validation-for="Plan.WateringIntervalDays" class="error"></span>
                    </div>
                </div>
            </details>
            <div class="ani-plan-actions"><button type="submit">@T["Save planting plan"]</button>
                <p>@T["After saving, open the crop record to mark it planted when planting actually happens."]</p>
            </div>
        </form>
    }
    else if (Model.Plots.Count == 0)
    {
        <div class="sf-empty-state"><strong>@T["Add a plot before planning crops."]</strong>
            <p>@T["Create your first growing area to continue."]</p>
            @if (canManage) { <a asp-controller="Farms" asp-action="Details" asp-route-id="@Model.Farm.Id" asp-fragment="add-plot">@T["Add first plot →"]</a> }
        </div>
    }
    else if (Model.CropTypes.Count == 0)
    {
        <div class="sf-empty-state"><strong>@T["Set up a crop type first."]</strong><p>@T["Choose a name and harvest unit in the crop tools below."]</p>
            @if (canManage) { <a href="#crop-types-heading">@T["Add crop type →"]</a> }
        </div>
    }
</section>
}

<details class="mvp-workspace-details" open="@(Model.TransitionCycleId is not null || Context.Request.Query.ContainsKey("page"))">
    <summary>@T["Crop records and status ("]@Model.Cycles.Count)</summary>
<section class="panel card sf-crop-cycles ani12d-crop-records" aria-labelledby="crop-cycles-heading">
    <div class="sf-section-line card-head"><div><h2 id="crop-cycles-heading">@T["Crop records"]</h2>
        <p class="sf-muted">@T["Open a crop for monitoring or harvests. Owners and managers can update its planting status."]</p></div>
        <span class="sf-muted">@T["{0} on this page · {1} total · {2} finished/ended", visibleCycles.Count, Model.Cycles.Count, finishedCycles]</span></div>
    @if (Model.Cycles.Count == 0) { <p>@T["No crop cycles have been planned yet."]</p> }
    <div class="sf-crop-card-grid reference-cycle-grid ani12d-record-grid">
    @foreach (var cycle in visibleCycles)
    {
        <article class="crop-cycle sf-crop-record ani-crop-record ani12d-record" id="crop-cycle-@cycle.Id">
            <div class="sf-crop-card-heading">
                <div>
                    <h3>@cycle.CropTypeName</h3>
                    <p class="sf-muted">@cycle.PlotName</p>
                </div>
                <span class="sf-status-chip @(cycle.Status == CropCycleStatus.Active ? "sf-status-chip--active" : cycle.Status == CropCycleStatus.Planned ? "sf-status-chip--planned" : cycle.Status == CropCycleStatus.Failed ? "sf-status-chip--failed" : "sf-status-chip--neutral")">@T[cycle.Status.ToString()]</span>
            </div>
            <div class="ani-crop-dates" aria-label="@T["Crop cycle dates"]">
                <div><span>@T["Planned planting"]</span><strong>@cycle.PlannedPlantingDate.ToString("MMM d, yyyy")</strong></div>
                <div><span>@T["Actual planting"]</span><strong>@(cycle.PlantedDate?.ToString("MMM d, yyyy") ?? "Not planted")</strong></div>
                <div><span>@T["Expected harvest"]</span><strong>@(cycle.ExpectedHarvestDate?.ToString("MMM d, yyyy") ?? "Not set")</strong></div>
            </div>
            <div class="ani-crop-record-main-action">
                <a asp-controller="Monitoring" asp-action="Index" asp-route-farmId="@Model.Farm.Id"
                   asp-route-cycleId="@cycle.Id">@T["Open monitoring →"]</a>
            </div>
            <p><a asp-controller="Harvests" asp-action="Index"
                  asp-route-farmId="@Model.Farm.Id" asp-route-cycleId="@cycle.Id">@T["Harvest records →"]</a></p>
            <p><a asp-controller="Monitoring" asp-action="Index"
                  asp-route-farmId="@Model.Farm.Id" asp-route-cycleId="@cycle.Id">@T["Activities, inspections and photos →"]</a>
                · <a asp-controller="Crops" asp-action="Index" asp-fragment="crop-history"
                    asp-route-farmId="@Model.Farm.Id" asp-route-cycleId="@cycle.Id">@T["Crop history →"]</a></p>
            @if (cycle.Status == CropCycleStatus.Active)
            {
                <div class="action-links sf-crop-quick-actions" aria-label="@T["Quick field logging for {0} on {1}", cycle.CropTypeName, cycle.PlotName]">
                    <a asp-controller="Monitoring" asp-action="Index" asp-route-farmId="@Model.Farm.Id"
                       asp-route-cycleId="@cycle.Id" asp-route-quick="watering"
                       asp-fragment="record-activity">@T["Log watering"]</a>
                    <a asp-controller="Monitoring" asp-action="Index" asp-route-farmId="@Model.Farm.Id"
                       asp-route-cycleId="@cycle.Id" asp-route-quick="inspection"
                       asp-fragment="record-inspection">@T["Record inspection"]</a>
                    <a asp-controller="Harvests" asp-action="Index" asp-route-farmId="@Model.Farm.Id"
                       asp-route-cycleId="@cycle.Id" asp-fragment="record-harvest">@T["Record harvest"]</a>
                </div>
            }
            @if (cycle.TerminationReason is not null)
            { <p>@T["Reason:"] @cycle.TerminationReason</p> }
            @if (canManage && cycle.Status is CropCycleStatus.Planned or CropCycleStatus.Active)
            {
            <details class="reference-cycle-management" open="@(Model.TransitionCycleId == cycle.Id)">
                <summary>@T["Manage crop cycle"]</summary>
            @if (canManage && cycle.Status == CropCycleStatus.Planned)
            {
                <a asp-action="EditPlan" asp-route-farmId="@Model.Farm.Id" asp-route-cycleId="@cycle.Id">@T["Edit plan"]</a>
                <form asp-action="Transition" asp-route-farmId="@Model.Farm.Id"
                      asp-route-cycleId="@cycle.Id" method="post" data-confirm="@T["Mark as planted: {0} on {1}? Review the dates and reason before continuing.", cycle.CropTypeName, cycle.PlotName]">
                    <input type="hidden" name="Transition.RowVersion" value="@cycle.RowVersion" />
                    <input type="hidden" name="Transition.Status" value="Active" />
                    <label for="Transition_PlantedDate_@cycle.Id">@T["Actual planting date"]</label><input id="Transition_PlantedDate_@cycle.Id" type="date" name="Transition.PlantedDate" value="@(Model.TransitionCycleId == cycle.Id ? Model.Transition.PlantedDate?.ToString("yyyy-MM-dd") : null)" required />
                    <button type="submit">@T["Mark as planted"]</button>
                </form>
            }
            @if (canManage && cycle.Status == CropCycleStatus.Active)
            {
                <form asp-action="Transition" asp-route-farmId="@Model.Farm.Id"
                      asp-route-cycleId="@cycle.Id" method="post" data-confirm="@T["Complete: {0} on {1}? Review the dates and reason before continuing.", cycle.CropTypeName, cycle.PlotName]">
                    <input type="hidden" name="Transition.RowVersion" value="@cycle.RowVersion" />
                    <input type="hidden" name="Transition.Status" value="Completed" />
                    <button type="submit">@T["Complete crop cycle"]</button>
                </form>
            }
            @if (canManage && cycle.Status is CropCycleStatus.Active or CropCycleStatus.Planned)
            {
                <form asp-action="Transition" asp-route-farmId="@Model.Farm.Id"
                      asp-route-cycleId="@cycle.Id" method="post" data-confirm="@T["Cancel: {0} on {1}? Review the dates and reason before continuing.", cycle.CropTypeName, cycle.PlotName]">
                    <input type="hidden" name="Transition.RowVersion" value="@cycle.RowVersion" />
                    <input type="hidden" name="Transition.Status" value="Cancelled" />
                    <label for="Transition_TerminationReason_@cycle.Id">@T["Cancellation reason"]</label><input id="Transition_TerminationReason_@cycle.Id" name="Transition.TerminationReason" value="@(Model.TransitionCycleId == cycle.Id && Model.Transition.Status == CropCycleStatus.Cancelled ? Model.Transition.TerminationReason : null)" maxlength="300" required />
                    <button class="button-danger" type="submit">@T["Cancel cycle"]</button>
                </form>
            }
            @if (canManage && cycle.Status == CropCycleStatus.Active)
            {
                <form asp-action="Transition" asp-route-farmId="@Model.Farm.Id"
                      asp-route-cycleId="@cycle.Id" method="post" data-confirm="@T["Mark failed: {0} on {1}? Review the dates and reason before continuing.", cycle.CropTypeName, cycle.PlotName]">
                    <input type="hidden" name="Transition.RowVersion" value="@cycle.RowVersion" />
                    <input type="hidden" name="Transition.Status" value="Failed" />
                    <label for="Transition_FailureReason_@cycle.Id">@T["Failure reason"]</label><input id="Transition_FailureReason_@cycle.Id" name="Transition.TerminationReason" value="@(Model.TransitionCycleId == cycle.Id && Model.Transition.Status == CropCycleStatus.Failed ? Model.Transition.TerminationReason : null)" maxlength="300" required />
                    <button class="button-danger" type="submit">@T["Mark failed"]</button>
                </form>
            }
            </details>
            }
        </article>
    }
    </div>
    @if (cyclePageCount > 1)
    {
        <nav class="ani-p4-pager ani-f2-pager" aria-label="@T["Crop record pages"]">
            <span>@T["{0} {1} of {2}", T["Page"], currentCyclePage, cyclePageCount]</span>
            @if (currentCyclePage > 1)
            {
                <a asp-controller="Crops" asp-action="Index" asp-route-farmId="@Model.Farm.Id"
                   asp-route-page="@(currentCyclePage - 1)" asp-fragment="crop-cycles-heading" rel="prev">@T["Previous"]</a>
            }
            @if (currentCyclePage < cyclePageCount)
            {
                <a asp-controller="Crops" asp-action="Index" asp-route-farmId="@Model.Farm.Id"
                   asp-route-page="@(currentCyclePage + 1)" asp-fragment="crop-cycles-heading" rel="next">@T["Next"]</a>
            }
        </nav>
    }
</section>
</details>

@if (Model.SelectedHistory is { } selectedHistory)
{
    <partial name="_CropHistory" model="selectedHistory" />
}

@if (Model.Agenda is { } agenda)
{
<section class="panel card sf-crop-calendar ani12d-calendar" aria-labelledby="crop-calendar-heading">
    <header class="reference-panel-heading"><div>

    <h2 id="crop-calendar-heading">@T["Crop calendar"]</h2>
    <p class="sf-muted">@T["Saved dates and projected growing activities for"] @Model.Farm.TimeZoneId.</p>
</div></header>
    <p class="hint ani12d-calendar-note">@T["Planting and expected harvest dates come from saved plans. Watering is projected, not completed work. Check"] <a asp-controller="Tasks" asp-action="Index" asp-route-farmId="@Model.Farm.Id">@T["Tasks"]</a> @T["to see assigned jobs."]</p>
    <nav class="crop-agenda-nav ani12d-calendar-nav" aria-label="@T["Calendar month"]">
        <a asp-controller="Crops" asp-action="Index" asp-route-farmId="@Model.Farm.Id"
           asp-route-month="@agenda.PreviousMonth.ToString("yyyy-MM")" asp-fragment="crop-calendar-heading" aria-label="@T["Previous month"]">@T["← Previous"]</a>
        <strong>@agenda.FirstDay.ToString("MMMM yyyy")</strong>
        <a asp-controller="Crops" asp-action="Index" asp-route-farmId="@Model.Farm.Id"
           asp-route-month="@agenda.NextMonth.ToString("yyyy-MM")" asp-fragment="crop-calendar-heading" aria-label="@T["Next month"]">@T["Next →"]</a>
    </nav>
    <div class="reference-calendar ani12d-calendar-month" role="group" aria-label="@T["{0} crop calendar", agenda.FirstDay.ToString("MMMM yyyy")]">
        <div class="calendar-grid reference-calendar-week" aria-hidden="true">
            @foreach (var weekday in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" }) { <span>@weekday</span> }
        </div>
        <div class="calendar-grid">
            @for (var empty = 0; empty < (int)agenda.FirstDay.DayOfWeek; empty++) { <div class="cal-cell outside" aria-hidden="true"></div> }
            @for (var day = 1; day <= DateTime.DaysInMonth(agenda.FirstDay.Year, agenda.FirstDay.Month); day++)
            {
                var date = new DateOnly(agenda.FirstDay.Year, agenda.FirstDay.Month, day);
                var scheduled = agenda.Days.FirstOrDefault(d => d.Date == date);
                <div class="cal-cell @(scheduled is not null ? "has-events" : "")">
                    @if (scheduled is not null)
                    {
                        <a href="#agenda-date-@date.ToString("yyyy-MM-dd")" aria-label="@T["{0}, {1} scheduled entries", date.ToString("MMMM d"), scheduled.Entries.Count]"><time datetime="@date.ToString("yyyy-MM-dd")">@day</time><span class="calendar-event-dot" aria-hidden="true"></span></a>
                    }
                    else { <time datetime="@date.ToString("yyyy-MM-dd")">@day</time> }
                </div>
            }
        </div>
    </div>
    @if (agenda.Days.Count > 0)
    {
        <details class="crop-agenda-details ani12d-agenda-details" open>
            <summary>@T["Scheduled dates · {0} entries across {1} days", agenda.Days.Sum(d => d.Entries.Count), agenda.Days.Count]</summary>
            <ol class="crop-agenda-list ani12d-agenda-list">
            @foreach (var day in agenda.Days)
            {
                <li id="agenda-date-@day.Date.ToString("yyyy-MM-dd")"><time datetime="@day.Date.ToString("yyyy-MM-dd")">@day.Date.ToString("dddd, MMM d")</time><ul>
                @foreach (var entry in day.Entries) { <li><strong>@entry.Kind</strong><span>@entry.CropName · @entry.PlotName</span></li> }
                </ul></li>
            }
            </ol>
        </details>
    }
    @if (agenda.Days.Count == 0) { <div class="ani12d-empty-month"><strong>@T["No scheduled crop activities this month."]</strong><p>@T["Move to another month or add a planting plan to begin."]</p></div> }
    <p><a asp-controller="Tasks" asp-action="Index" asp-route-farmId="@Model.Farm.Id">@T["View assigned tasks and reminders →"]</a></p>
</section>
}

<details class="ani-crop-advanced" id="crop-advanced" @(Model.CropTypes.Count == 0 || !ViewData.ModelState.IsValid ? "open" : "")>
    <summary><strong>@T["Crop types & history"]</strong><span>@T["Advanced tools and past growing records"]</span></summary>
    <div class="ani-crop-advanced-content">
<section class="panel card sf-crop-types" aria-labelledby="crop-types-heading">
    <header class="reference-panel-heading"><h2 id="crop-types-heading">@T["Available crop types"]</h2></header>
    @if (Model.CropTypes.Count == 0) { <p>@T["No crop types available yet."]</p> }
    else
    {
        <ul class="farm-list">
        @foreach (var type in Model.CropTypes)
        {
            <li class="ani-crop-type-row">
                <div>
                    <strong>@type.Name</strong>
                    <span class="sf-muted">@T["Harvest unit:"] @type.DefaultHarvestUnit</span>
                    @if (type.DefaultGrowthDays is not null) { <span class="sf-muted">@T["{0} {1} days", T["Typical growth:"], type.DefaultGrowthDays]</span> }
                </div>
            </li>
        }
        </ul>
    }
    @if (canManage)
    {
        <h3>@T["Add a crop type"]</h3>
        <p class="hint">@T["Crop types are shared across farms. Existing types cannot be renamed here."]</p>
        <form class="sf-crop-form" asp-action="CreateCropType" asp-route-farmId="@Model.Farm.Id" method="post">
            <label asp-for="CropType.Name">@T["Crop name"]</label><input asp-for="CropType.Name" maxlength="100" required /><span asp-validation-for="CropType.Name" class="error"></span>
            <label asp-for="CropType.DefaultHarvestUnit">@T["Harvest unit"]</label><input asp-for="CropType.DefaultHarvestUnit" maxlength="20" required /><span asp-validation-for="CropType.DefaultHarvestUnit" class="error"></span>
            <label asp-for="CropType.DefaultGrowthDays">@T["Typical growth days (optional)"]</label>
            <input asp-for="CropType.DefaultGrowthDays" type="number" min="1" max="32767" /><span asp-validation-for="CropType.DefaultGrowthDays" class="error"></span>
            <label asp-for="CropType.DefaultWateringIntervalDays">@T["Watering interval (optional)"]</label>
            <input asp-for="CropType.DefaultWateringIntervalDays" type="number" min="1" max="32767" /><span asp-validation-for="CropType.DefaultWateringIntervalDays" class="error"></span>
            <button type="submit">@T["Add crop type"]</button>
        </form>
    }
</section>

<section class="panel card sf-crop-history" aria-labelledby="rotation-heading">
    <header class="reference-panel-heading"><h2 id="rotation-heading">@T["Plot crop rotation history"]</h2></header>
    <p class="hint">@T["See previous and current crop cycles per plot, including completed, failed, and cancelled plantings. This is a record of your farm history, not a rotation recommendation."]</p>
    @if (Model.Cycles.Count == 0) { <p>@T["No planting history recorded yet."]</p> }
    @foreach (var plotHistory in Model.Cycles.GroupBy(c => new { c.PlotId, c.PlotName }).OrderBy(g => g.Key.PlotName))
    {
        <details class="rotation-plot">
            <summary>@T["{0} · {1} crop cycle(s)", plotHistory.Key.PlotName, plotHistory.Count()]</summary>
            <ol class="rotation-list">
            @foreach (var history in plotHistory.OrderByDescending(c => c.PlantedDate ?? c.PlannedPlantingDate))
            {
                <li>
                    <strong>@history.CropTypeName</strong> · @history.StatusName
                    <span> · @((history.PlantedDate ?? history.PlannedPlantingDate).ToString("MMM d, yyyy"))</span>
                    @if (history.ExpectedHarvestDate is { } harvest)
                    { <span>@T["· Expected harvest"] @harvest.ToString("MMM d, yyyy")</span> }
                </li>
            }
            </ol>
        </details>
    }
</section>

    </div>
</details>
</div>
