@model SmartFarm.Core.Contracts.Accounts.ForgotPasswordInput
@{
    ViewData["Title"] = T["Forgot password"];
}
<div class="auth-layout ani-entry-auth-layout">
    <aside class="auth-intro ani-entry-auth-visual">
        <img class="ani-entry-auth-photo" src="~/images/photography/fields-detail.webp" alt="" width="1000" height="760" loading="lazy" />
        <div class="ani-entry-auth-visual-content">
            <span class="ani-entry-auth-kicker">@T["YOUR FARM WORKSPACE"]</span>
            <h2>@T["Get back to your farm work."]</h2>
            <p>@T["We'll help you request a secure password reset."]</p>
        </div>
    </aside>
    <section class="panel auth-card ani-entry-auth-card" aria-labelledby="recovery-heading">
        <div class="auth-heading">
            <p class="ani-entry-eyebrow">@T["ACCOUNT RECOVERY"]</p>
            <h1 id="recovery-heading">@T["Forgot your password?"]</h1>
            <p>@T["Enter your account email. If an account exists and email delivery is configured, we'll send reset instructions."]</p>
        </div>
        <form asp-controller="AccountRecovery" asp-action="Forgot" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="error" role="alert"></div>
            <div class="form-field">
                <label asp-for="Email">@T["Email address"]</label>
                <input asp-for="Email" type="email" autocomplete="email" inputmode="email"
                       autocapitalize="none" spellcheck="false" required maxlength="256" />
                <span asp-validation-for="Email" class="error"></span>
            </div>
            <button type="submit" class="auth-submit">@T["Request reset instructions"]</button>
        </form>
        <p class="auth-switch"><a asp-controller="Account" asp-action="Login">@T["Back to log in"]</a></p>
    </section>
</div>
