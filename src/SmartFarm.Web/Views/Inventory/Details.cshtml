@using SmartFarm.Core.Enums
@model SmartFarm.Web.ViewModels.Inventory.InventoryItemPage
@{
    ViewData["Title"] = Model.Item.Name;
    var item = Model.Item;
    var canManage = Model.Farm.Role is "Owner" or "Manager";
    var active = item.ArchivedAtUtc is null;
    var canConsume = active;
    var reversedIds = Model.Transactions.Where(x => x.ReversesTransactionId is not null)
        .Select(x => x.ReversesTransactionId!.Value).ToHashSet();
}
<partial name="_FarmNavigation" model="Model.Farm.Id" />
<section class="panel sf-ops-hero sf-stock-hero" aria-labelledby="stock-heading">
    <div class="sf-page-header">
        <div>
            <p><a asp-action="Index" asp-route-farmId="@Model.Farm.Id">← Inventory</a></p>
            <p class="sf-kicker">SUPPLY DETAILS</p>
            <h1 id="stock-heading">@item.Name</h1>
            <p class="sf-muted">@item.CategoryName · @item.Unit</p>
            @if (item.ReorderLevel.HasValue)
            {
                <p class="ani-stock-threshold">Low-stock alert at @item.ReorderLevel.Value.ToString("N3") @item.Unit</p>
            }
        </div>
        <div class="sf-stock-hero-balance">
            <span>Available stock</span>
            <strong>@item.QuantityOnHand <small>@item.Unit</small></strong>
            @if (item.IsLowStock) { <span class="sf-status-chip sf-status-chip--warning">Low-stock threshold reached</span> }
            else if (active) { <span class="sf-status-chip sf-status-chip--active">In stock</span> }
        </div>
    </div>
    @if (!active) { <p class="sf-ops-hint">Archived item — transaction history remains available.</p> }
    @if (item.Description is not null) { <p class="sf-muted">@item.Description</p> }
    @if (TempData["Error"] is string error) { <p class="error form-error" role="alert">@error</p> }
    @if (canManage && active)
    {
        <a asp-action="Edit" asp-route-farmId="@Model.Farm.Id" asp-route-itemId="@item.Id">Edit item</a>
        @if (item.QuantityOnHand == 0)
        {
            <form asp-action="Archive" asp-route-farmId="@Model.Farm.Id" asp-route-itemId="@item.Id" method="post" data-confirm="Archive @item.Name? Its transaction history will be retained.">
                <input type="hidden" name="rowVersion" value="@item.RowVersion" />
                <button class="button-danger" type="submit">Archive item</button>
            </form>
        }
    }
</section>
@if (active)
{
    <section class="panel sf-stock-movement" aria-labelledby="stock-movement-heading">
        <p class="sf-kicker">TRACK STOCK</p>
        <h2 id="stock-movement-heading">Stock movement</h2>
        <p>Use <strong>Receipt</strong> when supplies arrive, <strong>Consumption</strong> when they were used for recorded crop work, and <strong>Adjustment</strong> to correct a stock count. Every change is saved in the transaction history.</p>
        <div class="ani-stock-movement-guide" role="note">
            <span>+ Receipt</span><span>− Consumption</span><span>± Adjustment</span>
        </div>
        <form class="sf-ops-form" asp-action="Post" asp-route-farmId="@Model.Farm.Id" asp-route-itemId="@item.Id" method="post">
            <input type="hidden" name="RowVersion" value="@item.RowVersion" />
            <label for="kind">Movement type</label>
            <select id="kind" name="TransactionType" aria-describedby="movement-hint">
                @if (canManage)
                {
                    <option value="2">Receipt (+)</option>
                    <option value="4">Adjustment (+/-)</option>
                }
                <option value="3">Consumption (-)</option>
            </select>
            <label for="quantity">Quantity (@item.Unit)</label>
            <p id="movement-hint" class="hint">Use a positive amount for receipts or consumption. Adjustments allow a plus or minus sign. Maximum 3 decimal places.</p>
            <input id="quantity" name="QuantityChange" type="number" step="0.001" required />
            <label for="cropActivity">Crop activity for consumption</label>
            <select id="cropActivity" name="CropActivityId">
                <option value="">Not applicable</option>
                @foreach (var activity in Model.ActivityOptions)
                {
                    <option value="@activity.Id">@activity.Label</option>
                }
            </select>
            <label for="reason">Reason (required for adjustments)</label>
            <input id="reason" name="Reason" maxlength="300" />
            <button type="submit">Save stock movement</button>
            <p class="ani-stock-guidance">The updated stock balance is shown after the server confirms this entry.</p>
        </form>
    </section>
}
<section class="panel sf-stock-history" aria-labelledby="transaction-heading">
    <div class="sf-section-line">
        <h2 id="transaction-heading">Transaction history</h2>
        <span>@Model.Transactions.Count entry/entries</span>
    </div>
    @if (Model.Transactions.Count == 0) { <p>No stock movements recorded.</p> }
    <ul class="farm-list sf-stock-transactions">
        @foreach (var transaction in Model.Transactions)
        {
            <li>
                <div class="sf-transaction-title">
                    <strong>@transaction.TransactionType</strong>
                    <strong class="sf-transaction-qty">@transaction.QuantityChange @item.Unit</strong>
                </div>
                <time datetime="@transaction.OccurredAtUtc.ToString("yyyy-MM-ddTHH:mm:ssZ")">@transaction.OccurredAtUtc.ToString("MMM d, yyyy HH:mm") UTC</time>
                @if (transaction.Reason is not null) { <p>@transaction.Reason</p> }
                @if (transaction.ReversesTransactionId is not null) { <small>Reversal of @transaction.ReversesTransactionId</small> }
                @if (canManage && active && transaction.TransactionType != StockTransactionType.Reversal &&
                      !reversedIds.Contains(transaction.Id))
                {
                    <form class="sf-reverse-form" asp-action="Reverse" asp-route-farmId="@Model.Farm.Id"
                          asp-route-itemId="@item.Id" asp-route-transactionId="@transaction.Id" method="post" data-confirm="Reverse @transaction.QuantityChange @item.Unit for @item.Name? This will change the stock balance.">
                        <input type="hidden" name="RowVersion" value="@item.RowVersion" />
                        <label for="reversal-@transaction.Id">Reversal reason</label>
                        <input id="reversal-@transaction.Id" name="Reason" minlength="3" maxlength="300" required />
                        <button class="button-danger" type="submit">Reverse transaction</button>
                    </form>
                }
            </li>
        }
    </ul>
</section>

