@model SmartFarm.Web.ViewModels.Admin.AdminUserIndexPage
@{
    ViewData["Title"] = "Users";
}
<div class="page-heading admin-page-heading">
    <div><p class="sf-kicker">PLATFORM DIRECTORY</p><h1>Users</h1>
        <p class="sf-muted">Find registered accounts and review their status. Platform roles cannot be edited here.</p></div>
</div>
<section class="panel admin-directory-panel" aria-label="User directory">
    <form class="admin-filters" method="get" asp-area="Admin" asp-controller="Users" asp-action="Index">
        <div class="admin-filter-search">
            <label for="admin-user-search">Find a user</label>
            <input id="admin-user-search" name="search" type="search" value="@Model.Search" maxlength="100"
                   placeholder="Search name or email" />
        </div>
        <div>
            <label for="admin-user-status">Account status</label>
            <select id="admin-user-status" name="status">
                <option value="all" selected="@(Model.Status == "all")">All accounts</option>
                <option value="active" selected="@(Model.Status == "active")">Active</option>
                <option value="disabled" selected="@(Model.Status == "disabled")">Disabled</option>
            </select>
        </div>
        <button type="submit">Search</button>
        <a class="admin-reset" asp-area="Admin" asp-controller="Users" asp-action="Index">Clear</a>
    </form>
    <p class="admin-results-count">@Model.TotalCount @(Model.TotalCount == 1 ? "account" : "accounts") found</p>
    @if (Model.Users.Count == 0)
    {
        <div class="admin-empty"><strong>No matching users</strong><p>Try a different name, email or status.</p></div>
    }
    else
    {
        <div class="admin-record-list">
            @foreach (var user in Model.Users)
            {
                <a class="admin-record" asp-area="Admin" asp-controller="Users" asp-action="Details" asp-route-id="@user.Id">
                    <span class="admin-record-main">
                        <strong>@user.Name</strong><small>@user.Email</small>
                        <small>@user.OwnedFarms owned farms · @user.ActiveMemberships memberships</small>
                    </span>
                    <span class="admin-record-meta">
                        @if (user.IsSuperAdmin) { <span class="sf-status-chip sf-status-chip--planned">Super Admin</span> }
                        <span class="sf-status-chip @(user.Disabled ? "sf-status-chip--neutral" : "sf-status-chip--active")">@(user.Disabled ? "Disabled" : "Active")</span>
                    </span>
                </a>
            }
        </div>
        <nav class="admin-pagination" aria-label="User pages">
            @if (Model.HasPrevious)
            {
                <a asp-area="Admin" asp-controller="Users" asp-action="Index" asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status" asp-route-page="@(Model.Page - 1)">Previous</a>
            }
            <span>Page @Model.Page of @((Model.TotalCount + SmartFarm.Web.ViewModels.Admin.AdminUserIndexPage.PageSize - 1) / SmartFarm.Web.ViewModels.Admin.AdminUserIndexPage.PageSize)</span>
            @if (Model.HasNext)
            {
                <a asp-area="Admin" asp-controller="Users" asp-action="Index" asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status" asp-route-page="@(Model.Page + 1)">Next</a>
            }
        </nav>
    }
</section>
