@model SmartFarm.Web.ViewModels.Farms.FarmEnrollmentPanel
<section class="panel sf-enrollment-panel ani-team-enrollment" aria-labelledby="join-requests-heading">
    <p class="ani-overline">@T["Farm access"]</p>
    <h2 id="join-requests-heading">@T["Invite & approve team members"]</h2>
    @if (Model.Error is not null)
    {
        <p class="error form-error" role="alert">@Model.Error</p>
    }
    else if (Model.Overview is { } overview)
    {
        <p class="sf-muted">@T["Only the farm owner can review join requests. Sharing a code doesn't give access until the request is approved."]</p>
        <div class="ani-team-request-summary">
            <strong>@overview.Requests.Count</strong>
            <span>@(overview.Requests.Count == 1 ? T["person waiting for approval"] : T["people waiting for approval"])</span>
        </div>
        <section aria-labelledby="pending-requests-heading" class="ani-team-pending">
            <h3 id="pending-requests-heading">@T["Pending requests"]</h3>
            @if (overview.Requests.Count == 0)
            {
                <div class="sf-empty-state"><strong>@T["No one is waiting for approval."]</strong>
                    <p>@T["When a farmer enters your farm code, their request will appear here."]</p></div>
            }
            else
            {
                <ul class="farm-list ani-team-request-list">
                @foreach (var request in overview.Requests)
                {
                    <li>
                        <div><strong>@request.FullName</strong>
                            <span>@request.Email</span>
                            <time datetime="@request.RequestedAtUtc.ToString("yyyy-MM-ddTHH:mm:ssZ")">@T["Requested {0}", SmartFarm.Web.Presentation.FarmTimestamp.Display(request.RequestedAtUtc, Model.TimeZoneId)] </time>
                        </div>
                        <div class="ani-team-decision">
                            <form asp-controller="Farms" asp-action="DecideJoin" asp-route-id="@Model.FarmId"
                                  asp-route-requestId="@request.Id" asp-route-dashboard="@Model.Dashboard" method="post">
                                <button name="approve" value="true" type="submit">@T["Approve"] @request.FullName</button>
                            </form>
                            <form asp-controller="Farms" asp-action="DecideJoin" asp-route-id="@Model.FarmId"
                                  asp-route-requestId="@request.Id" asp-route-dashboard="@Model.Dashboard" method="post"
                                  data-confirm="@T["Reject the join request from {0}?", request.FullName]">
                                <button class="button-danger" name="approve" value="false" type="submit">@T["Reject"] @request.FullName</button>
                            </form>
                        </div>
                    </li>
                }
                </ul>
            }
        </section>
        <details class="ani-team-share" @(overview.Requests.Count == 0 ? "open" : "")>
            <summary><strong>@T["Share farm joining code"]</strong><span>@T["For inviting new workers"]</span></summary>
            <p class="ani-inline-help">@T["Give the 12-character code only to people you want to invite. They enter it in My Farms and request approval."]</p>
            <div class="sf-enrollment-code">
                <label for="farm-join-code">@T["Farm code"]</label>
                <input id="farm-join-code" readonly value="@overview.JoinCode"
                       aria-describedby="farm-code-copy-status" />
                <button type="button" data-copy-target="farm-join-code" data-copy-status="farm-code-copy-status">@T["Copy code"]</button>
                <p id="farm-code-copy-status" role="status" aria-atomic="true"></p>
            </div>
            <details class="ani-team-sensitive">
                <summary>@T["Replace an existing farm code"]</summary>
                <p>@T["Only replace this code if it should no longer accept new join requests. Existing members keep their access."]</p>
                <form asp-controller="Farms" asp-action="RegenerateCode" asp-route-id="@Model.FarmId"
                      asp-route-dashboard="@Model.Dashboard" method="post"
                      data-confirm="Regenerate this farm code? The old code will stop accepting new requests.">
                    <input type="hidden" name="CurrentCode" value="@overview.JoinCode" />
                    <button type="submit" class="sf-button-outline">@T["Regenerate code"]</button>
                </form>
            </details>
        </details>
        <details class="ani-team-history">
            <summary>@T["Request history ({0})", overview.History?.Count ?? 0]</summary>
            @if (overview.History is not { Count: > 0 })
            {
                <p class="sf-muted">@T["No reviewed join requests yet."]</p>
            }
            else
            {
                <ul class="farm-list">
                @foreach (var request in overview.History)
                {
                    <li><strong>@request.FullName</strong>
                        <span>@T[request.Status.ToString()] · @request.Email</span>
                        <time datetime="@request.RequestedAtUtc.ToString("yyyy-MM-ddTHH:mm:ssZ")">@T["Requested {0}", SmartFarm.Web.Presentation.FarmTimestamp.Display(request.RequestedAtUtc, Model.TimeZoneId)] </time>
                        @if (request.ReviewedAtUtc is { } reviewed)
                        {
                            <time datetime="@reviewed.ToString("yyyy-MM-ddTHH:mm:ssZ")">@T["Updated {0}", SmartFarm.Web.Presentation.FarmTimestamp.Display(reviewed, Model.TimeZoneId)] </time>
                        }
                    </li>
                }
                </ul>
            }
        </details>
    }
</section>
