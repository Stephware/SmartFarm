@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var accountName = User.Identity?.Name ?? "Your account";
    var initial = string.IsNullOrWhiteSpace(accountName) ? "A" : accountName[..1].ToUpperInvariant();
    var utilityOpen = currentController is "Support" or "Account" || currentAction == "Help"
        || ViewContext.RouteData.Values["area"]?.ToString() == "Admin";
}
<!DOCTYPE html>
<html lang="en" data-color-mode="light" data-theme="gold">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#153D2D" />
    <title>@ViewData["Title"] - AniGo</title>
    <script src="~/js/color-mode.js" asp-append-version="true"></script>
    <link rel="preload" href="~/fonts/manrope/Manrope-Variable.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="~/css/anigo-tailwind.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    <script src="~/js/farm-navigation.js" asp-append-version="true" defer></script>
    <script src="~/js/access-polish.js" asp-append-version="true" defer></script>
</head>
<body class="@(signedIn ? "is-authenticated" : "is-guest")">
<a class="skip-link" href="#main-content">Skip to content</a>
@if (signedIn)
{
    <div class="app-shell">
        <aside class="app-sidebar sidebar" aria-label="Workspace navigation">
            <a class="logo brand sidebar-brand" asp-controller="Farms" asp-action="Index">
                <span class="logo-mark"><partial name="_Icon" model='@("leaf")' /></span>
                <span>AniGo<small>Farm management</small></span>
            </a>
            <div class="sidebar-workspace">
                <p class="side-group-label">Workspace</p>
                <nav class="side-group sidebar-links" aria-label="Account and farm selection">
                    <a class="nav-link" asp-controller="Farms" asp-action="Index" data-nav-icon="farms"
                       id="sidebar-my-farms" aria-current="@(currentController == "Farms" && currentAction == "Index" ? "page" : null)">
                        <partial name="_Icon" model='@("grid")' /><span>My farms</span>
                    </a>
                </nav>
                <section class="sidebar-farm-context" id="sidebar-farm-context" aria-label="Selected farm" hidden>
                    <span>Current farm</span>
                    <strong id="sidebar-current-farm">@(ViewData["FarmName"] ?? "Current farm")</strong>
                    <a asp-controller="Farms" asp-action="Index">Change farm</a>
                </section>
                <div id="sidebar-farm-group" class="sidebar-farm-group" hidden>
                    <nav id="sidebar-farm-links" class="side-group sidebar-links" aria-label="Current farm sections"></nav>
                </div>
            </div>
            <div class="sidebar-utilities">
                <p class="side-group-label">Updates</p>
                <nav class="side-group sidebar-links" aria-label="Notifications">
                    <a class="nav-link" asp-controller="Notifications" asp-action="Index"
                       aria-current="@(currentController == "Notifications" ? "page" : null)">
                        <partial name="_Icon" model='@("bell")' /><span>Notifications</span>
                    </a>
                </nav>
                <details class="sidebar-utility-menu" id="sidebar-utility-menu" open="@(utilityOpen ? "open" : null)">
                    <summary><partial name="_Icon" model='@("settings")' /><span>Help &amp; account</span></summary>
                    <nav id="sidebar-insight-links" class="side-group sidebar-links" aria-label="Help and account">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Help"
                           aria-current="@(currentController == "Home" && currentAction == "Help" ? "page" : null)">
                            <partial name="_Icon" model='@("settings")' /><span>Help</span>
                        </a>
                        <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Profile"
                           aria-current="@(currentController == "Account" ? "page" : null)">
                            <partial name="_Icon" model='@("settings")' /><span>Account &amp; settings</span>
                        </a>
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                               aria-label="Super Admin portal"><partial name="_Icon" model='@("settings")' /><span>Super Admin</span></a>
                        }
                    </nav>
                </details>
            </div>
            <div class="side-footer sidebar-bottom">
                <a class="person-row" asp-controller="Account" asp-action="Profile">
                    <span class="avatar" aria-hidden="true">@initial</span>
                    <span><strong>@accountName</strong><small>My AniGo account</small></span>
                </a>
                <div class="sidebar-footer-actions">
                    <a asp-controller="Farms" asp-action="Index">Switch farm</a>
                    <form method="post" asp-controller="Account" asp-action="Logout" class="logout-form">
                        <button type="submit" class="sidebar-logout"><partial name="_Icon" model='@("logout")' />Log out</button>
                    </form>
                </div>
            </div>
        </aside>
        <div class="app-body content-shell">
            <header class="site-header app-topbar topbar">
                <nav class="crumb" aria-label="Breadcrumb">
                    @if (currentController == "Farms" && currentAction == "Index")
                    {
                        <strong aria-current="page">My farms</strong>
                    }
                    else
                    {
                        <a asp-controller="Farms" asp-action="Index" aria-current="@(currentController == "Farms" && currentAction == "Index" ? "page" : null)">My farms</a>
                        <span aria-hidden="true">/</span>
                        <span class="breadcrumb-farm" id="breadcrumb-farm" hidden>
                            <a id="breadcrumb-farm-link" asp-controller="Farms" asp-action="Index">Farm</a>
                            <span aria-hidden="true">/</span>
                        </span>
                        <strong aria-current="page">@(ViewData["Title"] ?? "Overview")</strong>
                    }
                </nav>
                <a class="mobile-brand mobile-title" asp-controller="Farms" asp-action="Index"><partial name="_Icon" model='@("leaf")' />AniGo</a>
                <nav class="top-actions app-topbar-actions" aria-label="Quick account links">
                    <a class="farm-picker" asp-controller="Farms" asp-action="Index"
                       aria-label="Choose farm. Current: @(ViewData["FarmName"] ?? "My farms")"
                       title="Change farm">
                        <partial name="_Icon" model='@("leaf")' />
                        <span>@(ViewData["FarmName"] ?? "My farms")</span><small>Switch</small>
                    </a>
                    <button class="icon-button color-mode-toggle" type="button" data-color-mode-toggle aria-label="Use dark appearance" aria-pressed="false"><partial name="_Icon" model='@("sun")' /></button>
                    <a class="icon-button" asp-controller="Notifications" asp-action="Index" aria-label="Notifications"><partial name="_Icon" model='@("bell")' /></a>
                    <a class="top-avatar" asp-controller="Account" asp-action="Profile" aria-label="My account">@initial</a>
                </nav>
                <details class="mobile-nav" id="mobile-workspace-menu">
                    <summary aria-label="More workspace sections"><partial name="_Icon" model='@("more")' /><span>Menu</span></summary>
                    <nav aria-label="Mobile workspace navigation">
                        <div id="mobile-farm-links" class="mobile-farm-links" hidden></div>
                        <a asp-controller="Farms" asp-action="Index">My farms</a>
                        <a asp-controller="Notifications" asp-action="Index">Notifications</a>
                        <a asp-area="" asp-controller="Home" asp-action="Help">Help</a>
                        <a asp-controller="Account" asp-action="Profile">Account &amp; settings</a>
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Super Admin</a>
                        }
                        <form method="post" asp-controller="Account" asp-action="Logout" class="logout-form"><button type="submit" class="link-button">Log out</button></form>
                    </nav>
                </details>
            </header>
            <main class="page app-page app-main" id="main-content" tabindex="-1">
                <partial name="_ValidationSummary" />
                @RenderBody()
            </main>
        </div>
        <nav class="mobile-workspace-bar bottom-nav" id="mobile-workspace-bar" aria-label="Farm quick navigation" hidden>
            <div id="mobile-workspace-links" class="mobile-workspace-links"></div>
            <button type="button" class="mobile-more-button" id="mobile-more-button" aria-label="More farm sections" aria-controls="mobile-workspace-menu" aria-expanded="false"><partial name="_Icon" model='@("more")' /><span>More</span></button>
        </nav>
    </div>
}
else
{
    <header class="site-header guest-topbar">
        <a class="brand guest-logo" asp-controller="Home" asp-action="Index"><span class="logo-mark"><partial name="_Icon" model='@("leaf")' /></span>AniGo</a>
        <nav aria-label="Main navigation">
            <button class="icon-button" type="button" data-color-mode-toggle aria-label="Use dark appearance" aria-pressed="false"><partial name="_Icon" model='@("sun")' /></button>
            <a asp-controller="Account" asp-action="Login">Log in</a>
            <a class="button guest-nav-cta" asp-controller="Account" asp-action="Register">Create account</a>
        </nav>
    </header>
    <main class="page guest-page" id="main-content" tabindex="-1"><partial name="_ValidationSummary" />@RenderBody()</main>
}
</body>
</html>
