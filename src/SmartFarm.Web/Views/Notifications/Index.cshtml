@model IReadOnlyList<SmartFarm.Core.Contracts.Tasks.NotificationDetails>
@{
    ViewData["Title"] = "Notifications";
    var unreadCount = Model.Count(notification => notification.ReadAtUtc is null);
    var unreadOnly = string.Equals(Context.Request.Query["view"].ToString(), "unread", StringComparison.OrdinalIgnoreCase);
    var shown = (unreadOnly ? Model.Where(notification => notification.ReadAtUtc is null) : Model)
        .OrderBy(notification => notification.ReadAtUtc is null ? 0 : 1)
        .ThenByDescending(notification => notification.CreatedAtUtc).ThenBy(notification => notification.Id).ToList();
    const int pageSize = 20;
    var requestedPage = int.TryParse(Context.Request.Query["page"].ToString(), out var parsedPage) ? parsedPage : 1;
    var pageCount = Math.Max(1, (shown.Count + pageSize - 1) / pageSize);
    var currentPage = Math.Clamp(requestedPage, 1, pageCount);
    var visibleNotifications = shown.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
}
<div class="reference-screen reference-screen-notifications ani-p2-page ani-p2-notifications">
<section class="panel card sf-notifications-hero ani-p2-hero" aria-labelledby="notifications-heading">
    <div class="sf-page-header page-hero">
        <div>
            <p><a class="anigo-back-control" asp-controller="Farms" asp-action="Index" title="Back to my farms"><partial name="_Icon" model='@("chevLeft")' /><span class="visually-hidden">Back to my farms</span></a></p>

            <h1 id="notifications-heading">Notifications</h1>
            <p class="sf-muted">Recent updates and saved reminders for your farms.</p>
        </div>
        <div class="sf-notifications-count">
            <strong>@unreadCount</strong>
            <span>Recent unread</span>
        </div>
    </div>
    <details class="ani-p2-quiet-note"><summary>How notifications work</summary><p>These are saved notices, not live push alerts. Marking one as read does not complete a task or resolve an advisory.</p></details>
    @if (TempData["Message"] is string message) { <p class="form-notice" role="status">@message</p> }
</section>
<section class="panel card sf-notifications-panel" aria-labelledby="notifications-list-heading">
    <div class="sf-section-line card-head">
        <h2 id="notifications-list-heading">Recent notifications</h2>
        <span>@visibleNotifications.Count on this page · @shown.Count matching · @Model.Count recent</span>
    </div>
    @if (Model.Count == 100)
    {
        <p class="sf-muted">Showing the 100 most recent notices. Older messages are not listed here.</p>
    }
    <nav class="ani-inbox-tabs" aria-label="Notification filters">
        <a asp-controller="Notifications" asp-action="Index" asp-fragment="notifications-list-heading" class="@(!unreadOnly ? "is-active" : "")"
           aria-current="@(!unreadOnly ? "page" : null)">All (@Model.Count)</a>
        <a asp-controller="Notifications" asp-action="Index" asp-route-view="unread" asp-fragment="notifications-list-heading"
           class="@(unreadOnly ? "is-active" : "")"
           aria-current="@(unreadOnly ? "page" : null)">Unread (@unreadCount)</a>
    </nav>
    @if (shown.Count == 0)
    {
        <partial name="_UiEmptyState" model='@(new UiEmptyState(
            unreadOnly ? "No unread recent notices." : "No notifications yet.",
            unreadOnly ? "There are no unread notices in the recent list. You can review recent messages."
                : "Farm updates, task reminders and saved weather notices appear here.",
            unreadOnly ? "View recent notifications →" : null,
            unreadOnly ? Url.Action("Index", "Notifications") : null))' />
    }
    else
    {
        <ul class="sf-notifications-list list-grid">
        @foreach (var notification in visibleNotifications)
        {
            <li class="sf-notification list-card @(notification.ReadAtUtc is null ? "sf-notification-unread" : "sf-notification-read")">
                <span class="sf-notification-marker reference-notification-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg></span>
                <div class="sf-notification-body">
                    <div class="sf-notification-heading">
                        <strong>@notification.Title</strong>
                        @if (notification.ReadAtUtc is null)
                        {
                            <partial name="_UiStatusChip" model='@(new UiStatusChip("Unread", "sf-status-chip--planned"))' />
                        }
                    </div>
                    <p>@notification.Message</p>
                    <time datetime="@notification.CreatedAtUtc.ToString("yyyy-MM-ddTHH:mm:ssZ")">@notification.CreatedAtUtc.ToString("MMM d, yyyy HH:mm") UTC</time>
                    @if (notification.FarmTaskId.HasValue)
                    {
                        <p class="ani-notification-next">Task reminder · Open your farm's Tasks page to review or complete it.</p>
                    }
                    @if (notification.ReadAtUtc is null)
                    {
                        <form asp-action="Read" asp-route-id="@notification.Id" method="post">
                            <input type="hidden" name="returnView" value="@(unreadOnly ? "unread" : "all")" />
                            <input type="hidden" name="returnPage" value="@currentPage" />
                            <button type="submit" class="sf-notification-read-button">Mark as read</button>
                        </form>
                    }
                </div>
            </li>
        }
        </ul>
        @if (pageCount > 1)
        {
            <nav class="ani-p4-pager" aria-label="Notification pages">
                <span>Page @currentPage of @pageCount</span>
                @if (currentPage > 1)
                {
                    <a asp-controller="Notifications" asp-action="Index"
                       asp-route-view="@(unreadOnly ? "unread" : null)"
                       asp-route-page="@(currentPage - 1)" rel="prev">Previous</a>
                }
                @if (currentPage < pageCount)
                {
                    <a asp-controller="Notifications" asp-action="Index"
                       asp-route-view="@(unreadOnly ? "unread" : null)"
                       asp-route-page="@(currentPage + 1)" rel="next">Next</a>
                }
            </nav>
        }
    }
</section>

</div>
