@model IReadOnlyList<SmartFarm.Core.Contracts.Tasks.NotificationDetails>
@{
    ViewData["Title"] = "Notifications";
    var unreadCount = Model.Count(notification => notification.ReadAtUtc is null);
    var unreadOnly = string.Equals(Context.Request.Query["view"].ToString(), "unread", StringComparison.OrdinalIgnoreCase);
    var shown = (unreadOnly ? Model.Where(notification => notification.ReadAtUtc is null) : Model)
        .OrderBy(notification => notification.ReadAtUtc is null ? 0 : 1)
        .ThenByDescending(notification => notification.CreatedAtUtc).ToList();
}
<div class="reference-screen reference-screen-notifications">
<section class="panel card sf-notifications-hero" aria-labelledby="notifications-heading">
    <div class="sf-page-header page-hero">
        <div>
            <p><a asp-controller="Farms" asp-action="Index">← My farms</a></p>

            <p class="ani-overline">Updates &amp; reminders</p>
            <h1 id="notifications-heading">Notifications</h1>
            <p class="sf-muted">Review saved task reminders and farm weather advisories. Marking one as read does not complete a task or resolve an advisory.</p>
        </div>
        <div class="sf-notifications-count">
            <strong>@unreadCount</strong>
            <span>Unread</span>
        </div>
    </div>
    <p class="sf-ops-hint">Notices are generated by the existing task and weather checks. This inbox is not a live or push-alert service.</p>
    @if (TempData["Message"] is string message) { <p class="form-notice" role="status">@message</p> }
</section>
<section class="panel card sf-notifications-panel" aria-labelledby="notifications-list-heading">
    <div class="sf-section-line card-head">
        <h2 id="notifications-list-heading">Recent notifications</h2>
        <span>@shown.Count shown · @Model.Count total</span>
    </div>
    <nav class="ani-inbox-tabs" aria-label="Notification filters">
        <a asp-controller="Notifications" asp-action="Index" class="@(!unreadOnly ? "is-active" : "")"
           aria-current="@(!unreadOnly ? "page" : null)">All (@Model.Count)</a>
        <a asp-controller="Notifications" asp-action="Index" asp-route-view="unread"
           class="@(unreadOnly ? "is-active" : "")"
           aria-current="@(unreadOnly ? "page" : null)">Unread (@unreadCount)</a>
    </nav>
    @if (shown.Count == 0)
    {
        <partial name="_UiEmptyState" model='@(new UiEmptyState(
            unreadOnly ? "You're caught up." : "No notifications yet.",
            unreadOnly ? "No unread reminders or advisories. You can still review older messages."
                : "Task reminders and weather notices will appear here when saved by the farm's existing processes.",
            unreadOnly ? "View all notifications →" : null,
            unreadOnly ? Url.Action("Index", "Notifications") : null))' />
    }
    else
    {
        <ul class="sf-notifications-list list-grid">
        @foreach (var notification in shown)
        {
            <li class="sf-notification list-card @(notification.ReadAtUtc is null ? "sf-notification-unread" : "sf-notification-read")">
                <span class="sf-notification-marker reference-notification-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg></span>
                <div class="sf-notification-body">
                    <div class="sf-notification-heading">
                        <strong>@notification.Title</strong>
                        @if (notification.ReadAtUtc is null)
                        {
                            <partial name="_UiStatusChip" model='@(new UiStatusChip("Unread", "sf-status-chip--planned"))' />
                        }
                    </div>
                    <p>@notification.Message</p>
                    <time datetime="@notification.CreatedAtUtc.ToString("yyyy-MM-ddTHH:mm:ssZ")">@notification.CreatedAtUtc.ToString("MMM d, yyyy HH:mm") UTC</time>
                    @if (notification.FarmTaskId.HasValue)
                    {
                        <p class="ani-notification-next">Task reminder · Open your farm's Tasks page to review or complete it.</p>
                    }
                    @if (notification.ReadAtUtc is null)
                    {
                        <form asp-action="Read" asp-route-id="@notification.Id" method="post">
                            <input type="hidden" name="returnView" value="@(unreadOnly ? "unread" : "all")" />
                            <button type="submit" class="sf-notification-read-button">Mark as read</button>
                        </form>
                    }
                </div>
            </li>
        }
        </ul>
    }
</section>

</div>
