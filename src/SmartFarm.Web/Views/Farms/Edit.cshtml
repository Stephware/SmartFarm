@model SmartFarm.Web.ViewModels.Farms.FarmEditViewModel
@{
    ViewData["Title"] = T["Edit farm"];
}
<div class="reference-screen reference-screen-farms ani-entry-farm-form-shell">
<header class="sf-settings-heading">
    <a class="anigo-back-control" asp-action="Details" asp-route-id="@Model.FarmId" title="@T["Back to farm"]"><partial name="_Icon" model='@("chevLeft")' /><span class="visually-hidden">@T["Back to farm"]</span></a>

    <p class="ani-entry-eyebrow">@T["FARM SETTINGS"]</p>
    <h1>@T["Edit farm"]</h1>
    <p class="sf-muted">@T["Update your farm's details and optional map location. Existing plots, crop records and members stay connected to this farm."]</p>
</header>
<div class="sf-settings-layout">
<section class="panel card sf-edit-form-panel sf-edit-farm-panel">
    <header class="reference-panel-heading"><h2>@T["Farm details"]</h2>
        <p class="sf-muted">@T["Your farm name and nearby location are the essentials. A precise map pin can be changed separately."]</p></header>
    <form class="sf-crop-form" asp-action="Edit" asp-route-id="@Model.FarmId" method="post">
        <input asp-for="Input.RowVersion" type="hidden" />
        <label asp-for="Input.Name">@T["Farm name"]</label><input asp-for="Input.Name" required /><span asp-validation-for="Input.Name" class="error"></span>
        <label asp-for="Input.LocationText">@T["Farm location / nearby address"]</label>
        <input asp-for="Input.LocationText" data-farm-location-label required maxlength="250" />
        <span asp-validation-for="Input.LocationText" class="error"></span>
        <p class="hint">@T["A barangay, town or nearby place is enough for this label. The exact pin below is optional."]</p>
        <input asp-for="Input.Latitude" data-farm-latitude type="hidden" />
        <input asp-for="Input.Longitude" data-farm-longitude type="hidden" />
<details class="ani-farm-map-options">
    <summary><strong>@T["Exact farm location on the map"]</strong><span>@T["Optional · for local saved forecasts"]</span></summary>
    <p class="ani-inline-help">@T["Only adjust this when needed. The map may ask for location permission if you select Use my current location."]</p>
<div class="farm-location-picker sf-edit-location-picker" data-farm-location-picker data-search-url="@Url.Action("Search", "FarmLocations")" data-picker-script-url="@Url.Content("~/js/farm-location-picker.js")">
    <p class="hint">@T["Find your barangay or nearby place, then position the pin on your actual farm. No coordinates to type."]</p>
    <div class="farm-location-search">
        <label>@T["Search a place"] <input type="search" data-farm-search placeholder="@T["Barangay, town, or address"]" autocomplete="off" maxlength="120" /></label>
        <button type="button" data-farm-search-button>@T["Search"]</button>
    </div>
    <div class="farm-location-results" data-farm-results aria-live="polite"></div>
    <div class="farm-location-map" data-farm-map role="region" aria-label="@T["Select farm on OpenStreetMap"]"></div>
    <div class="farm-location-controls">
        <button type="button" data-farm-gps>@T["Use my current location"]</button>
        <button type="button" data-farm-clear>@T["Remove pin"]</button>
    </div>
    <p class="farm-location-status" data-farm-location-status role="status">@T["Tap the map or search to choose a farm position. Location services require your permission."]</p>
    <small>Map and place search: &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">@T["OpenStreetMap contributors"]</a>@T[". Address search runs only when you press Search."]</small>
</div>
</details>
        <label asp-for="Input.TimeZoneId">@T["Farm time zone"]</label>
        <input asp-for="Input.TimeZoneId" list="time-zones" required />
        <span asp-validation-for="Input.TimeZoneId" class="error"></span>
        <p class="hint">@T["Changes how task due dates, planting calendars, and reports are shown. Check it before saving."]</p>
        <div class="ani-farm-settings-actions">
            <button type="submit">@T["Save farm settings"]</button>
            <a class="sf-button-outline" asp-action="Details" asp-route-id="@Model.FarmId">@T["Cancel"]</a>
        </div>
    </form>
</section>
<aside class="sf-settings-side" aria-label="@T["Settings guidance"]">
    <div class="panel card">

        <h2>@T["Weather location"]</h2>
        <p>@T["A precise map pin helps associate saved weather forecasts with your farm. The nearby address is a separate label."]</p>
        <p class="sf-muted">@T["Forecasts depend on valid coordinates, available weather data and scheduled updates. No live weather is fetched by opening the map."]</p>
    </div>
    <div class="panel card">

        <h2>@T["Check local dates"]</h2>
        <p>@T["Your time zone affects task deadlines, planned planting dates, and harvest and finance reporting periods."]</p>
        <p class="sf-muted">@T["Changing it does not delete existing records or edit their saved timestamps."]</p>
    </div>
</aside>
</div>

<partial name="_TimeZones" />
<script src="~/js/farm-location-loader.js" asp-append-version="true" defer></script>

</div>
