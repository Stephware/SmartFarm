@using SmartFarm.Core.Enums
@model SmartFarm.Web.ViewModels.Tasks.TaskPage
@{
    ViewData["Title"] = "Farm tasks";
    var canManage = Model.Farm.Role is "Owner" or "Manager";
    var actorId = Guid.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var userId)
        ? userId : Guid.Empty;
    var openCount = Model.Tasks.Count(task => task.Status == 0);
    var todayCount = Model.FarmToday is { } localDate
        ? Model.Tasks.Count(t => t.Status == 0 && t.DueDate <= localDate) : 0;
    var upcomingCount = Model.FarmToday is { } nextDate
        ? Model.Tasks.Count(t => t.Status == 0 && t.DueDate > nextDate) : 0;
    var closedCount = Model.Tasks.Count(t => t.Status != 0);
    var shown = Model.SelectedView switch
    {
        "today" => Model.FarmToday is { } date
            ? Model.Tasks.Where(t => t.Status == 0 && t.DueDate <= date).ToList()
            : new List<SmartFarm.Core.Contracts.Tasks.FarmTaskDetails>(),
        "upcoming" => Model.FarmToday is { } date
            ? Model.Tasks.Where(t => t.Status == 0 && t.DueDate > date).ToList()
            : new List<SmartFarm.Core.Contracts.Tasks.FarmTaskDetails>(),
        "completed" => Model.Tasks.Where(t => t.Status != 0).ToList(),
        _ => Model.Tasks.ToList()
    };
    var ordered = shown.OrderBy(t => t.Status == 0 ? 0 : 1).ThenBy(t => t.DueDate).ToList();
}
<partial name="_FarmNavigation" model="Model.Farm.Id" />
<section class="panel sf-ops-hero" aria-labelledby="tasks-heading">
    <div class="sf-page-header">
        <div>
            <p><a asp-controller="Farms" asp-action="Details" asp-route-id="@Model.Farm.Id">← @Model.Farm.Name</a></p>
            <p class="sf-kicker">FIELD OPERATIONS</p>
            <h1 id="tasks-heading">Farm tasks</h1>
            <p class="sf-muted">See what needs doing, who's assigned, and when work is due.</p>
        </div>
        @if (canManage)
        {
            <a class="button" href="#add-task">Add a task</a>
        }
    </div>
    <div class="sf-ops-summary" aria-label="Task summary">
        <div><strong>@openCount</strong><span>Open tasks</span></div>
        <div><strong>@(Model.Tasks.Count - openCount)</strong><span>Closed tasks</span></div>
        <div><strong>@Model.Tasks.Count</strong><span>Total tasks</span></div>
    </div>
    <p class="hint">Scheduled planting, watering, and harvest tasks are added automatically when the worker is enabled.</p>
    <p class="sf-ops-today">Farm date: @(Model.FarmToday?.ToString("ddd, MMM d, yyyy") ?? "Unavailable — check the farm time zone") · @Model.Farm.TimeZoneId</p>
    @if (TempData["Error"] is string error) { <p class="error form-error" role="alert">@error</p> }
</section>
<section class="panel sf-task-panel" aria-labelledby="task-list-heading">
    <div class="sf-section-line">
        <h2 id="task-list-heading">Your farm work</h2>
        <span>@shown.Count visible of @Model.Tasks.Count</span>
    </div>
    <nav class="ani-task-tabs" aria-label="Filter farm tasks">
        <a class="@(Model.SelectedView == "today" ? "is-selected" : "")"
           aria-current="@(Model.SelectedView == "today" ? "page" : null)"
           asp-controller="Tasks" asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-view="today">
            Due / overdue <span>@todayCount</span>
        </a>
        <a class="@(Model.SelectedView == "upcoming" ? "is-selected" : "")"
           aria-current="@(Model.SelectedView == "upcoming" ? "page" : null)"
           asp-controller="Tasks" asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-view="upcoming">
            Upcoming <span>@upcomingCount</span>
        </a>
        <a class="@(Model.SelectedView == "completed" ? "is-selected" : "")"
           aria-current="@(Model.SelectedView == "completed" ? "page" : null)"
           asp-controller="Tasks" asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-view="completed">
            Closed <span>@closedCount</span>
        </a>
        <a class="@(Model.SelectedView == "all" ? "is-selected" : "")"
           aria-current="@(Model.SelectedView == "all" ? "page" : null)"
           asp-controller="Tasks" asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-view="all">
            All <span>@Model.Tasks.Count</span>
        </a>
    </nav>
    @if (Model.Tasks.Count == 0)
    {
        <div class="sf-empty-state">
            <strong>No tasks yet.</strong>
            <p>Farm work and reminders will appear here once tasks have been added.</p>
        </div>
    }
    else if (Model.FarmToday is null && Model.SelectedView is "today" or "upcoming")
    {
        <div class="sf-empty-state" role="status">
            <strong>Farm time zone unavailable.</strong>
            <p>Open All tasks until the farm time zone is corrected.</p>
            <a asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-view="all">View all tasks →</a>
        </div>
    }
    else if (shown.Count == 0)
    {
        <div class="sf-empty-state">
            <strong>No tasks in this view.</strong>
            <p>@(Model.SelectedView == "today" ? "Nothing is overdue or due today." :
                 Model.SelectedView == "upcoming" ? "No upcoming work is scheduled." :
                 "No tasks have been closed yet.")</p>
            <a asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-route-view="all">View all tasks →</a>
        </div>
    }
    else
    {
        <ul class="sf-task-list">
        @foreach (var task in ordered)
        {
            <li id="task-@task.Id" class="sf-task-item @(task.Status == 0 ? "sf-task-open" : "sf-task-closed")">
                <div class="sf-task-main">
                    <span class="sf-task-symbol" aria-hidden="true">@(task.Status != 0 ? "✓" : task.DueDate < Model.FarmToday ? "!" : "•")</span>
                    <div class="sf-task-content">
                        <div class="sf-task-title">
                            <h3>@task.TaskTypeName</h3>
                            <span class="sf-status-chip @(task.Status == 0 ? "sf-status-chip--active" : "sf-status-chip--neutral")">@task.StatusName</span>
                        </div>
                        <div class="sf-task-meta">
                            <span><strong>Due:</strong> <time datetime="@task.DueDate.ToString("yyyy-MM-dd")">@task.DueDate.ToString("MMM d, yyyy")</time></span>
                            @if (task.AssignedToUserId is { } assigned)
                            {
                                <span><strong>Assigned:</strong> @(Model.Members.FirstOrDefault(m => m.UserId == assigned)?.FullName ?? "Farm owner")</span>
                            }
                            else
                            {
                                <span>Unassigned · Farm owner receives reminder</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(task.Description))
                        {
                            <p class="sf-task-description">@task.Description</p>
                        }
                        @if (task.CropCycleId is { } cropId)
                        {
                            var crop = Model.Cycles.FirstOrDefault(c => c.Id == cropId);
                            if (crop is not null)
                            {
                                <a class="ani-task-crop-link" asp-controller="Monitoring" asp-action="Index"
                                   asp-route-farmId="@Model.Farm.Id" asp-route-cycleId="@crop.Id">
                                    @crop.CropTypeName · @crop.PlotName — Open fieldwork →
                                </a>
                            }
                        }
                    </div>
                </div>
                @if (task.Status == 0 && (canManage || task.AssignedToUserId == actorId))
                {
                    <div class="sf-task-actions">
                        <form asp-action="Close" asp-route-farmId="@Model.Farm.Id" asp-route-taskId="@task.Id" method="post">
                            <input type="hidden" name="RowVersion" value="@task.RowVersion" />
                            <button type="submit" name="Status" value="1">Mark completed</button>
                        </form>
                        <details class="ani-task-other">
                            <summary>Other status</summary>
                            <form asp-action="Close" asp-route-farmId="@Model.Farm.Id" asp-route-taskId="@task.Id"
                                  method="post" data-confirm="Close this task without marking it completed?">
                                <input type="hidden" name="RowVersion" value="@task.RowVersion" />
                                <label for="close-status-@task.Id">Status</label>
                                <select id="close-status-@task.Id" name="Status">
                                    <option value="2">Skipped</option>
                                    <option value="3">Cancelled</option>
                                </select>
                                <button type="submit" class="sf-button-outline">Apply status</button>
                            </form>
                        </details>
                    </div>
                }
                @if (task.Status == 0 && canManage)
                {
                    <details class="sf-edit-disclosure">
                        <summary>Edit task and assignment</summary>
                        <form asp-action="Update" asp-route-farmId="@Model.Farm.Id" asp-route-taskId="@task.Id" method="post" class="sf-ops-form">
                            <input type="hidden" name="RowVersion" value="@task.RowVersion" />
                            <label for="editDue-@task.Id">Due date</label>
                            <input type="date" id="editDue-@task.Id" name="DueDate" value="@task.DueDate.ToString("yyyy-MM-dd")" required />
                            <label for="editAssignee-@task.Id">Assigned member</label>
                            <select id="editAssignee-@task.Id" name="AssignedToUserId">
                                <option value="" selected="@(task.AssignedToUserId is null)">Unassigned (farm owner gets the reminder)</option>
                                @foreach (var member in Model.Members)
                                {
                                    <option value="@member.UserId" selected="@(task.AssignedToUserId == member.UserId)">@member.FullName — @member.Role</option>
                                }
                            </select>
                            <label for="editDescription-@task.Id">Description</label>
                            <textarea id="editDescription-@task.Id" name="Description" maxlength="500">@task.Description</textarea>
                            <button type="submit">Save task changes</button>
                        </form>
                    </details>
                }
            </li>
        }
        </ul>
    }
</section>
@if (canManage)
{
    <section class="panel sf-task-create" id="add-task" aria-labelledby="add-task-heading">
        <div class="sf-section-line">
            <div>
                <p class="sf-kicker">PLAN THE NEXT JOB</p>
                <h2 id="add-task-heading">Add a task</h2>
            </div>
        </div>
        <p class="sf-muted">Select the work, due date, and person responsible. You can leave the crop and assignee blank.</p>
        <form asp-action="Create" asp-route-farmId="@Model.Farm.Id" method="post" class="sf-ops-form sf-create-task-form">
            <div>
                <label for="taskType">Task type</label>
                <select name="TaskType" id="taskType">
                    @foreach (var option in FarmCodeLabels.TaskTypes)
                    {
                        <option value="@option.Code">@option.Name</option>
                    }
                </select>
            </div>
            <div>
                <label for="taskDue">Due date</label>
                <input type="date" id="taskDue" name="DueDate" required />
            </div>
            <div>
                <label for="taskCrop">Crop cycle (optional)</label>
                <select name="CropCycleId" id="taskCrop">
                    <option value="">No crop</option>
                    @foreach (var crop in Model.Cycles)
                    {
                        <option value="@crop.Id">@crop.PlotName — @crop.CropTypeName</option>
                    }
                </select>
            </div>
            <div>
                <label for="taskAssignee">Assign to (optional)</label>
                <select name="AssignedToUserId" id="taskAssignee">
                    <option value="">Unassigned (reminder goes to farm owner)</option>
                    @foreach (var member in Model.Members)
                    {
                        <option value="@member.UserId">@member.FullName — @member.Role</option>
                    }
                </select>
            </div>
            <div class="sf-form-wide">
                <label for="taskDescription">Description</label>
                <textarea id="taskDescription" name="Description" maxlength="500"></textarea>
            </div>
            <div class="sf-form-wide">
                <button type="submit">Create task</button>
            </div>
        </form>
    </section>
}
