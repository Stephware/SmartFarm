@model SmartFarm.Web.ViewModels.Farms.FarmEditViewModel
@{
    ViewData["Title"] = "Edit farm";
}
<div class="reference-screen reference-screen-farms ani-entry-farm-form-shell">
<header class="sf-settings-heading">
    <a asp-action="Details" asp-route-id="@Model.FarmId">← Back to farm</a>

    <p class="ani-entry-eyebrow">FARM SETTINGS</p>
    <h1>Edit farm</h1>
    <p class="sf-muted">Update your farm's details and optional map location. Existing plots, crop records and members stay connected to this farm.</p>
</header>
<div class="sf-settings-layout">
<section class="panel card sf-edit-form-panel sf-edit-farm-panel">
    <header class="reference-panel-heading"><h2>Farm details</h2>
        <p class="sf-muted">Your farm name and nearby location are the essentials. A precise map pin can be changed separately.</p></header>
    <form class="sf-crop-form" asp-action="Edit" asp-route-id="@Model.FarmId" method="post">
        <input asp-for="Input.RowVersion" type="hidden" />
        <label asp-for="Input.Name">Farm name</label><input asp-for="Input.Name" required /><span asp-validation-for="Input.Name" class="error"></span>
        <label asp-for="Input.LocationText">Farm location / nearby address</label>
        <input asp-for="Input.LocationText" data-farm-location-label required maxlength="250" />
        <span asp-validation-for="Input.LocationText" class="error"></span>
        <p class="hint">A barangay, town or nearby place is enough for this label. The exact pin below is optional.</p>
        <input asp-for="Input.Latitude" data-farm-latitude type="hidden" />
        <input asp-for="Input.Longitude" data-farm-longitude type="hidden" />
<details class="ani-farm-map-options">
    <summary><strong>Exact farm location on the map</strong><span>Optional · for local saved forecasts</span></summary>
    <p class="ani-inline-help">Only adjust this when needed. The map may ask for location permission if you select Use my current location.</p>
<div class="farm-location-picker sf-edit-location-picker" data-farm-location-picker data-search-url="@Url.Action("Search", "FarmLocations")" data-picker-script-url="@Url.Content("~/js/farm-location-picker.js")">
    <p class="hint">Find your barangay or nearby place, then position the pin on your actual farm. No coordinates to type.</p>
    <div class="farm-location-search">
        <label>Search a place <input type="search" data-farm-search placeholder="Barangay, town, or address" autocomplete="off" maxlength="120" /></label>
        <button type="button" data-farm-search-button>Search</button>
    </div>
    <div class="farm-location-results" data-farm-results aria-live="polite"></div>
    <div class="farm-location-map" data-farm-map role="region" aria-label="Select farm on OpenStreetMap"></div>
    <div class="farm-location-controls">
        <button type="button" data-farm-gps>Use my current location</button>
        <button type="button" data-farm-clear>Remove pin</button>
    </div>
    <p class="farm-location-status" data-farm-location-status role="status">Tap the map or search to choose a farm position. Location services require your permission.</p>
    <small>Map and place search: &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap contributors</a>. Address search runs only when you press Search.</small>
</div>
</details>
        <label asp-for="Input.TimeZoneId">Farm time zone</label>
        <input asp-for="Input.TimeZoneId" list="time-zones" required />
        <span asp-validation-for="Input.TimeZoneId" class="error"></span>
        <p class="hint">Changes how task due dates, planting calendars, and reports are shown. Check it before saving.</p>
        <div class="ani-farm-settings-actions">
            <button type="submit">Save farm settings</button>
            <a class="sf-button-outline" asp-action="Details" asp-route-id="@Model.FarmId">Cancel</a>
        </div>
    </form>
</section>
<aside class="sf-settings-side" aria-label="Settings guidance">
    <div class="panel card">

        <h2>Weather location</h2>
        <p>A precise map pin helps associate saved weather forecasts with your farm. The nearby address is a separate label.</p>
        <p class="sf-muted">Forecasts depend on valid coordinates, available weather data and scheduled updates. No live weather is fetched by opening the map.</p>
    </div>
    <div class="panel card">

        <h2>Check local dates</h2>
        <p>Your time zone affects task deadlines, planned planting dates, and harvest and finance reporting periods.</p>
        <p class="sf-muted">Changing it does not delete existing records or edit their saved timestamps.</p>
    </div>
</aside>
</div>

<partial name="_TimeZones" />
<script src="~/js/farm-location-loader.js" asp-append-version="true" defer></script>

</div>
