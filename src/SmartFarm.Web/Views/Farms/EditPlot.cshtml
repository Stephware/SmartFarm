@model SmartFarm.Web.ViewModels.Farms.PlotEditViewModel
@{
    ViewData["Title"] = T["Edit plot"];
}
<div class="reference-screen reference-screen-farms ani12d-edit-plot">
<section class="panel card sf-edit-form-panel ani12d-edit-form">

    <partial name="_UiPageHeader" model='@(new UiPageHeader(T["Edit plot"], T["Update the plot name or its measured area. Existing crop records remain connected."], BackText: T["Back to plots"], BackUrl: Url.Action("Details", "Farms", new { id = Model.FarmId }) + "#plots-heading"))' />
    <div asp-validation-summary="ModelOnly" class="error" role="alert"></div>
    <form class="sf-crop-form ani12d-edit-fields ani-p5-form" data-ani-p5-form asp-action="EditPlot" asp-route-id="@Model.FarmId" asp-route-plotId="@Model.PlotId" method="post">
        <input asp-for="Input.RowVersion" type="hidden" />
        <label asp-for="Input.Name">@T["Plot name"]</label><input asp-for="Input.Name" required /><span asp-validation-for="Input.Name" class="error"></span>
        <label asp-for="Input.AreaSqMeters">@T["Area (m²)"]</label><input asp-for="Input.AreaSqMeters" type="number" min="0.01" step="0.01" inputmode="decimal" required aria-describedby="ani-p5-plot-area-help" /><p class="hint" id="ani-p5-plot-area-help">@T["Enter the measured area in square meters (m²)."]</p><span asp-validation-for="Input.AreaSqMeters" class="error"></span>
        <div class="ani12d-form-actions"><button type="submit">@T["Save changes"]</button>
        <a class="sf-button-outline" asp-action="Details" asp-route-id="@Model.FarmId" asp-fragment="plots-heading">@T["Cancel"]</a></div>
    </form>
</section>


</div>
