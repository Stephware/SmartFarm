@model SmartFarm.Web.ViewModels.Auth.AdminMfaSetupPage
@{
    ViewData["Title"] = T["Admin authenticator setup"];
}
<section class="panel admin-security-setup" aria-labelledby="setup-title">
    <a class="ui-back-link anigo-back-control" asp-area="" asp-controller="Account" asp-action="Profile" title="@T["Back to my account"]"><partial name="~/Views/Shared/_Icon.cshtml" model='@("chevLeft")' /><span class="visually-hidden">@T["Back to my account"]</span></a>
    <p class="sf-kicker">@T["REQUIRED ADMIN SECURITY"]</p>
    <h1 id="setup-title">@T["Set up your authenticator"]</h1>
    <p>@T["Super Admin access requires an authenticator app. Enter this account in\n       your authenticator using the setup key below, then confirm its six-digit code."]</p>
    <div class="admin-secret" aria-label="@T["One-time authenticator enrollment key"]">
        <span>@T["Account"]</span><strong>@Model.Email</strong>
        <span>@T["Setup key"]</span><code>@Model.AuthenticatorKey</code>
    </div>
    <p class="hint">@T["Keep this key private. Do not share screenshots of this page.\n       No third-party QR code service is used."]</p>
    <form asp-area="Admin" asp-controller="Security" asp-action="Setup" method="post">
        <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
        <label for="CurrentPassword">@T["Confirm current password"]</label>
        <input type="password" id="CurrentPassword" name="CurrentPassword" autocomplete="current-password" required />
        <label for="Code">@T["Code from authenticator"]</label>
        <input id="Code" name="Code" type="text" inputmode="numeric" autocomplete="one-time-code"
               minlength="6" maxlength="12" required />
        <button type="submit">@T["Enable two-factor authentication"]</button>
    </form>
    <p class="hint">@T["After activation, save your recovery codes and sign in again."]</p>
</section>
