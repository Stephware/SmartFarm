@model SmartFarm.Web.ViewModels.Auth.RegisterInput
@{
    ViewData["Title"] = "Register";
}
<section class="panel narrow">
    <h1>Create an account</h1>
    <form method="post" asp-action="Register" asp-controller="Account">
        <label asp-for="FullName">Full name</label>
        <input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName" class="error"></span>
        <label asp-for="Email"></label>
        <input asp-for="Email" type="email" autocomplete="email" /><span asp-validation-for="Email" class="error"></span>
        <label asp-for="Password"></label>
        <input asp-for="Password" type="password" autocomplete="new-password" /><span asp-validation-for="Password" class="error"></span>
        <p class="hint">Use at least 10 characters, including uppercase, lowercase, and a number.</p>
        <button type="submit">Create account</button>
    </form>
    <p>Already registered? <a asp-controller="Account" asp-action="Login">Log in</a>.</p>
</section>

