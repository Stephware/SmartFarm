@model SmartFarm.Web.ViewModels.Finance.FarmFinancePage
@{
    ViewData["Title"] = "Farm finance";
    var canManage = Model.Farm.Role is "Owner" or "Manager";
}
<partial name="_FarmNavigation" model="Model.Farm.Id" />
<section class="panel sf-finance-hero" aria-labelledby="finance-heading">
    <div class="sf-page-header">
        <div>
            <p><a asp-controller="Farms" asp-action="Details" asp-route-id="@Model.Farm.Id">← @Model.Farm.Name</a></p>
            <p class="sf-kicker">MANUAL CASH RECORDS</p>
            <h1 id="finance-heading">Farm finances</h1>
            <p class="sf-muted">Optional manual income and expense tracking in Philippine pesos (PHP).</p>
        </div>
        @if (canManage) { <a class="button" href="#add-finance-entry">Add transaction</a> }
    </div>
    @if (TempData["Error"] is string error) { <p class="error form-error" role="alert">@error</p> }
    @if (TempData["Message"] is string message) { <p class="form-notice" role="status">@message</p> }
    <div class="sf-finance-stats" aria-label="Recorded finance totals">
        <div>
            <span>Recorded income</span>
            <strong>₱@Model.Finance.IncomePhp.ToString("N2")</strong>
        </div>
        <div>
            <span>Recorded expenses</span>
            <strong>₱@Model.Finance.ExpensesPhp.ToString("N2")</strong>
        </div>
        <div class="sf-finance-net">
            <span>Net recorded cash</span>
            <strong>₱@Model.Finance.NetPhp.ToString("N2")</strong>
        </div>
    </div>
    <p class="sf-finance-disclaimer">Harvest quantities are not assumed to be sales, and inventory transactions are not automatically counted as expenses. These totals represent recorded entries, not complete farm profit or accounting statements.</p>
</section>
@if (Model.Insights is { } insights)
{
    <section class="panel sf-finance-insights" aria-labelledby="finance-insights-heading">
        <div class="sf-section-line">
            <div>
                <p class="sf-kicker">RECORDED CASH TRENDS</p>
                <h2 id="finance-insights-heading">Financial insights</h2>
            </div>
            <span>@insights.EntryCount non-voided entries</span>
        </div>
        <p class="sf-muted">Compare manual cash entries by farm date, category, and crop cycle.
            The totals below reflect the selected period; the summary above is all-time.</p>
        <form method="get" asp-action="Index" class="report-filters sf-report-filters">
            <input type="hidden" name="farmId" value="@Model.Farm.Id" />
            <div>
                <label for="finance-from">From</label>
                <input id="finance-from" type="date" name="from"
                       value="@(insights.FromDate?.ToString("yyyy-MM-dd"))"
                       min="2000-01-01" max="2100-12-30" />
            </div>
            <div>
                <label for="finance-to">To</label>
                <input id="finance-to" type="date" name="to"
                       value="@(insights.ToDate?.ToString("yyyy-MM-dd"))"
                       min="2000-01-01" max="2100-12-30" />
            </div>
            <button type="submit">Apply dates</button>
        </form>
        <div class="action-links sf-report-actions">
            <a asp-action="Index" asp-route-farmId="@Model.Farm.Id">All dates</a>
            <a class="button" asp-action="ExportInsightsCsv" asp-route-farmId="@Model.Farm.Id"
               asp-route-from="@(insights.FromDate?.ToString("yyyy-MM-dd"))"
               asp-route-to="@(insights.ToDate?.ToString("yyyy-MM-dd"))">Export insights CSV</a>
        </div>
        <p class="hint">Period: @(insights.FromDate?.ToString("yyyy-MM-dd") ?? "First recorded entry")
            to @(insights.ToDate?.ToString("yyyy-MM-dd") ?? "Latest recorded entry").</p>
        <div class="sf-finance-stats" aria-label="Selected period cash totals">
            <div><span>Period income</span><strong>₱@insights.IncomePhp.ToString("N2")</strong></div>
            <div><span>Period expenses</span><strong>₱@insights.ExpensesPhp.ToString("N2")</strong></div>
            <div class="sf-finance-net">
                <span>Net recorded cash</span><strong>₱@insights.NetPhp.ToString("N2")</strong>
            </div>
        </div>
        <p class="hint">Net recorded cash = entered income minus entered expenses.
            Harvested crops are not assumed to be sold; farm inventory consumption does not automatically create an expense.</p>

        <h3>Monthly income and expenses (PHP)</h3>
        @{
            var recentMonths = insights.Months.OrderBy(x => x.Month).TakeLast(12).ToList();
            var cashMax = recentMonths.Count == 0 ? 0m :
                recentMonths.Max(x => Math.Max(x.IncomePhp, x.ExpensesPhp));
        }
        @if (recentMonths.Count == 0)
        {
            <p>No recorded cash entries match these dates.</p>
        }
        else
        {
            <div class="sf-finance-month-chart" role="group" aria-label="Monthly cash income and expense comparison">
                <p class="hint"><span class="sf-cash-legend sf-cash-legend--income"></span> Income
                    <span class="sf-cash-legend sf-cash-legend--expense"></span> Expenses</p>
                @foreach (var month in recentMonths)
                {
                    var incomeWidth = cashMax > 0 ? month.IncomePhp * 100m / cashMax : 0m;
                    var expenseWidth = cashMax > 0 ? month.ExpensesPhp * 100m / cashMax : 0m;
                    <div class="sf-finance-month-row">
                        <strong>@month.Month</strong>
                        <div class="sf-finance-month-bars">
                            <div class="harvest-bar-track" role="img"
                                 aria-label="@month.Month income ₱@month.IncomePhp.ToString("N2")">
                                <span class="sf-cash-bar sf-cash-bar--income"
                                      style="width:@(incomeWidth.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                            </div>
                            <div class="harvest-bar-track" role="img"
                                 aria-label="@month.Month expenses ₱@month.ExpensesPhp.ToString("N2")">
                                <span class="sf-cash-bar sf-cash-bar--expense"
                                      style="width:@(expenseWidth.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                            </div>
                        </div>
                        <div class="sf-finance-month-values">
                            <span>In ₱@month.IncomePhp.ToString("N2")</span>
                            <span>Out ₱@month.ExpensesPhp.ToString("N2")</span>
                        </div>
                    </div>
                }
            </div>
            @if (insights.Months.Count > recentMonths.Count)
            {
                <p class="hint">Showing the most recent 12 months. Export CSV for every matching month.</p>
            }
        }

        <div class="sf-finance-insight-tables">
            <div>
                <h3>Cash by category</h3>
                @if (insights.Categories.Count == 0) { <p>No category totals to display.</p> }
                else
                {
                    <div class="table-scroll" tabindex="0" role="region" aria-label="Cash by category">
                        <table class="data-table">
                            <caption class="visually-hidden">Cash category totals for selected dates</caption>
                            <thead><tr><th scope="col">Type</th><th scope="col">Category</th>
                                <th scope="col">Entries</th><th scope="col">PHP total</th></tr></thead>
                            <tbody>
                            @foreach (var category in insights.Categories.Take(20))
                            {
                                <tr><td>@category.Kind</td><td>@category.Category</td>
                                    <td>@category.EntryCount</td><td>₱@category.AmountPhp.ToString("N2")</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    @if (insights.Categories.Count > 20)
                    { <p class="hint">Showing 20 of @insights.Categories.Count categories; export CSV for all.</p> }
                }
            </div>
            <div>
                <h3>Cash by linked crop cycle</h3>
                @if (insights.CropTotals.Count == 0) { <p>No crop-linked or farm-wide cash entries yet.</p> }
                else
                {
                    <div class="table-scroll" tabindex="0" role="region" aria-label="Cash by crop cycle">
                        <table class="data-table">
                            <caption class="visually-hidden">Cash amounts by linked planting cycle</caption>
                            <thead><tr><th scope="col">Crop / allocation</th>
                                <th scope="col">Income</th><th scope="col">Expenses</th><th scope="col">Net cash</th></tr></thead>
                            <tbody>
                            @foreach (var crop in insights.CropTotals.Take(20))
                            {
                                <tr><td>@crop.Label</td>
                                    <td>₱@crop.IncomePhp.ToString("N2")</td>
                                    <td>₱@crop.ExpensesPhp.ToString("N2")</td>
                                    <td>₱@crop.NetPhp.ToString("N2")</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    @if (insights.CropTotals.Count > 20)
                    { <p class="hint">Showing 20 of @insights.CropTotals.Count allocations; export CSV for all.</p> }
                }
            </div>
        </div>
        <p class="hint">Farm-wide entries are not assigned to individual crop cycles.
            Cash comparisons are incomplete if sales or expenses were never entered.</p>
    </section>
}
@if (canManage)
{
    <section class="panel sf-finance-entry-panel" id="add-finance-entry" aria-labelledby="finance-add-heading">
        <p class="sf-kicker">RECORD MONEY IN OR OUT</p>
        <h2 id="finance-add-heading">Add income or expense</h2>
        <p class="sf-muted">Enter the amount, farm date, and category. Link a crop only when relevant.</p>
        <form asp-action="Record" asp-route-farmId="@Model.Farm.Id" method="post" class="sf-ops-form sf-finance-entry-form">
            <div>
                <label for="kind">Entry type</label>
                <select id="kind" name="Kind" required>
                    <option value="Expense">Expense</option>
                    <option value="Income">Income (recorded sales or other receipts)</option>
                </select>
            </div>
            <div>
                <label for="category">Category</label>
                <input id="category" name="Category" maxlength="60" minlength="2" placeholder="Seeds, fertilizer, crop sale..." required />
            </div>
            <div>
                <label for="amount">Amount (PHP)</label>
                <input id="amount" name="AmountPhp" type="number" min="0.01" max="999999999999.99" step="0.01" required />
            </div>
            <div>
                <label for="date">Farm date</label>
                <input id="date" name="EntryDate" type="date" value="@Model.FarmToday.ToString("yyyy-MM-dd")" min="2000-01-01" max="2100-12-30" required />
            </div>
            <div class="sf-form-wide">
                <label for="crop">Related crop (optional)</label>
                <select id="crop" name="CropCycleId">
                    <option value="">Farm-wide</option>
                    @foreach (var crop in Model.Crops)
                    {
                        <option value="@crop.Id">@crop.CropTypeName · @crop.PlotName</option>
                    }
                </select>
            </div>
            <div class="sf-form-wide">
                <label for="notes">Notes (optional)</label>
                <textarea id="notes" name="Notes" maxlength="500"></textarea>
            </div>
            <div class="sf-form-wide">
                <button type="submit">Record entry</button>
            </div>
        </form>
    </section>
}
<section class="panel sf-finance-history" aria-labelledby="finance-history-heading">
    <div class="sf-section-line">
        <div>
            <p class="sf-kicker">RECENT RECORDS</p>
            <h2 id="finance-history-heading">Finance history</h2>
        </div>
        <span>@Model.Finance.Entries.Count displayed</span>
    </div>
    @if (Model.Finance.Entries.Count == 0)
    {
        <div class="sf-empty-state">
            <strong>No recorded entries yet.</strong>
            <p>Income and expenses you enter will appear here.</p>
        </div>
    }
    else
    {
        <p class="hint">Showing the latest 500 entries. Voided entries remain visible and do not count toward totals.</p>
        <ul class="sf-finance-list">
        @foreach (var entry in Model.Finance.Entries)
        {
            <li class="sf-finance-row @(entry.IsVoided ? "sf-finance-voided" : "")">
                <div class="sf-finance-row-head">
                    <div>
                        <span class="sf-status-chip @(entry.IsVoided ? "sf-status-chip--neutral" : entry.Kind.ToString() == "Income" ? "sf-status-chip--active" : "sf-status-chip--planned")">@entry.Kind</span>
                        <strong>@entry.Category</strong>
                        <time datetime="@entry.EntryDate.ToString("yyyy-MM-dd")">@entry.EntryDate.ToString("MMM d, yyyy")</time>
                    </div>
                    <div class="sf-finance-amount">
                        <strong>₱@entry.AmountPhp.ToString("N2")</strong>
                        @if (entry.IsVoided) { <span class="sf-status-chip sf-status-chip--failed">Voided</span> }
                    </div>
                </div>
                @if (entry.Notes is not null) { <p>@entry.Notes</p> }
                @if (entry.IsVoided) { <p>Void reason: @entry.VoidReason</p> }
                @if (canManage && !entry.IsVoided)
                {
                    <details class="sf-edit-disclosure">
                        <summary>Void entry</summary>
                        <p class="sf-muted">The record will remain visible and will be excluded from totals.</p>
                        <form asp-action="Void" asp-route-farmId="@Model.Farm.Id" asp-route-entryId="@entry.Id"
                              method="post" data-confirm="Void this finance entry? It will remain in history.">
                            <label for="void-@entry.Id">Reason</label>
                            <input id="void-@entry.Id" name="Reason" minlength="3" maxlength="300" required />
                            <button type="submit" class="button-danger">Void entry</button>
                        </form>
                    </details>
                }
            </li>
        }
        </ul>
    }
</section>
