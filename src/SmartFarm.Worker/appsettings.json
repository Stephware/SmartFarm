{
  "Hangfire": {
    "Enabled": true,
    "WorkerCount": 1,
    "InitializeSchema": false,
    "RunJobsOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Hangfire": "Information"
    }
  },
  "Weather": {
    "Provider": "OpenMeteo",
    "BaseAddress": "https://api.open-meteo.com/",
    "TimeoutSeconds": 15
  }
}
