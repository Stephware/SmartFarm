@model SmartFarm.Web.ViewModels.Support.SupportDetailsPage
@{
    ViewData["Title"] = "Support request";
}
<a class="admin-back" asp-area="" asp-controller="Support" asp-action="History">← Previous requests</a>
<div class="page-heading admin-page-heading">
    <div><p class="sf-kicker">@Model.Ticket.Category.ToUpperInvariant() SUPPORT</p><h1>@Model.Ticket.Title</h1>
        <p class="sf-muted">Sent @Model.Ticket.CreatedAtUtc.ToString("MMM d, yyyy") UTC
            @(Model.Ticket.FarmName is null ? "" : $"· {Model.Ticket.FarmName}")</p></div>
    <span class="sf-status-chip @(Model.Ticket.Status is "Open" or "InProgress" ? "sf-status-chip--planned" : "sf-status-chip--active")">@Model.Ticket.Status</span>
</div>
@if (TempData["Message"] is string message) { <p class="form-notice" role="status">@message</p> }
@if (TempData["Error"] is string error) { <p class="error form-error" role="alert">@error</p> }
<section class="panel admin-directory-panel">
    <h2>Original request</h2>
    <p class="admin-support-text">@Model.Description</p>
</section>
<section class="panel admin-directory-panel" aria-labelledby="support-updates-heading">
    <h2 id="support-updates-heading">Updates &amp; replies</h2>
    @if (Model.Messages.Count == 0) { <p class="admin-empty">No saved replies.</p> }
    else {
        <div class="admin-support-thread">
            @foreach (var reply in Model.Messages) {
                <article class="admin-support-message">
                    <div class="admin-support-message-meta"><strong>@reply.AuthorName</strong><time>@reply.CreatedAtUtc.ToString("MMM d, yyyy HH:mm") UTC</time></div>
                    <p class="admin-support-text">@reply.Body</p>
                </article>
            }
        </div>
    }
</section>
<p class="hint">This history is read-only. <a asp-controller="Home" asp-action="Help">Open Help</a> for next steps.</p>
