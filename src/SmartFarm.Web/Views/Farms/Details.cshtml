@model SmartFarm.Web.ViewModels.Farms.FarmWorkspaceViewModel
@{
    ViewData["Title"] = Model.Farm.Name;
    ViewData["FarmName"] = Model.Farm.Name;
    var canManage = Model.Farm.Role == "Owner" || Model.Farm.Role == "Manager";
    var isOwner = Model.Farm.Role == "Owner";
}
<div class="reference-screen reference-screen-farms ani12d-farm-workspace">
<partial name="_FarmNavigation" model="Model.Farm.Id" />
<section class="panel card sf-farm-hero ani12d-farm-hero" aria-labelledby="farm-heading">
    <div class="sf-page-header page-hero">
        <div>
            <p><a class="ani12d-back" asp-action="Index">← All my farms</a></p>
            <p class="ani-overline">Farm workspace</p>

            <h1 id="farm-heading">@Model.Farm.Name</h1>
            <div class="sf-farm-identity ani12d-farm-identity">
                <span>@Model.Farm.LocationText</span>
                <span class="sf-status-chip sf-status-chip--planned">@Model.Farm.Role</span>
                <span class="ani12d-location-timezone">Local dates: @Model.Farm.TimeZoneId</span>
            </div>
        </div>
        <div class="sf-farm-actions">
            <a class="button" asp-controller="Dashboard" asp-action="Index" asp-route-farmId="@Model.Farm.Id">Open dashboard</a>
            @if (canManage)
            {
                <a class="sf-button-outline" asp-action="Edit" asp-route-id="@Model.Farm.Id">Edit farm</a>
            }
        </div>
    </div>
    @if (TempData["Message"] is string message) { <p class="form-notice" role="status">@message</p> }
    @if (TempData["Error"] is string error) { <p class="error form-error" role="alert">@error</p> }
    @if (canManage && Model.Plots.Count == 0)
    {
        <section class="ani-farm-next-steps" aria-labelledby="next-steps-heading">
            <p class="ani-overline">Get your farm ready</p>
            <h2 id="next-steps-heading">Your farm is created. Here's what to do next.</h2>
            <ol class="ani-journey-steps">
                <li class="ani-journey-step--current"><span aria-hidden="true">1</span><div><strong>Add your first plot</strong><p>Give the growing area a name and size.</p></div><a href="#add-plot">Add plot</a></li>
                <li><span aria-hidden="true">2</span><div><strong>Plan a crop</strong><p>Choose what you'll grow and set planting dates after adding a plot.</p></div><a asp-controller="Crops" asp-action="Index" asp-route-farmId="@Model.Farm.Id">View crops</a></li>
                <li><span aria-hidden="true">3</span><div><strong>Bring your team</strong><p>Share your farm code when you're ready for people to join.</p></div><a href="#members-heading">Farm members</a></li>
            </ol>
        </section>
    }
</section>
<nav class="ani12d-workspace-links" aria-label="Farm management sections">
    <a href="#plots-heading"><partial name="_Icon" model='@("grid")' />Plots <span>@Model.Plots.Count</span></a>
    <a asp-controller="Crops" asp-action="Index" asp-route-farmId="@Model.Farm.Id" asp-fragment="planting-plans-heading"><partial name="_Icon" model='@("sprout")' />Crop planning</a>
    <a href="#members-heading"><partial name="_Icon" model='@("users")' />Farm team <span>@(Model.Members.Count + 1)</span></a>
    @if (isOwner) { <a href="#join-requests-heading"><partial name="_Icon" model='@("checkSquare")' />Join requests</a> }
</nav>
<div class="ani12d-farm-summary" aria-label="Farm workspace overview">
    <div><strong>@Model.Plots.Count</strong><span>Growing areas</span></div>
    <div><strong>@Model.Members.Count</strong><span>Additional team members</span></div>
    <div><strong>@Model.Farm.Role</strong><span>Your farm access</span></div>
</div>
<div class="sf-farm-management-grid ani12d-management-grid">
    <section class="panel card sf-farm-plots ani12d-plots-panel" aria-labelledby="plots-heading">
        <div class="sf-section-line card-head">
            <div>
                <h2 id="plots-heading">Plots</h2>
                <p class="sf-muted">Manage your farm's growing spaces.</p>
            </div>
            <a asp-controller="PlotLayout" asp-action="Index" asp-route-farmId="@Model.Farm.Id">See plot overview →</a>
        </div>
        @if (Model.Plots.Count == 0)
        {
            <div class="sf-empty-state">
                <strong>No active plots</strong>
                <p>@(canManage ? "Add your first growing area below. Then you can create a planting plan." : "Your farm owner or manager can add plots when the farm is ready.")</p>
                @if (canManage)
                {
                    <a class="sf-button-outline" href="#add-plot">Add a plot</a>
                }
            </div>
        }
        else
        {
            <ul class="sf-plot-list">
            @foreach (var plot in Model.Plots)
            {
                <li>
                    <div class="sf-list-icon ani12d-plot-marker" aria-hidden="true"><partial name="_Icon" model='@("grid")' /></div>
                    <div class="sf-plot-list-details">
                        <strong>@plot.Name</strong>
                        <span class="sf-muted">@plot.AreaSqMeters.ToString("N2") m²</span>
                        <a asp-controller="Crops" asp-action="Index" asp-route-farmId="@Model.Farm.Id"
                           asp-route-plotId="@plot.Id" asp-fragment="planting-plans-heading">Open crop planning for this plot →</a>
                    </div>
                    @if (canManage)
                    {
                        <div class="sf-row-actions ani12d-plot-actions">
                            <a asp-action="EditPlot" asp-route-id="@Model.Farm.Id" asp-route-plotId="@plot.Id">Edit</a>
                            <form asp-action="ArchivePlot" asp-route-id="@Model.Farm.Id" asp-route-plotId="@plot.Id"
                                  method="post" class="inline" data-confirm="Archive @plot.Name? Its history will be retained.">
                                <input type="hidden" name="rowVersion" value="@plot.RowVersion" />
                                <button class="button-danger" type="submit">Archive</button>
                            </form>
                        </div>
                    }
                </li>
            }
            </ul>
        }
        @if (canManage && Model.Plots.Count > 0)
        {
            <div class="ani-plot-next-action">
                <div><strong>Ready to plant?</strong><p>Your plots are set up. Choose a crop and planting dates to continue.</p></div>
                <a class="sf-button-outline" asp-controller="Crops" asp-action="Index" asp-route-farmId="@Model.Farm.Id"
                   asp-fragment="planting-plans-heading">Plan a crop</a>
            </div>
        }
        @if (canManage)
        {
            <div class="sf-add-plot ani12d-add-plot" id="add-plot">
                <h3>Add a growing area</h3>
                <p class="sf-muted">Give each field a clear name and enter its area. You can plan its crop next.</p>
                <form asp-action="CreatePlot" asp-route-id="@Model.Farm.Id" method="post" class="sf-inline-form">
                    <div><label for="plotName">Plot name</label><input id="plotName" name="Name" required maxlength="100" minlength="2" placeholder="e.g. North field" /></div>
                    <div><label for="plotArea">Area in square meters (m²)</label><input id="plotArea" name="AreaSqMeters" type="number" min="0.01" step="0.01" required /></div>
                    <button type="submit">Add plot</button>
                </form>
            </div>
        }
    </section>
    <section class="panel card sf-farm-members ani12d-members-panel" aria-labelledby="members-heading">
        <div class="sf-section-line card-head">
            <div>
                <h2 id="members-heading">Farm team</h2>
                <p class="sf-muted">Members with access to this farm and their roles.</p>
                @if (isOwner && Model.Enrollment is not null)
                { <a class="ani-team-review-link" href="#join-requests-heading">Share code &amp; review requests →</a> }
            </div>
        </div>
        <ul class="sf-member-list">
            <li><span class="sf-member-avatar" aria-hidden="true">O</span><div><strong>Farm owner</strong><span class="sf-muted">The account that created this farm</span></div><span class="sf-status-chip sf-status-chip--active">Owner</span></li>
            @foreach (var member in Model.Members)
            {
                <li>
                    <span class="sf-member-avatar" aria-hidden="true">M</span>
                    <div class="sf-member-details"><strong>@member.FullName</strong><span class="sf-muted">@member.Role</span></div>
                    @if (isOwner)
                    {
                        <div class="sf-member-controls">
                            <form asp-action="ChangeRole" asp-route-id="@Model.Farm.Id" asp-route-memberId="@member.Id" method="post"
                                  data-confirm="Change the role for @member.FullName? Their available farm actions will change.">
                                <label class="visually-hidden" for="role-@member.Id">Role for @member.FullName</label>
                                <select id="role-@member.Id" name="Role">
                                    @if (member.Role == "Manager")
                                    {
                                        <option value="1" selected>Manager</option>
                                        <option value="2">Field Worker</option>
                                    }
                                    else
                                    {
                                        <option value="1">Manager</option>
                                        <option value="2" selected>Field Worker</option>
                                    }
                                </select>
                                <button type="submit">Update role</button>
                            </form>
                            <form asp-action="RemoveMember" asp-route-id="@Model.Farm.Id" asp-route-memberId="@member.Id"
                                  method="post" class="inline" data-confirm="Remove @member.FullName from @Model.Farm.Name? They will lose access.">
                                <button class="button-danger" type="submit">Remove</button>
                            </form>
                        </div>
                    }
                </li>
            }
        </ul>
    </section>
</div>
@if (Model.Enrollment is not null)
{
    <partial name="_FarmEnrollment" model="Model.Enrollment" />
}
@if (isOwner)
{
    <details class="ani12d-danger-options">
        <summary>Archive this farm</summary>
        <p>Archiving removes this farm from active lists and prevents further work here. Existing records are preserved.</p>
        <form asp-action="Archive" asp-route-id="@Model.Farm.Id" method="post" class="inline" data-confirm="Archive @Model.Farm.Name? Its plots and records will no longer appear in active farms.">
            <input type="hidden" name="rowVersion" value="@Model.Farm.RowVersion" />
            <button class="button-danger" type="submit">Archive farm</button>
        </form>
    </details>
}
</div>
