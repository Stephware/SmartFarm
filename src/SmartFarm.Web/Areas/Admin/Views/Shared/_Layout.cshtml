@{
    var account = User.Identity?.Name ?? "Administrator";
    var initial = account.Length == 0 ? "A" : account[..1].ToUpperInvariant();
    var section = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en" data-color-mode="light" data-theme="gold">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#153D2D" />
    <title>@ViewData["Title"] - AniGo Administration</title>
    <script src="~/js/color-mode.js" asp-append-version="true"></script>
    <link rel="preload" href="~/fonts/manrope/Manrope-Variable.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="~/css/anigo-tailwind.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body class="is-authenticated">
<a class="skip-link" href="#main-content">Skip to content</a>
<div class="app-shell admin-shell ani12f-admin-shell">
    <aside class="sidebar app-sidebar" aria-label="Platform administration">
        <a class="logo brand sidebar-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
            <span class="logo-mark"><partial name="~/Views/Shared/_Icon.cshtml" model='@("leaf")' /></span>
            <span>AniGo<small>Platform administration</small></span>
        </a>
        <div class="sidebar-workspace">
            <p class="side-group-label">Administration</p>
            <nav class="side-group sidebar-links" aria-label="Admin sections">
                <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index" aria-current="@(section == "Dashboard" ? "page" : null)">
                    <partial name="~/Views/Shared/_Icon.cshtml" model='@("grid")' /><span>Overview</span>
                </a>
                <a class="nav-link" asp-area="Admin" asp-controller="Users" asp-action="Index" aria-current="@(section == "Users" ? "page" : null)">
                    <partial name="~/Views/Shared/_Icon.cshtml" model='@("users")' /><span>Users</span>
                </a>
                <a class="nav-link" asp-area="Admin" asp-controller="Farms" asp-action="Index" aria-current="@(section == "Farms" ? "page" : null)">
                    <partial name="~/Views/Shared/_Icon.cshtml" model='@("sprout")' /><span>Farms</span>
                </a>
                <a class="nav-link" asp-area="Admin" asp-controller="Support" asp-action="Index" aria-current="@(section == "Support" ? "page" : null)">
                    <partial name="~/Views/Shared/_Icon.cshtml" model='@("bell")' /><span>Support</span>
                </a>
                <a class="nav-link" asp-area="Admin" asp-controller="Monitoring" asp-action="Index" aria-current="@(section == "Monitoring" ? "page" : null)">
                    <partial name="~/Views/Shared/_Icon.cshtml" model='@("chart")' /><span>Monitoring</span>
                </a>
                <a class="nav-link" asp-area="Admin" asp-controller="Audit" asp-action="Index"
                   aria-current="@(section == "Audit" ? "page" : null)">
                    <partial name="~/Views/Shared/_Icon.cshtml" model='@("list")' /><span>Audit history</span>
                </a>
                <a class="nav-link" asp-area="Admin" asp-controller="Announcements" asp-action="Index" aria-current="@(section == "Announcements" ? "page" : null)">
                    <partial name="~/Views/Shared/_Icon.cshtml" model='@("bell")' /><span>Announcements</span>
                </a>
                <a class="nav-link" asp-area="Admin" asp-controller="Reports" asp-action="Index" aria-current="@(section == "Reports" ? "page" : null)">
                    <partial name="~/Views/Shared/_Icon.cshtml" model='@("chart")' /><span>Reports</span>
                </a>
                <a class="nav-link" asp-area="Admin" asp-controller="Security" asp-action="Setup" aria-current="@(section == "Security" ? "page" : null)">
                    <partial name="~/Views/Shared/_Icon.cshtml" model='@("settings")' /><span>Security</span>
                </a>
            </nav>
            <p class="admin-nav-hint">Service checks and sync history are read-only.</p>
        </div>
        <div class="side-footer sidebar-bottom">
            <div class="person-row">
                <span class="avatar" aria-hidden="true">@initial</span>
                <span><strong>@account</strong><small>Super Admin</small></span>
            </div>
            <div class="sidebar-footer-actions">
                <a asp-area="" asp-controller="Farms" asp-action="Index">Farm workspace</a>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="sidebar-logout">Log out</button>
                </form>
            </div>
        </div>
    </aside>
    <div class="app-body content-shell">
        <header class="site-header app-topbar topbar">
            <div class="crumb"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin overview</a><span aria-hidden="true">/</span><strong>@(ViewData["Title"] ?? "Administration")</strong></div>
            <a class="mobile-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">AniGo Admin</a>
            <nav class="top-actions app-topbar-actions" aria-label="Administration settings">
                <button class="icon-button color-mode-toggle" type="button" data-color-mode-toggle
                        aria-label="Use dark appearance" aria-pressed="false">
                    <partial name="~/Views/Shared/_Icon.cshtml" model='@("sun")' />
                </button>
                <a class="farm-picker" asp-area="" asp-controller="Farms" asp-action="Index">Back to farms</a>
                <details class="mobile-nav admin-mobile-nav">
                    <summary aria-label="Admin navigation" aria-controls="ani12f-admin-mobile-links">
                        <partial name="~/Views/Shared/_Icon.cshtml" model='@("more")' /><span>Menu</span>
                    </summary>
                    <nav id="ani12f-admin-mobile-links" aria-label="Mobile platform administration">
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" aria-current="@(section == "Dashboard" ? "page" : null)">Admin overview</a>
                        <a asp-area="Admin" asp-controller="Users" asp-action="Index" aria-current="@(section == "Users" ? "page" : null)">Manage users</a>
                        <a asp-area="Admin" asp-controller="Farms" asp-action="Index" aria-current="@(section == "Farms" ? "page" : null)">Manage farms</a>
                        <a asp-area="Admin" asp-controller="Support" asp-action="Index" aria-current="@(section == "Support" ? "page" : null)">Support requests</a>
                        <a asp-area="Admin" asp-controller="Monitoring" asp-action="Index" aria-current="@(section == "Monitoring" ? "page" : null)">System monitoring</a>
                        <a asp-area="Admin" asp-controller="Audit" asp-action="Index" aria-current="@(section == "Audit" ? "page" : null)">Audit history</a>
                        <a asp-area="Admin" asp-controller="Announcements" asp-action="Index" aria-current="@(section == "Announcements" ? "page" : null)">Platform announcements</a>
                        <a asp-area="Admin" asp-controller="Reports" asp-action="Index" aria-current="@(section == "Reports" ? "page" : null)">Platform reports</a>
                        <a asp-area="Admin" asp-controller="Security" asp-action="Setup" aria-current="@(section == "Security" ? "page" : null)">Authenticator security</a>
                        <a asp-area="" asp-controller="Farms" asp-action="Index">Farm workspace</a>
                        <button type="button" data-color-mode-toggle aria-label="Toggle appearance">Change appearance</button>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="link-button">Log out</button>
                        </form>
                    </nav>
                </details>
            </nav>
        </header>
        <main class="page app-page app-main" id="main-content" tabindex="-1">
            @RenderBody()
        </main>
    </div>
</div>
</body>
</html>
