@{
    ViewData["Title"] = "AniGo farm management";
    ViewData["ShowLandingBackground"] = true;
}

<section class="landing-hero">
    <div class="hero-content">
        <p class="hint">From planting to harvest, season after season</p>
        <h1>Plan your season. Scout your fields. Know your yields.</h1>
        <p>Map your fields, track crop cycles, log scouting reports, and compare what worked season to season—all in one place built for working farms.</p>
        <div class="landing-cta">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="button" asp-controller="Farms" asp-action="Index">Go to my farms</a>
            <a class="link-button" asp-controller="Notifications" asp-action="Index">Review reminders</a>
        }
        else
        {
            <a class="button" asp-controller="Account" asp-action="Register">Start your season</a>
            <a class="button-secondary" asp-controller="Account" asp-action="Login">Log in</a>
        }
        </div>
        <p class="landing-trust">Free for your first season · No payment needed</p>
    </div>
    <div class="hero-visual">
        <svg width="440" height="320" viewBox="0 0 440 320" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="20" y="20" width="180" height="120" rx="4" fill="#F4E4C1" stroke="#7CAA2D" stroke-width="3"/>
            <rect x="220" y="20" width="180" height="120" rx="4" fill="#F4E4C1" stroke="#8B5A3C" stroke-width="3"/>
            <rect x="20" y="160" width="180" height="120" rx="4" fill="#F4E4C1" stroke="#7CAA2D" stroke-width="3"/>
            <rect x="220" y="160" width="180" height="120" rx="4" fill="#F4E4C1" stroke="#C9A66B" stroke-width="3"/>
            <text x="110" y="85" fill="#3D2817" font-size="14" font-weight="600" text-anchor="middle">Plot A</text>
            <text x="310" y="85" fill="#3D2817" font-size="14" font-weight="600" text-anchor="middle">Plot B</text>
            <text x="110" y="225" fill="#3D2817" font-size="14" font-weight="600" text-anchor="middle">Plot C</text>
            <text x="310" y="225" fill="#3D2817" font-size="14" font-weight="600" text-anchor="middle">Plot D</text>
            <circle cx="110" cy="105" r="4" fill="#7CAA2D"/>
            <circle cx="310" cy="105" r="4" fill="#8B5A3C"/>
            <circle cx="110" cy="245" r="4" fill="#7CAA2D"/>
            <circle cx="310" cy="245" r="4" fill="#C9A66B"/>
        </svg>
    </div>
</section>
