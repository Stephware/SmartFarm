@using SmartFarm.Web.Presentation
@using SmartFarm.Core.Enums
@model SmartFarm.Web.ViewModels.Monitoring.MonitoringWorkspaceViewModel
@{
    ViewData["Title"] = "Crop monitoring";
    var cycle = Model.Cycle;
    var monitoring = Model.Monitoring;
    var photoCount = monitoring.Observations.Sum(o => o.Photos.Count);
}
<div class="reference-screen reference-screen-monitoring">
<partial name="_FarmNavigation" model="Model.Cycle.FarmId" />
<section class="panel card sf-ops-hero ani-monitoring-hero" aria-labelledby="monitoring-heading">
    <div class="sf-page-header page-hero">
        <div>
            <p><a asp-controller="Crops" asp-action="Index"
                  asp-route-farmId="@cycle.FarmId">← Crop management</a></p>

            <h1 id="monitoring-heading">@cycle.CropTypeName — @cycle.PlotName</h1>
            <p class="sf-muted">Log watering, fertilization, pesticide use, weeding, or other activities.
                Inspections are saved as crop observations.</p>
        </div>
        <div class="ani-monitoring-art">
            <img src="@Url.Content("~/images/crops/" + CropArtwork.FileName(cycle.CropTypeName))" alt=""
                 width="120" height="120" />
            <span class="sf-status-chip @(monitoring.CanRecord ? "sf-status-chip--active" : "sf-status-chip--neutral")">@cycle.Status</span>
        </div>
    </div>
    <nav class="sf-page-jump-nav" aria-label="Monitoring sections">
        @if (monitoring.CanRecord)
        {
            <a href="#record-activity">Record activity</a>
            <a href="#record-inspection">Record inspection</a>
        }
        <a href="#activity-history">Activity history</a>
        <a href="#photo-progress-heading">Photo progress</a>
        <a href="#observation-history">Observations</a>
    </nav>
    <div class="ani-monitoring-stats" aria-label="Crop record totals">
        <div><strong>@monitoring.Activities.Count</strong><span>Field activities</span></div>
        <div><strong>@monitoring.Observations.Count</strong><span>Inspections</span></div>
        <div><strong>@photoCount</strong><span>Private photos</span></div>
    </div>
    @if (monitoring.CanRecord)
    {
        <nav class="ani-monitoring-status" aria-label="Quick recording actions">
            <a href="#record-activity">Record fieldwork</a>
            <a href="#record-inspection">New inspection</a>
            <a href="#photo-progress-heading">View photos</a>
            <a href="#observation-history">Inspection history</a>
        </nav>
    }
    @if (!monitoring.CanRecord)
    {
        <p class="sf-ops-hint">Historical records remain available. New activity and observation entries require an active crop cycle.</p>
    }
    @if (TempData["Error"] is string error)
    { <p class="error form-error" role="alert">@error</p> }
</section>
@if (monitoring.CanRecord)
{
    <div class="responsive-two reference-recording-grid">
    <section class="panel card sf-monitoring-form" id="record-activity" data-form-dialog>

        <header class="reference-panel-heading"><h2>Record activity</h2></header>
        <p class="sf-muted">Save completed work against this active crop cycle.</p>
        <form class="sf-ops-form" asp-action="Activity" asp-route-farmId="@cycle.FarmId"
              asp-route-cycleId="@cycle.Id" method="post">
            <label asp-for="Activity.ActivityType">Type</label>
            <select asp-for="Activity.ActivityType" required>
                @foreach (var option in FarmCodeLabels.Activities)
                {
                    <option value="@option.Code">@option.Name</option>
                }
            </select>
            <span asp-validation-for="Activity.ActivityType" class="error"></span>
            <label asp-for="Activity.FarmTaskId">Related task (optional)</label>
            <select asp-for="Activity.FarmTaskId">
                <option value="">Match my oldest due task automatically</option>
                @foreach (var task in Model.Tasks.Where(t => t.CropCycleId == cycle.Id &&
                    t.Status == 0 && (t.TaskType == 2 || t.TaskType == 3)))
                {
                    var taskName = task.TaskType == 2 ? "Watering" : "Fertilizing";
                    <option value="@task.Id">@taskName — @task.DueDate.ToString("yyyy-MM-dd") — @task.Description</option>
                }
            </select>
            <p class="hint">Select a matching watering or fertilizing task to complete it with this activity.</p>
            <label asp-for="Activity.Notes">Notes (optional)</label>
            <textarea asp-for="Activity.Notes" maxlength="1000" rows="3"></textarea><span asp-validation-for="Activity.Notes" class="error"></span>
            <button type="submit">Save activity</button>
        </form>
        <p class="hint">Recorded at the server's current UTC time.</p>
    </section>
    <section class="panel card sf-monitoring-form" id="record-inspection" data-form-dialog>

        <header class="reference-panel-heading"><h2>Record crop observation / inspection</h2></header>
        <p class="ani-inspection-form-intro">Record what you actually observed. Health and issue labels are field observations, not confirmed diagnoses. Add photos from an inspection record below.</p>
        <form class="sf-ops-form" asp-action="Observation" asp-route-farmId="@cycle.FarmId"
              asp-route-cycleId="@cycle.Id" method="post">
            <label asp-for="Observation.HealthStatus">Crop health</label>
            <select asp-for="Observation.HealthStatus" required>
                @foreach (var option in FarmCodeLabels.HealthStatuses)
                {
                    <option value="@option.Code">@option.Name</option>
                }
            </select>
            <span asp-validation-for="Observation.HealthStatus" class="error"></span>
            <label asp-for="Observation.IssueCategory">Observed issue (optional)</label>
            <select asp-for="Observation.IssueCategory">
                <option value="0">None / no specific issue</option>
                <option value="1">Pest</option>
                <option value="2">Disease (suspected)</option>
                <option value="3">Nutrient deficiency (suspected)</option>
                <option value="4">Environmental stress</option>
                <option value="5">Other</option>
            </select>
            <span asp-validation-for="Observation.IssueCategory" class="error"></span>
            <label asp-for="Observation.IssueSeverity">Issue severity</label>
            <select asp-for="Observation.IssueSeverity">
                <option value="0">None</option>
                <option value="1">Low</option>
                <option value="2">Moderate</option>
                <option value="3">High</option>
            </select>
            <span asp-validation-for="Observation.IssueSeverity" class="error"></span>
            <p class="hint">For a specific issue, select Needs attention or Critical health and choose an issue category and severity.</p>
            <label asp-for="Observation.GrowthStage">Growth stage (optional)</label>
            <input asp-for="Observation.GrowthStage" maxlength="40" /><span asp-validation-for="Observation.GrowthStage" class="error"></span>
            <label asp-for="Observation.Notes">Observation notes (optional)</label>
            <textarea asp-for="Observation.Notes" rows="3" maxlength="1000"></textarea><span asp-validation-for="Observation.Notes" class="error"></span>
            <button type="submit">Save observation</button>
        </form>
    </section>
    </div>
}
<section class="panel card sf-monitoring-history" id="activity-history">
    <div class="sf-section-line card-head">
        <h2>Activity history</h2>
        <span>@monitoring.Activities.Count record(s)</span>
    </div>
    @if (monitoring.Activities.Count == 0)
    { <p>No activities recorded.</p> }
    <ul class="farm-list sf-activity-list">
        @foreach (var activity in monitoring.Activities)
        {
            var label = activity.ActivityTypeName;
            <li>
                <span class="sf-list-dot" aria-hidden="true"></span>
                <div class="sf-entry-body">
                    <strong>@label</strong>
                    <time datetime="@activity.OccurredAtUtc.ToString("yyyy-MM-ddTHH:mm:ssZ")">@activity.OccurredAtUtc.ToString("MMM d, yyyy HH:mm") UTC</time>
                @if (activity.Notes is not null) { <p>@activity.Notes</p> }
                @if (activity.FarmTaskId is not null)
                {
                    <p class="hint">Linked farm task completed</p>
                }
                </div>
            </li>
        }
    </ul>
</section>
@{
    var progressPhotos = monitoring.Observations
        .SelectMany(o => o.Photos.Select(photo => new
        {
            Photo = photo,
            o.ObservedAtUtc,
            Health = o.HealthStatusName,
            o.GrowthStage
        }))
        .OrderBy(p => p.ObservedAtUtc)
        .ThenBy(p => p.Photo.UploadedAtUtc)
        .ToList();
}
<section class="panel card sf-photo-gallery" aria-labelledby="photo-progress-heading">
    <header class="reference-panel-heading"><h2 id="photo-progress-heading">Crop photo progress</h2></header>
    <p class="hint">Compare inspection photos from earliest to latest. Only authorized farm members can open these private images.</p>
    @if (progressPhotos.Count == 0)
    {
        <p>No inspection photos yet. Record an inspection and attach a photo to build a visual history.</p>
    }
    else
    {
        <div class="photo-progress-grid">
        @foreach (var entry in progressPhotos)
        {
            <figure>
                <a asp-controller="Monitoring" asp-action="Photo"
                   asp-route-farmId="@cycle.FarmId" asp-route-cycleId="@cycle.Id"
                   asp-route-photoId="@entry.Photo.Id" target="_blank" rel="noopener">
                    <img src="@Url.Action("Photo", "Monitoring", new {
                        farmId = cycle.FarmId, cycleId = cycle.Id, photoId = entry.Photo.Id })"
                         alt="Crop inspection photo taken on @entry.ObservedAtUtc.ToString("MMM d, yyyy")" loading="lazy" />
                </a>
                <figcaption>
                    <strong>@entry.ObservedAtUtc.ToString("MMM d, yyyy") UTC</strong>
                    <span>@entry.Health</span>
                    @if (!string.IsNullOrWhiteSpace(entry.GrowthStage)) { <span>@entry.GrowthStage</span> }
                </figcaption>
            </figure>
        }
        </div>
    }
</section>
<section class="panel card sf-monitoring-observations" id="observation-history">
    <div class="sf-section-line card-head">
        <h2>Observations and photos</h2>
        <span>@monitoring.Observations.Count inspection(s)</span>
    </div>
    @if (monitoring.Observations.Count == 0)
    { <p>No observations recorded.</p> }
    @foreach (var observation in monitoring.Observations)
    {
        var health = observation.HealthStatusName;
        <div class="crop-cycle sf-inspection-record">
            <div class="sf-inspection-heading">
                <span class="sf-status-chip sf-status-chip--neutral">@health</span>
                <time datetime="@observation.ObservedAtUtc.ToString("yyyy-MM-ddTHH:mm:ssZ")">@observation.ObservedAtUtc.ToString("MMM d, yyyy HH:mm") UTC</time>
            </div>
            @if (observation.IssueCategory != 0)
            {
                <p><strong>Issue:</strong> @observation.IssueCategoryName
                    · @observation.IssueSeverityName severity
                    · @(observation.FollowUpStatus == 2 ? "Resolved" : "Needs follow-up")</p>
                @if (observation.FollowUpTaskId is not null)
                {
                    <p class="hint">Linked follow-up task: @observation.FollowUpTaskId</p>
                }
                @if (Model.CanManageIssues)
                {
                    <details class="sf-edit-disclosure">
                        <summary>Manage issue follow-up</summary>
                        <form class="sf-ops-form" asp-action="FollowUp"
                              asp-route-farmId="@cycle.FarmId" asp-route-cycleId="@cycle.Id"
                              asp-route-observationId="@observation.Id" method="post">
                            <input type="hidden" name="RowVersion" value="@observation.RowVersion" />
                            <label for="follow-status-@observation.Id">Follow-up status</label>
                            <select id="follow-status-@observation.Id" name="FollowUpStatus" required>
                                <option selected="@(observation.FollowUpStatus == 1)" value="1">Needs follow-up</option>
                                <option selected="@(observation.FollowUpStatus == 2)" value="2">Resolved after checking</option>
                            </select>
                            <label for="follow-task-@observation.Id">Inspection task (optional)</label>
                            <select id="follow-task-@observation.Id" name="FollowUpTaskId">
                                <option value="">No linked task</option>
                                @foreach (var task in Model.Tasks.Where(t =>
                                    t.CropCycleId == cycle.Id && (t.TaskType == 4 || t.TaskType == 6)))
                                {
                                    <option value="@task.Id" selected="@(observation.FollowUpTaskId == task.Id)">
                                        @task.TaskTypeName · @task.DueDate.ToString("yyyy-MM-dd") · @task.Description
                                    </option>
                                }
                            </select>
                            <p class="hint">Create and assign inspection tasks in Farm tasks.
                                Completing a task does not automatically resolve a crop issue.</p>
                            <button type="submit">Save follow-up</button>
                        </form>
                    </details>
                }
            }
            @if (observation.GrowthStage is not null) { <p>Stage: @observation.GrowthStage</p> }
            @if (observation.Notes is not null) { <p>@observation.Notes</p> }
            @foreach (var photo in observation.Photos)
            {
                <a asp-controller="Monitoring" asp-action="Photo"
                   asp-route-farmId="@cycle.FarmId"
                   asp-route-cycleId="@cycle.Id"
                   asp-route-photoId="@photo.Id" target="_blank" rel="noopener">
                    <img class="observation-photo"
                         src="@Url.Action("Photo", "Monitoring", new { farmId = cycle.FarmId, cycleId = cycle.Id, photoId = photo.Id })"
                         alt="Observation photo" loading="lazy" />
                </a>
            }
            @if (monitoring.CanRecord)
            {
                <form class="sf-photo-upload sf-ops-form" asp-action="Upload" asp-route-farmId="@cycle.FarmId"
                      asp-route-cycleId="@cycle.Id" asp-route-observationId="@observation.Id"
                      method="post" enctype="multipart/form-data">
                    <div class="ani-photo-attach">
                        <label for="photo-@observation.Id">Take or select a photo</label>
                        <p class="ani-upload-hint">JPEG, PNG or WebP · 5 MB maximum · this photo is private to authorized farm members.</p>
                        <input id="photo-@observation.Id" data-field-photo type="file" name="photo"
                               accept="image/jpeg,image/png,image/webp" required />
                        <img class="ani-photo-preview" alt="Selected photo preview" hidden />
                        <p class="ani-photo-error" role="alert" hidden></p>
                    </div>
                    <button type="submit">Attach photo</button>
                </form>
            }
        </div>
    }
</section>


<script src="@Url.Content("~/js/fieldwork.js")" asp-append-version="true" defer></script>

</div>
